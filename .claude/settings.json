{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${CLAUDE_CODE_REMOTE:-}\" = true ]; then bash scripts/cloud-session-setup.sh; fi",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no -- vibelang agents hook",
            "timeout": 300,
            "statusMessage": "Checking .vibe files"
          }
        ]
      }
    ]
  }
}
