import { Submodel } from 'foldkit'

import { notFoundView } from '../../notFoundView.ts'
import { homeRouter } from '../../route.vibe'
import { Message } from './message.ts'
import { Model } from './model.ts'
import * as Home from './page/home.ts'
import * as Login from './page/login.vibe'

export const view = Submodel.defineView<Model, Message>((model, h) =>
  h.div(
    [h.Class('py-8')],
    [
      match (model.route) {
        when { _tag: "Home" }: Home.view(h);
        when { _tag: "Login" }: h.submodel({
          slotId: 'login',
          model: model.loginModel,
          view: Login.view,
          toParentMessage: message => Message.GotLoginMessage({ message }),
        });
        when { _tag: "NotFound", let path }: notFoundView(
          path,
          homeRouter(),
          'Go Home',
          h,
        );
      },
    ],
  )
)
