import { Array as Arr, pipe } from 'effect'

// MODEL

export schema ChartMode = 'Adoption' | 'Velocity' | 'Ecosystem'
export const chartModes: ReadonlyArray<ChartMode> = ChartMode.literals

export schema Period = 'LastEightWeeks' | 'LastSixteenWeeks' | 'LastYear'
export const periods: ReadonlyArray<Period> = Period.literals

export schema PackageId = 'Core' | 'Ui' | 'Devtools' | 'VitePlugin'
export const packageIds: ReadonlyArray<PackageId> = PackageId.literals

export schema PackageSpec {
  readonly id: PackageId
  readonly npmName: string
  readonly displayName: string
  readonly role: string
}

export const packageSpecs: ReadonlyArray<PackageSpec> = [
  {
    id: 'Core',
    npmName: 'foldkit',
    displayName: 'foldkit',
    role: 'runtime',
  },
  {
    id: 'Ui',
    npmName: '@foldkit/ui',
    displayName: '@foldkit/ui',
    role: 'components',
  },
  {
    id: 'Devtools',
    npmName: '@foldkit/devtools',
    displayName: '@foldkit/devtools',
    role: 'inspection',
  },
  {
    id: 'VitePlugin',
    npmName: '@foldkit/vite-plugin',
    displayName: '@foldkit/vite-plugin',
    role: 'build',
  },
]

export schema WeeklyTelemetry {
  readonly weekStart: string
  readonly cumulativeStars: number
  readonly commits: number
  readonly releases: number
}

export schema WeeklyDownloads {
  readonly weekStart: string
  readonly downloads: number
}

export schema PackageSnapshot {
  readonly id: PackageId
  readonly npmName: string
  readonly displayName: string
  readonly role: string
  readonly latestVersion: string
  readonly publishedAt: string
  readonly totalDownloads: number
  readonly lastWeekDownloads: number
  readonly dependencyCount: number
  readonly downloadsByWeek: ReadonlyArray<WeeklyDownloads>
}

export schema DependencyEdge {
  readonly source: PackageId
  readonly target: PackageId
  readonly kind: 'Dependency' | 'PeerDependency'
}

export const ContributorSummary = Schema.Struct({
  login: Schema.String,
  contributions: Schema.Number,
  avatarUrl: Schema.Option(Schema.String),
})
export type ContributorSummary = typeof ContributorSummary.Type

export schema RepositorySnapshot {
  readonly stars: number
  readonly forks: number
  readonly watchers: number
  readonly openIssues: number
  readonly openPullRequests: number
  readonly visibleContributors: number
  readonly pushedAt: string
  readonly defaultBranch: string
}

export schema Telemetry {
  readonly fetchedAt: number
  readonly repository: RepositorySnapshot
  readonly packages: ReadonlyArray<PackageSnapshot>
  readonly weeks: ReadonlyArray<WeeklyTelemetry>
  readonly dependencyEdges: ReadonlyArray<DependencyEdge>
  readonly topContributors: ReadonlyArray<ContributorSummary>
  readonly warnings: ReadonlyArray<string>
}

// CONSTANT

const LAST_EIGHT_WEEKS = 8
const LAST_SIXTEEN_WEEKS = 16
const LAST_YEAR_WEEKS = 52

// QUERY

const weekCountByPeriod: Record<Period, number> = {
  LastEightWeeks: LAST_EIGHT_WEEKS,
  LastSixteenWeeks: LAST_SIXTEEN_WEEKS,
  LastYear: LAST_YEAR_WEEKS,
}

const weekCountForPeriod = (period: Period): number => weekCountByPeriod[period]

export const periodLabels: Record<Period, string> = {
  LastEightWeeks: '8 weeks',
  LastSixteenWeeks: '16 weeks',
  LastYear: '1 year',
}

export const packageIdToSpec = (packageId: PackageId): PackageSpec =>
  pipe(
    packageSpecs,
    Arr.findFirst(({ id }) => id === packageId),
    Option.getOrElse(() => ({
      id: 'Core' as const,
      npmName: 'foldkit',
      displayName: 'foldkit',
      role: 'runtime',
    })),
  )

export const visibleWeeks = (
  telemetry: Telemetry,
  period: Period,
): ReadonlyArray<WeeklyTelemetry> =>
  Arr.takeRight(telemetry.weeks, weekCountForPeriod(period))

export const totalDownloads = (telemetry: Telemetry): number =>
  Arr.reduce(
    telemetry.packages,
    0,
    (total, snapshot) => total + snapshot.totalDownloads,
  )

export const totalCommits = (telemetry: Telemetry): number =>
  Arr.reduce(telemetry.weeks, 0, (total, week) => total + week.commits)

export const findPackageSnapshot = (
  telemetry: Telemetry,
  packageId: PackageId,
): Option<PackageSnapshot> =>
  Arr.findFirst(telemetry.packages, snapshot => snapshot.id === packageId)
