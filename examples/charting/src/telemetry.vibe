import { Array as Arr, pipe } from 'effect'

import {
  ContributorSummary,
  DependencyEdge,
  PackageSnapshot,
  RepositorySnapshot,
  Telemetry,
  WeeklyDownloads,
  WeeklyTelemetry,
  packageSpecs,
} from './domain.vibe'
import type { PackageId, PackageSpec } from './domain.vibe'
import type {
  GitHubCommitActivityResponse,
  GitHubContributorResponse,
  GitHubIssueResponse,
  GitHubPullRequestResponse,
  GitHubReleaseResponse,
  GitHubRepositoryResponse,
  GitHubStarHistoryResponse,
  GitHubStatResult,
} from './githubApi.vibe'
import { GitHubApi } from './githubApi.vibe'
import type {
  NpmDownloadsResponse,
  NpmPackument,
  NpmVersionMetadata,
} from './npmApi.vibe'
import { NpmApi } from './npmApi.vibe'
import {
  LAST_YEAR_WEEKS,
  type WeeklyCount,
  countByWeek,
  countForWeek,
  sumByWeek,
  valueForWeek,
  weekStartForDateTime,
  weekStartsForLastYear,
} from './weeks.vibe'

// CONSTANT

const TOP_CONTRIBUTOR_COUNT = 6

// MODEL

export type RawPackageData = Readonly<{
  spec: PackageSpec
  downloads: typeof NpmDownloadsResponse.Type
  packument: typeof NpmPackument.Type
}>

export type RawTelemetry = Readonly<{
  fetchedAt: number
  repository: typeof GitHubRepositoryResponse.Type
  contributors: ReadonlyArray<typeof GitHubContributorResponse.Type>
  issues: ReadonlyArray<typeof GitHubIssueResponse.Type>
  pullRequests: ReadonlyArray<typeof GitHubPullRequestResponse.Type>
  releases: ReadonlyArray<typeof GitHubReleaseResponse.Type>
  starHistory: ReadonlyArray<typeof GitHubStarHistoryResponse.Type>
  commitActivity: GitHubStatResult<
    ReadonlyArray<typeof GitHubCommitActivityResponse.Type>
  >
  packageData: ReadonlyArray<RawPackageData>
}>

// DERIVE

const weeklyDownloads = (
  downloads: typeof NpmDownloadsResponse.Type,
  weekStarts: ReadonlyArray<string>,
): ReadonlyArray<typeof WeeklyDownloads.Type> => {
  const weeklySums = sumByWeek(
    downloads.downloads,
    weekStarts,
    ({ day }) => weekStartForDateTime(DateTime.makeUnsafe(day)),
    ({ downloads: dayDownloads }) => dayDownloads,
  )

  return Arr.map(weekStarts, weekStart =>
    WeeklyDownloads.make({
      weekStart,
      downloads: valueForWeek(weeklySums, weekStart),
    }))
}

const lastWeekDownloads = (
  downloadsByWeek: ReadonlyArray<typeof WeeklyDownloads.Type>,
): number => match (Arr.last(downloadsByWeek)) {
  when Option.None: 0;
  when Option.Some(let item): item.downloads;
}

const recordSize = (
  record: Readonly<globalThis.Record<string, string>>,
): number => Arr.length(Record.keys(record))

const dependenciesOrEmpty = (
  maybeDependencies: Option<Readonly<globalThis.Record<string, string>>>,
): Readonly<globalThis.Record<string, string>> =>
  Option.getOrElse(maybeDependencies, Record.empty<string, string>)

const latestMetadata = (
  packument: typeof NpmPackument.Type,
): NpmVersionMetadata =>
  Option.getOrElse(
    Record.get(packument.versions, packument['dist-tags'].latest),
    () => ({
      dependencies: Option.none(),
      peerDependencies: Option.none(),
    }),
  )

export const dependencyEdgesForPackage = (
  packageId: PackageId,
  metadata: NpmVersionMetadata,
): ReadonlyArray<typeof DependencyEdge.Type> => {
  const dependencies = dependenciesOrEmpty(metadata.dependencies)
  const peerDependencies = dependenciesOrEmpty(metadata.peerDependencies)

  const dependencyEdges = Arr.map(
    Arr.filter(
      packageSpecs,
      spec => Arr.contains(Record.keys(dependencies), spec.npmName),
    ),
    spec =>
      DependencyEdge.make({
        source: packageId,
        target: spec.id,
        kind: 'Dependency',
      }),
  )

  const peerDependencyEdges = Arr.map(
    Arr.filter(
      packageSpecs,
      spec => Arr.contains(Record.keys(peerDependencies), spec.npmName),
    ),
    spec =>
      DependencyEdge.make({
        source: packageId,
        target: spec.id,
        kind: 'PeerDependency',
      }),
  )

  return Arr.appendAll(dependencyEdges, peerDependencyEdges)
}

export const packageSnapshotFromResponses = (
  spec: PackageSpec,
  downloads: typeof NpmDownloadsResponse.Type,
  packument: typeof NpmPackument.Type,
  weekStarts: ReadonlyArray<string>,
): Readonly<{
  snapshot: typeof PackageSnapshot.Type
  edges: ReadonlyArray<typeof DependencyEdge.Type>
}> => {
  const distTags = packument['dist-tags']
  const metadata = latestMetadata(packument)
  const dependencies = dependenciesOrEmpty(metadata.dependencies)
  const peerDependencies = dependenciesOrEmpty(metadata.peerDependencies)
  const downloadsByWeek = weeklyDownloads(downloads, weekStarts)

  const publishedAt = Option.getOrElse(
    Record.get(packument.time, distTags.latest),
    () => 'unknown',
  )
  const totalDownloads = Arr.reduce(
    downloads.downloads,
    0,
    (total, day) => total + day.downloads,
  )
  const dependencyCount = recordSize(dependencies)
    + recordSize(peerDependencies)

  return {
    snapshot: PackageSnapshot.make({
      id: spec.id,
      npmName: spec.npmName,
      displayName: spec.displayName,
      role: spec.role,
      latestVersion: distTags.latest,
      publishedAt,
      totalDownloads,
      lastWeekDownloads: lastWeekDownloads(downloadsByWeek),
      dependencyCount,
      downloadsByWeek,
    }),
    edges: dependencyEdgesForPackage(spec.id, metadata),
  }
}

export const weeklyStars = (
  starHistory: ReadonlyArray<typeof GitHubStarHistoryResponse.Type>,
  weekStarts: ReadonlyArray<string>,
): ReadonlyArray<WeeklyCount> =>
  pipe(
    sumByWeek(
      Arr.flatMap(starHistory, ({ week, days }) => {
        const sunday = pipe(
          DateTime.fromEpochSeconds(week),
          DateTime.nearest('week', { weekStartsOn: 0 }),
        )

        return Arr.map(days, (count, dayIndex) => ({
          weekStart: weekStartForDateTime(
            DateTime.add(sunday, { days: dayIndex }),
          ),
          count,
        }))
      }),
      weekStarts,
      ({ weekStart }) => weekStart,
      ({ count }) => count,
    ),
    Arr.map(({ weekStart, amount }) => ({ weekStart, count: amount })),
  )

export const cumulativeStarsByWeek = (
  currentStars: number,
  starHistory: ReadonlyArray<typeof GitHubStarHistoryResponse.Type>,
  weekStarts: ReadonlyArray<string>,
): ReadonlyArray<WeeklyCount> => {
  const emptyWeeks: ReadonlyArray<WeeklyCount> = []
  const startsWithZero = Arr.map(weekStarts, weekStart => ({
    weekStart,
    count: 0,
  }))
  const weekly = weeklyStars(starHistory, weekStarts)
  const fetchedStars = Arr.reduce(
    weekly,
    0,
    (total, week) => total + week.count,
  )
  const initialStars = Math.max(0, currentStars - fetchedStars)

  return Arr.reduce(
    startsWithZero,
    { running: initialStars, weeks: emptyWeeks },
    (state, week) => {
      const running = state.running + countForWeek(weekly, week.weekStart)
      return {
        running,
        weeks: Arr.append(state.weeks, {
          weekStart: week.weekStart,
          count: running,
        }),
      }
    },
  ).weeks
}

const commitCountForWeek = (weekStart: string) =>
(
  activity: ReadonlyArray<typeof GitHubCommitActivityResponse.Type>,
): number => match (Arr.findFirst(
    activity,
    item =>
      weekStartForDateTime(DateTime.fromEpochSeconds(item.week))
        === weekStart,
  )) {
  when Option.None: 0;
  when Option.Some(let item): item.total;
}

export const weeklyCommitTotals = (
  maybeCommitActivity: Option<
    ReadonlyArray<typeof GitHubCommitActivityResponse.Type>
  >,
  weekStarts: ReadonlyArray<string>,
): ReadonlyArray<WeeklyCount> =>
  Arr.map(weekStarts, weekStart => ({
    weekStart,
    count: do {
      const activityOption = maybeCommitActivity
      const countActivity = commitCountForWeek(weekStart)
      match (activityOption) {
        when Option.None: 0;
        when Option.Some(let activity): countActivity(activity);
      }
    },
  }))

export const weeklyReleaseTotals = (
  releases: ReadonlyArray<typeof GitHubReleaseResponse.Type>,
  weekStarts: ReadonlyArray<string>,
): ReadonlyArray<WeeklyCount> =>
  countByWeek(releases, weekStarts, release =>
    release.published_at
      .flatMap(DateTime.make)
      .map(weekStartForDateTime))

export const makeWeeklyTelemetry = (
  weekStarts: ReadonlyArray<string>,
  cumulativeStars: ReadonlyArray<WeeklyCount>,
  commits: ReadonlyArray<WeeklyCount>,
  releases: ReadonlyArray<WeeklyCount>,
): ReadonlyArray<typeof WeeklyTelemetry.Type> =>
  Arr.map(weekStarts, weekStart =>
    WeeklyTelemetry.make({
      weekStart,
      cumulativeStars: countForWeek(cumulativeStars, weekStart),
      commits: countForWeek(commits, weekStart),
      releases: countForWeek(releases, weekStart),
    }))

export const contributorSummary = (
  contributor: GitHubContributorResponse,
): typeof ContributorSummary.Type =>
  ContributorSummary.make({
    login: contributor.login,
    contributions: contributor.contributions,
    avatarUrl: contributor.avatar_url,
  })

// FETCH

export const fetchRawTelemetry: RawTelemetry!Error!(GitHubApi | NpmApi) = effect {
    const github = try GitHubApi
    const npm = try NpmApi
    const fetchedAt = try DateTime.now

    const repository = try github.fetchRepository
    const yearCutoff = DateTime.subtract(fetchedAt, { weeks: LAST_YEAR_WEEKS })
    const [contributors, issues, pullRequests, releases] = try.all [
      github.fetchContributors,
      github.fetchIssues,
      github.fetchPullRequests,
      github.fetchReleases(yearCutoff),
    ]
    const starHistory = try github.fetchStarHistory(yearCutoff)
    const commitActivity = try github.fetchCommitActivity
    const packagePrograms = Arr.map(packageSpecs, (spec) =>
      effect {
        const { downloads, packument } = try npm.fetchPackage(spec)
        return { spec, downloads, packument }
      })
    const packageData = try.all packagePrograms

    return {
      fetchedAt: DateTime.toEpochMillis(fetchedAt),
      repository,
      contributors,
      issues,
      pullRequests,
      releases,
      starHistory,
      commitActivity,
      packageData,
    }
  }

export const transformTelemetry = (
  raw: RawTelemetry,
): typeof Telemetry.Type => {
  const weekStarts = weekStartsForLastYear(DateTime.makeUnsafe(raw.fetchedAt))

  const packageResults = Arr.map(
    raw.packageData,
    ({ spec, downloads, packument }) =>
      packageSnapshotFromResponses(spec, downloads, packument, weekStarts),
  )
  const packageSnapshots = Arr.map(packageResults, ({ snapshot }) => snapshot)
  const dependencyEdges = Arr.flatMap(packageResults, ({ edges }) => edges)

  const openIssues = Arr.length(
    Arr.filter(raw.issues, issue => Option.isNone(issue.pull_request)),
  )
  const sortedContributors = Arr.sort(
    raw.contributors,
    (left: GitHubContributorResponse, right: GitHubContributorResponse) =>
      left === right
        ? 0
        : Order.Number(right.contributions, left.contributions),
  )
  const cumulativeStars = cumulativeStarsByWeek(
    raw.repository.stargazers_count,
    raw.starHistory,
    weekStarts,
  )
  const warnings = raw.commitActivity.warnings

  return Telemetry.make({
    fetchedAt: raw.fetchedAt,
    repository: RepositorySnapshot.make({
      stars: raw.repository.stargazers_count,
      forks: raw.repository.forks_count,
      watchers: raw.repository.watchers_count,
      openIssues,
      openPullRequests: Arr.length(raw.pullRequests),
      visibleContributors: Arr.length(raw.contributors),
      pushedAt: raw.repository.pushed_at,
      defaultBranch: raw.repository.default_branch,
    }),
    packages: packageSnapshots,
    weeks: makeWeeklyTelemetry(
      weekStarts,
      cumulativeStars,
      weeklyCommitTotals(raw.commitActivity.data, weekStarts),
      weeklyReleaseTotals(raw.releases, weekStarts),
    ),
    dependencyEdges,
    topContributors: pipe(
      sortedContributors,
      Arr.take(TOP_CONTRIBUTOR_COUNT),
      Arr.map(contributorSummary),
    ),
    warnings,
  })
}
