import { Array as Arr, Effect, Schema } from 'effect'
import { Calendar, Command, Update } from 'foldkit'
import { type CalendarDate } from 'foldkit/calendar'
import { defineMessageUnion } from 'foldkit/message'
import { modifyFields } from 'foldkit/struct'

import { BrowserCrypto } from '@effect/platform-browser'

import * as Entry from './entry/index.ts'

// MODEL

export schema Model {
  readonly entries: ReadonlyArray<Entry.Model>
  readonly today: Calendar.CalendarDate
}

// MESSAGE

export const Message = defineMessageUnion({
  ClickedAddEntry: {},
  SucceededGenerateEntryId: { entryId: Schema.String },
  FailedGenerateEntryId: {},
  RemovedEntry: { entryId: Schema.String },
  GotEntryMessage: {
    entryId: Schema.String,
    message: Entry.Message,
  },
})

export type Message = typeof Message.Type

// INIT

export const init = (today: CalendarDate, initialEntryId: string): Model => ({
  entries: [Entry.init(initialEntryId)],
  today,
})

// COMMAND

export const GenerateEntryId = Command.define('GenerateEntryId', {
  messages: [Message.SucceededGenerateEntryId, Message.FailedGenerateEntryId],
  execute: Effect.catchDefect(
    effect {
      provide BrowserCrypto.layerSecureRandom {
        const secureRandom = try SecureRandom.SecureRandom
        const entryId = try secureRandom.uuidV4()
        return Message.SucceededGenerateEntryId({ entryId })
      }
    },
    (): ReturnType<typeof Message.FailedGenerateEntryId>!! => {
      const message = Message.FailedGenerateEntryId()
      return effect {
        return message
      }
    },
  ),
})

// UPDATE

const foldEntryOutMessage = (entryId: string): infer _ =>
  Entry.OutMessage.match<Update.Step<Model, Message>>({
    Removed: () => model => ({
      model: modifyFields(model, {
        entries: Arr.filter(entry => entry.id !== entryId),
      }),
    }),
  })

const foldEntry = Update.foldChildAt({
  update: Entry.update,
  readAt: (model: Model, entryId: string) =>
    Arr.findFirst(model.entries, entry => entry.id === entryId),
  writeAt: (model, entryId, nextEntry) =>
    modifyFields(model, {
      entries: Arr.map(entry => (entry.id === entryId ? nextEntry : entry)),
    }),
  toParentMessage: (entryId, message) =>
    Message.GotEntryMessage({ entryId, message }),
  foldOutMessage: foldEntryOutMessage,
})

export const update = (model: Model, message: Message): infer _ =>
  Message.match<Update.Return<Model, Message>>(message, {
    ClickedAddEntry: () => ({ model, commands: [GenerateEntryId()] }),

    SucceededGenerateEntryId: ({ entryId }) => ({
      model: modifyFields(model, {
        entries: Arr.append(Entry.init(entryId)),
      }),
    }),

    FailedGenerateEntryId: () => ({ model }),

    RemovedEntry: ({ entryId }) => ({
      model: modifyFields(model, {
        entries: Arr.filter(entry => entry.id !== entryId),
      }),
    }),

    GotEntryMessage: ({ entryId, message }) =>
      foldEntry(model, entryId, message),
  })

// VALIDATION SUMMARY

export const hasErrors = (model: Model): boolean =>
  Arr.some(model.entries, Entry.hasErrors)

export const isComplete = (model: Model): boolean =>
  Arr.isReadonlyArrayNonEmpty(model.entries)
  && Arr.every(model.entries, Entry.isComplete)

export const revealErrors = (model: Model): Model =>
  modifyFields(model, { entries: Arr.map(Entry.revealErrors) })
