import { Array as Arr, pipe } from 'effect'
import { type Document, HtmlBuilder } from 'foldkit/html'

import { DragAndDrop } from '@foldkit/ui'

import { Message } from '../message.vibe'
import type { Model } from '../model.vibe'
import { ghostCardView } from './card.vibe'
import { columnView } from './column.vibe'

const findDraggedCard = (model: Model): infer _ =>
  pipe(
    model.dragAndDrop,
    DragAndDrop.maybeDraggedItemId,
    Option.flatMap(cardId =>
      pipe(
        model.columns,
        Arr.flatMap(({ cards }) => cards),
        Arr.findFirst(({ id }) => id === cardId),
      )
    ),
  )

const ghostElement = (model: Model, h: HtmlBuilder<Message>): infer _ =>
  match (DragAndDrop.ghostStyle(model.dragAndDrop)
      .flatMap(ghostStyle =>
        Option.map(findDraggedCard(model), card => ({ ghostStyle, card }))
      )) {
    when Option.None: h.empty;
    when Option.Some(let ghost): do {
      const { ghostStyle, card } = ghost
      h.div(
        [h.Style(ghostStyle), h.Class('w-64'), h.AriaHidden(true)],
        [ghostCardView(card, h)],
      )
    };
  }

export const view = (model: Model, h: HtmlBuilder<Message>): Document => ({
  title: 'Kanban Board',
  body: h.div(
    [h.Class('flex flex-col min-h-screen bg-gray-100')],
    [
      h.div(
        [h.Class('px-6 py-4 bg-white border-b border-gray-200')],
        [
          h.h1(
            [h.Class('text-lg font-semibold text-gray-900')],
            ['Kanban Board'],
          ),
        ],
      ),
      h.div(
        [
          h.Class(
            'flex-1 p-6 grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-6 items-start',
          ),
        ],
        Arr.map(
          model.columns,
          column => columnView(model, column, message => message, h),
        ),
      ),
      ghostElement(model, h),
      h.div(
        [h.Class('sr-only'), h.AriaLive('assertive')],
        [model.announcement],
      ),
    ],
  ),
})
