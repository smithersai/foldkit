{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "vite.config.playground.ts",
    "vitest.config.ts",
    "src/**/*.vibe",
    "vite.config.vibe",
    "vite.config.playground.vibe",
    "vitest.config.vibe"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../packages/foldkit/src"
  ],
  "vibelang": {
    "declarationSidecars": true,
    "trustedPackages": [
      "foldkit",
      "foldkit/*"
    ]
  }
}
