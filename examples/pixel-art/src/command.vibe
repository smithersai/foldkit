import { Command } from 'foldkit'

import { BrowserKeyValueStore } from '@effect/platform-browser'

import { CANVAS_SIZE_PX, EXPORT_SCALE, STORAGE_KEY } from './constant.ts'
import { Message } from './message.vibe'
import type { Model, SavedCanvas } from './model.vibe'
import { Grid, PaletteIndex } from './model.vibe'
import { SavedCanvasJsonString } from './model.vibe'
import { PALETTE_THEMES, resolveColor } from './palette.vibe'
import { createCanvas, downloadCanvas, drawCell } from './canvasPlatform.ts'

export const SaveCanvas = Command.define('SaveCanvas', {
  args: {
    grid: Grid,
    gridSize: Schema.Number,
    paletteThemeIndex: Schema.Number,
    selectedColorIndex: PaletteIndex,
  },
  messages: [Message.CompletedSaveCanvas],
  execute: (
    { grid, gridSize, paletteThemeIndex, selectedColorIndex },
  ): ReturnType<typeof Message.CompletedSaveCanvas>!! =>
    effect {
      provide BrowserKeyValueStore.layerLocalStorage {
        return (effect {
          const store = try KeyValueStore.KeyValueStore
          const data: SavedCanvas = {
            grid,
            gridSize,
            paletteThemeIndex,
            selectedColorIndex,
          }
          const encodedCanvas = try Schema.encodeEffect(SavedCanvasJsonString)(
            data,
          )
          try store.set(STORAGE_KEY, encodedCanvas)
          return Message.CompletedSaveCanvas()
        }) catch () => Message.CompletedSaveCanvas()
      }
    },
})

export const saveCanvas = (model: Model): infer _ =>
  SaveCanvas({
    grid: model.grid,
    gridSize: model.gridSize,
    paletteThemeIndex: model.paletteThemeIndex,
    selectedColorIndex: model.selectedColorIndex,
  })

export const ExportPng = Command.define('ExportPng', {
  args: {
    grid: Grid,
    gridSize: Schema.Number,
    paletteThemeIndex: Schema.Number,
  },
  messages: [Message.SucceededExportPng, Message.FailedExportPng],
  execute: (
    { grid, gridSize, paletteThemeIndex },
  ): (ReturnType<typeof Message.SucceededExportPng> | ReturnType<typeof Message.FailedExportPng>)!! =>
    effect {
      const theme = PALETTE_THEMES[paletteThemeIndex] ?? PALETTE_THEMES[0]
      const scale = Math.max(1, Math.floor(CANVAS_SIZE_PX / gridSize))
        * EXPORT_SCALE
      // These helpers contain only raw browser operations, executed as plain TypeScript.
      const { canvas, context } = try sync(createCanvas, gridSize, scale)
      if (context === null) {
        return Message.FailedExportPng({
          error: 'Canvas 2D context not available',
        })
      }
      for (const [y, row] of grid.entries()) {
        for (const [x, cell] of row.entries()) {
          try sync(drawCell, context, resolveColor(cell, theme), x, y, scale)
        }
      }
      try sync(downloadCanvas, canvas)
      return Message.SucceededExportPng()
    },
})
