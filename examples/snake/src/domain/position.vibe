import { GAME } from '../constants.ts'
import * as Direction from './direction.vibe'

export schema Position {
  readonly x: number
  readonly y: number
}

export const equivalence = Schema.toEquivalence(Position)

export const wrap = ({ x, y }: Position): Position => ({
  x: x < 0 ? GAME.GRID_SIZE - 1 : x >= GAME.GRID_SIZE ? 0 : x,
  y: y < 0 ? GAME.GRID_SIZE - 1 : y >= GAME.GRID_SIZE ? 0 : y,
})

export const move = (
  pos: Position,
  direction: Direction.Direction,
): Position => {
  const next: Position = match (direction) {
    when "Up": ({ x: pos.x, y: pos.y - 1 });
    when "Down": ({ x: pos.x, y: pos.y + 1 });
    when "Left": ({ x: pos.x - 1, y: pos.y });
    when "Right": ({ x: pos.x + 1, y: pos.y });
  }
  return wrap(next)
}
