{
  "name": "@foldkit/lustre-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm build:naive && pnpm build:optimised",
    "build:naive": "vite build",
    "build:optimised": "BUILD_VARIANT=optimised vite build && mv dist/optimised/index.optimised.html dist/optimised/index.html",
    "bench:install": "node bench/install.mjs",
    "bench:run": "node bench/run.mjs",
    "bench:verify": "node bench/verify.mjs",
    "dev": "vite",
    "profile": "RUN_LUSTRE_PROFILE=1 vitest run",
    "typecheck": "vibelang --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "effect": "4.1.0",
    "foldkit": "workspace:*",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-22e46b61b67d.tgz"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "workspace:*",
    "@types/node": "26.4.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-77d824d4b61a.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-6f2666fdf1ab.tgz"
  }
}
