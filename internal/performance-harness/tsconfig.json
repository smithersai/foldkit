{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "src/**/*.vibe",
    "vite.config.vibe"
  ],
  "exclude": ["node_modules", "dist", "../../packages/foldkit/src"],
  "vibelang": {
    "declarationSidecars": true
  }
}
