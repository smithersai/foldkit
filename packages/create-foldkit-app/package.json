{
  "name": "create-foldkit-app",
  "version": "0.40.0",
  "description": "Create Foldkit applications",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-foldkit-app": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && vibelang -b tsconfig.build.json && node scripts/build-templates.mjs",
    "format": "(oxfmt) && vibelang-format --write",
    "test": "vitest run",
    "typecheck": "vibelang -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/platform-node-shared": "4.1.1",
    "chalk": "^6.0.0",
    "effect": "4.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-4a7e790005b5.tgz"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@types/node": "26.4.0",
    "vitest": "^5.0.2",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-6a4c55d7d3ae.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-a43d2b04075f.tgz",
    "fast-check": "^4.10.2"
  },
  "keywords": [
    "create-foldkit-app",
    "foldkit",
    "scaffolding",
    "effect",
    "cli",
    "template"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/create-foldkit-app"
  },
  "homepage": "https://foldkit.dev/get-started",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
