#!/usr/bin/env node
import packageJson from '../package.json' with { type: 'json' }

import { NodeRuntime, NodeServices } from '@effect/platform-node'

import { create as create_ } from './commands/create.vibe'
import { EXAMPLE_VALUES } from './examples.ts'
import { RENDERING_VALUES } from './rendering.vibe'
import { validateProjectName } from './validateName.vibe'

/* eslint-disable-next-line @typescript-eslint/consistent-type-assertions */
const nameSchema = Schema.String.pipe(
  Schema.check(
    Schema.makeFilter<string>((value): infer _ =>
      Option.match(validateProjectName(value), {
        onNone: (): infer _ => true,
        onSome: (message): infer _ => message,
      })
    ),
  ),
)

const name = Flag.String('name').pipe(
  Flag.withAlias('n'),
  Flag.withDescription('The name of the project to create'),
  Flag.withSchema(nameSchema),
  Flag.optional,
)

const rendering = Flag.Literals('rendering', RENDERING_VALUES).pipe(
  Flag.withAlias('r'),
  Flag.withDescription(
    'How the application renders: spa renders entirely in the browser, ssg prerenders routes to static HTML at build time, ssr renders each request then hydrates',
  ),
  Flag.optional,
)

const example = Flag.Literals('example', EXAMPLE_VALUES).pipe(
  Flag.withAlias('e'),
  Flag.withDescription(
    "The example application to start from with spa rendering. Run with no flags for an interactive picker that shows each example's description.",
  ),
  Flag.optional,
)

const packageManager = Flag.Literals('package-manager', [
  'pnpm',
  'npm',
  'yarn',
  'bun',
]).pipe(
  Flag.withAlias('p'),
  Flag.withDescription(
    'The package manager to use for installing dependencies',
  ),
  Flag.optional,
)

const main = effect {
  const environment = Config.option(
    Config.String('CREATE_FOLDKIT_APP_DEPENDENCY_MANIFESTS_DIRECTORY'),
  )
  const maybeDependencyManifestsDirectory = try environment
  const create = Command.make(
    'create',
    { name, rendering, example, packageManager },
    effect (input) =>
      try create_({ ...input, maybeDependencyManifestsDirectory }),
  ).pipe(Command.withDescription('Create a new Foldkit application'))
  return try Command.run(create, { version: packageJson.version })
}

NodeRuntime.runMain(effect {
  provide NodeServices.layer {
    return try main
  }
})
