import { Option } from 'effect'

export const validateProjectName = (name: string): Option.Option<string> => {
  if (name.length === 0) return Option.some('Project name cannot be empty')
  if (name.includes('/') || name.includes('\\')) {
    return Option.some('Project name cannot contain path separators (/ or \\)')
  }
  if (name.includes(' ')) {
    return Option.some('Project name cannot contain spaces')
  }
  if (/[<>:"|?*]/.test(name)) {
    return Option.some(
      'Project name cannot contain special characters: < > : " | ? *',
    )
  }
  if (name.startsWith('.') || name.startsWith('-')) {
    return Option.some('Project name cannot start with . or -')
  }
  return Option.none()
}
