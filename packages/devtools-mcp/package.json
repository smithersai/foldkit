{
  "name": "@foldkit/devtools-mcp",
  "version": "0.25.0",
  "description": "MCP server exposing Foldkit DevTools to AI agents (Claude Code, Cursor, etc.)",
  "type": "module",
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "foldkit-devtools-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && vibelang -b && pnpm run bundle",
    "bundle": "rolldown -c rolldown.config.ts",
    "watch": "vibelang -b --watch",
    "typecheck": "vibelang -b --noEmit && vibelang -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.1.0",
    "foldkit": ">=0.165.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.21.3",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-29428c7e2cb3.tgz"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "@foldkit/vite-plugin": "workspace:*",
    "@types/node": "26.4.0",
    "@types/ws": "^8.18.1",
    "effect": "4.1.0",
    "foldkit": "workspace:*",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.11",
    "typescript": "^7.0.2",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-3fd0fe8dc126.tgz",
    "vibelang-unplugin": "file:../../.vibelang-toolchain/vibelang-unplugin-0.0.11-4bdd892db92b.tgz",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-94168276647a.tgz"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "foldkit",
    "mcp",
    "model-context-protocol",
    "devtools",
    "ai"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/devtools-mcp"
  },
  "homepage": "https://foldkit.dev/ai/mcp",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
