import { Config, Option } from 'effect'
import type { ChildProcessSpawner } from 'effect/process'
import * as NodePath from '@effect/platform-node/NodePath'
import { NetAddress } from 'effect/net'

import { isScopedIPv6 } from './relayLocation.platform.ts'

import {
  type RelayRegistryReader,
  type RelayRegistryServices,
  discoverRelays,
} from './relayRegistry.ts'

const LEGACY_DEFAULT_PORT = 9988
const DEFAULT_HOST = 'localhost'
const AUTOMATIC_RELAY_HOST = '127.0.0.1'
const AUTOMATIC_RELAY_PATH = '/__foldkit/devtools-mcp'
const RELAY_TOKEN_PARAMETER = 'token'
const RELAY_TOKEN_PATTERN = /^[0-9a-f]{64}$/

export type Settings = Readonly<{
  maybeConfiguredPort: Option.Option<string>
  maybeConfiguredHost: Option.Option<string>
  projectRoot: string
}>

export type RelayTarget = Readonly<{
  key: string
  url: string
  maybeProjectRoot: Option.Option<string>
}>

export const loadSettings: Settings!! = effect {
  provide NodePath.layer {
    return try Effect.orDie(effect {
      const maybeConfiguredPort = try Config.option(
        Config.String('FOLDKIT_DEVTOOLS_MCP_PORT'),
      )
      const maybeConfiguredHost = try Config.option(
        Config.String('FOLDKIT_DEVTOOLS_MCP_HOST'),
      )
      const maybeProjectRoot = try Config.option(
        Config.String('FOLDKIT_PROJECT_ROOT'),
      )
      return {
        maybeConfiguredPort,
        maybeConfiguredHost,
        projectRoot: match (maybeProjectRoot) {
          when Option.Some(let projectRoot): projectRoot;
          when Option.None: (try Path.Path).resolve();
        },
      }
    })
  }
}

// NetAddress parses bare addresses; Node's scoped-literal predicate is retained
// only for zone-bearing inputs (foldkit-58).
const urlHost = (host: string): string => {
  const isIPv6Address = host.includes('%')
    ? isScopedIPv6(host)
    : Result.isSuccess(NetAddress.ipv6FromString(host))
  return isIPv6Address ? '[' + host + ']' : host
}

const relayUrl = (host: string, port: number | string): string =>
  `ws://${urlHost(host)}:${port}`

const fixedTarget = (url: string): RelayTarget => ({
  key: url,
  url,
  maybeProjectRoot: Option.none(),
})

const parseUrl = Option.liftThrowable((url: string) => new URL(url))

const hasValidPort = (url: URL): boolean => {
  const port = globalThis.Number(url.port)

  return (
    url.port !== ''
    && globalThis.Number.isInteger(port)
    && port > 0
    && port <= 65_535
  )
}

const isPublishedRelayUrl = (value: string): boolean =>
  Option.exists(parseUrl(value), url => {
    if (
      url.protocol !== 'ws:'
      || url.username !== ''
      || url.password !== ''
      || url.hash !== ''
      || !hasValidPort(url)
    ) {
      return false
    }

    const parameters = Effect.Array.fromIterable(url.searchParams)
    return (
      url.hostname === AUTOMATIC_RELAY_HOST
      && url.pathname === AUTOMATIC_RELAY_PATH
      && Effect.Array.length(parameters) === 1
      && Option.exists(
        Effect.Array.head(parameters),
        ([name, token]) =>
          name === RELAY_TOKEN_PARAMETER && RELAY_TOKEN_PATTERN.test(token),
      )
    )
  })

export const configuredRelayUrl = (
  settings: Settings,
): Option.Option<string> => {
  const { maybeConfiguredHost, maybeConfiguredPort } = settings

  if (
    Option.isSome(maybeConfiguredHost)
    || Option.isSome(maybeConfiguredPort)
  ) {
    const host = Option.getOrElse(maybeConfiguredHost, () => DEFAULT_HOST)
    const port = Option.getOrElse(
      maybeConfiguredPort,
      () => LEGACY_DEFAULT_PORT,
    )

    return Option.some(relayUrl(host, port))
  } else {
    return Option.none()
  }
}

export const resolveRelayTargets = (
  settings: Settings,
  registryReader: RelayRegistryReader,
): ReadonlyArray<RelayTarget>!never!(RelayRegistryServices | ChildProcessSpawner.ChildProcessSpawner) =>
  match (configuredRelayUrl(settings)) {
    when Option.Some(let url): do {
      // The TypeScript factory constructs this one array before any run.
      const targets = [fixedTarget(url)]
      effect {
        return targets
      }
    };
    when Option.None: do {
      // Calling the imported factory is eager; running its program is cold.
      const discovered = discoverRelays(settings.projectRoot, registryReader)
      effect {
        const records = try discovered
        const trustedRecords = Effect.Array.filter(
          records,
          record => isPublishedRelayUrl(record.url),
        )
        return Effect.Array.map(trustedRecords, (record): RelayTarget => ({
          key: record.id,
          url: record.url,
          maybeProjectRoot: Option.some(record.root),
        }))
      }
    };
  }
