import { pipe } from 'effect'
import type { ChildProcessSpawner } from 'effect/process'
import {
  RELAY_REGISTRY_DIRECTORY_NAME,
  RELAY_REGISTRY_DIRECTORY_VARIABLE,
  RelayRecord,
} from 'foldkit/devtools-protocol'
import { ExperimentalNodeProcess } from 'vibelang-runtime/experimental/platform-node'
import {
  homedir,
  isLegacyProcessAlive,
  tmpdir,
} from './relayRegistry.platform.ts'

import {
  type RelayRegistryTrust,
  relayRegistryTrust,
} from './relayRegistryTrust.ts'

const RUNTIME_DIRECTORY_VARIABLE = 'XDG_RUNTIME_DIR'
const RECORD_FILE_EXTENSION = '.json'
const RETIRING_RECORD_SUFFIX = '.retiring'

export type RelayRegistryServices = FileSystem.FileSystem | Path

export type RelayRegistryReader = Readonly<{
  trust: RelayRegistryTrust
  reportedRefusals: Ref<HashSet<string>>
}>

type RootPathApi = Pick<Path, 'isAbsolute' | 'relative' | 'sep'>

const decodeRelayRecord = Schema.decodeUnknownOption(
  Schema.fromJsonString(RelayRecord),
)

const relayRegistryDirectory: string!!Path = effect {
  const path = try Path.Path
  const maybeConfigured = try Config.option(
    Config.String(RELAY_REGISTRY_DIRECTORY_VARIABLE),
  )
  const maybeRuntimeDirectory = try Config.option(
    Config.String(RUNTIME_DIRECTORY_VARIABLE),
  )
  return match (maybeConfigured) {
    when Option.Some(let configured): configured;
    when Option.None: do {
      const platformQuery = effect {
        provide ExperimentalNodeProcess.layer {
          const host = try Experimental.Process.Process
          return try host.platform
        }
      }
      const platform = try platformQuery
      const defaultParent = platform === 'win32'
        ? try sync(tmpdir)
        : path.join(try sync(homedir), '.cache')
      path.join(
        Option.getOrElse(maybeRuntimeDirectory, () => defaultParent),
        RELAY_REGISTRY_DIRECTORY_NAME,
      )
    };
  }
} |> Effect.orDie(%)

const isProcessAlive = effect (pid: number): boolean!! => {
  // Node's zero-pid query addresses the current group; the positive-id
  // experimental service cannot represent it yet (foldkit-152).
  if (pid === 0) {
    return try sync((value: number) => isLegacyProcessAlive(value), pid)
  }
  provide ExperimentalNodeProcess.layer {
    const host = try Experimental.Process.Process
    return host.isRunning(Math.abs(pid), pid < 0 ? { group: true } : undefined)
      catch () => false
  }
}

const readRecordFile = (
  filePath: string,
): Option<RelayRecord>!!FileSystem.FileSystem =>
  (effect {
    const fileSystem = try FileSystem.FileSystem
    const raw = try fileSystem.readFileString(filePath)
    return decodeRelayRecord(raw)
  }) |> Effect.orElseSucceed(%, () => Option.none<RelayRecord>())

const retireStaleRecord = effect (
  filePath: string,
  record: RelayRecord,
): void!!FileSystem.FileSystem => {
  const fileSystem = try FileSystem.FileSystem
  const retiringPath = `${filePath}.${
    encodeURIComponent(record.id)
  }${RETIRING_RECORD_SUFFIX}`
  const wasRecordMoved = (fileSystem
    .rename(filePath, retiringPath)
    |> Effect.as(%, true)) catch () => false

  if (!wasRecordMoved) {
    return
  }

  const maybeRetiringRecord = try readRecordFile(retiringPath)
  const isOriginalRecord = Option.exists(
    maybeRetiringRecord,
    retiringRecord => retiringRecord.id === record.id,
  )

  if (!isOriginalRecord) {
    try (fileSystem.link(retiringPath, filePath) |> Effect.ignore(%))
  }

  try (fileSystem.remove(retiringPath, { force: true }) |> Effect.ignore(%))
}

const readLiveRecordFile = effect (
  filePath: string,
): Option<RelayRecord>!!FileSystem.FileSystem => {
  const maybeRecord = try readRecordFile(filePath)

  if (
    Option.isSome(maybeRecord) && !(try isProcessAlive(maybeRecord.value.pid))
  ) {
    try retireStaleRecord(filePath, maybeRecord.value)

    return Option.none<RelayRecord>()
  }

  return maybeRecord
}

const newestFirst: Order<RelayRecord> = Order.mapInput(
  Order.flip(Order.Number),
  record => record.startedAt,
)

export const isWithinRoot = (
  root: string,
  candidate: string,
  pathApi: RootPathApi,
): boolean => {
  const relativePath = pathApi.relative(root, candidate)

  return (
    relativePath === ''
    || (relativePath !== '..'
      && !relativePath.startsWith(`..${pathApi.sep}`)
      && !pathApi.isAbsolute(relativePath))
  )
}

export const makeRelayRegistryReader: RelayRegistryReader!! = effect {
  const reportedRefusals = try Ref.make(HashSet.empty<string>())
  const registryReader: RelayRegistryReader = {
    trust: relayRegistryTrust,
    reportedRefusals,
  }

  return registryReader
}

const reportRefusal = effect (
  reportedRefusals: Ref<HashSet<string>>,
  directory: string,
  reason: string,
): void!! => {
  const line =
    `[foldkit-devtools-mcp] ignoring the relay registry at ${directory}: it ${reason}`
  const isFirstReport = try Ref.modify(reportedRefusals, reported => [
    !HashSet.has(reported, line),
    HashSet.add(reported, line),
  ])

  if (isFirstReport) {
    try Console.error(line)
  }
}

const trustedRegistryDirectory = (
  registryReader: RelayRegistryReader,
): Option<string>!!RelayRegistryServices | ChildProcessSpawner.ChildProcessSpawner =>
  (effect {
    const fileSystem = try FileSystem.FileSystem
    const directory = try relayRegistryDirectory
    const isPresent = fileSystem
      .exists(directory) catch () => false
    if (!isPresent) {
      return Option.none()
    }

    const inspection = try registryReader.trust.inspect(directory)

    if (Option.isSome(inspection.maybeRefusal)) {
      try reportRefusal(
        registryReader.reportedRefusals,
        directory,
        inspection.maybeRefusal.value,
      )

      return Option.none()
    }

    return Option.some(inspection.directory)
  }) |> Effect.orElseSucceed(%, () => Option.none<string>())

const realRoot = effect (
  root: string,
): string!!RelayRegistryServices => {
  const fileSystem = try FileSystem.FileSystem
  const path = try Path.Path
  const resolvedRoot = path.resolve(root)

  return fileSystem
    .realPath(resolvedRoot) catch () => resolvedRoot
}

const segmentCount = (root: string, path: Path): number =>
  pipe(
    root,
    Effect.String.split(path.sep),
    Effect.Array.filter(Effect.String.isNonEmpty),
    Effect.Array.length,
  )

export const discoverRelays = effect (
  projectRoot: string,
  registryReader: RelayRegistryReader,
): ReadonlyArray<RelayRecord>!never!RelayRegistryServices | ChildProcessSpawner.ChildProcessSpawner => {
  const maybeDirectory = try trustedRegistryDirectory(registryReader)

  if (Option.isNone(maybeDirectory)) {
    return []
  }

  const fileSystem = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = maybeDirectory.value
  const fileNames = try (fileSystem
    .readDirectory(directory)
    |> Effect.orElseSucceed(%, (): ReadonlyArray<string> => []))
  const recordFileNames = Effect.Array.filter(
    fileNames,
    Effect.String.endsWith(RECORD_FILE_EXTENSION),
  )
  const records = Effect.Array.getSomes(
    try Effect.forEach(
      recordFileNames,
      recordFileName =>
        readLiveRecordFile(path.join(directory, recordFileName)),
    ),
  )

  const realProjectRoot = try realRoot(projectRoot)
  const rootedRecords = try Effect.forEach(
    records,
    record => Effect.map(realRoot(record.root), root => ({ record, root })),
  )

  const recordsInside = Effect.Array.filter(
    rootedRecords,
    ({ root }) => isWithinRoot(realProjectRoot, root, path),
  )
  const recordsEnclosing = Effect.Array.filter(
    rootedRecords,
    ({ root }) => isWithinRoot(root, realProjectRoot, path),
  )
  const nearestDepth = Effect.Array.reduce(
    recordsEnclosing,
    0,
    (depth, { root }) => Math.max(depth, segmentCount(root, path)),
  )
  const selected = Effect.Array.match(recordsInside, {
    onEmpty: () =>
      Effect.Array.filter(
        recordsEnclosing,
        ({ root }) => segmentCount(root, path) === nearestDepth,
      ),
    onNonEmpty: inside => inside,
  })

  return pipe(
    selected,
    Effect.Array.map(({ record }) => record),
    Effect.Array.sort(newestFirst),
  )
}
