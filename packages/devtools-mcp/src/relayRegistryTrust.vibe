import {
  Array as EffectArray,
  Duration,
  Effect,
  FileSystem,
  Option,
  type PlatformError,
  String as EffectString,
  pipe,
} from 'effect'
import { ChildProcess, ChildProcessSpawner } from 'effect/process'

import {
  type DirectoryEntry,
  currentUid,
  parentDirectory,
  platformName,
  readDirectoryEntry,
  realPath,
  realTemporaryDirectory,
  systemRoot,
  windowsJoin,
  windowsParentDirectory,
  windowsRelative,
} from './relayRegistryTrust.platform.ts'

const PERMISSIONS_BEYOND_OWNER = 0o077
const PARENT_WRITE_PERMISSIONS = 0o022
const STICKY_DIRECTORY = 0o1000
const ROOT_UID = 0
const PROBE_TIMEOUT = Duration.seconds(10)
const PROBED_DIRECTORY_VARIABLE = 'FOLDKIT_DEVTOOLS_PROBED_DIRECTORY'
const DARWIN_ACL_ENTRY_PATTERN = /^\s*\d+:\s+.+\s(allow|deny)\s+\S+/
const DARWIN_DIRECTORY_MODE_PATTERN = /^d[rwxstST-]{9}[+@ ]/
const PROBE_SCRIPT =
  `$sections = [System.Security.AccessControl.AccessControlSections]::Owner -bor [System.Security.AccessControl.AccessControlSections]::Access; $directories = [System.Collections.Generic.List[string]]::new(); $directory = [System.IO.DirectoryInfo]::new($env:${PROBED_DIRECTORY_VARIABLE}); while ($null -ne $directory) { $directories.Insert(0, $directory.FullName); $directory = $directory.Parent }; foreach ($path in $directories) { $attributes = [System.IO.File]::GetAttributes($path); if (($attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { 'REPARSE_POINT' } else { 'DIRECTORY' }; ([System.IO.Directory]::GetAccessControl($path)).GetSecurityDescriptorSddlForm($sections) }; & "$env:SystemRoot\\System32\\whoami.exe" /user /fo csv /nh`

const UNVERIFIED_OWNERSHIP = 'has ownership that cannot be verified'
const UNVERIFIED_PERMISSIONS = 'has permissions that cannot be verified'
const OWNED_BY_ANOTHER_USER = 'is owned by another user'
const SHARED_WITH_OTHER_USERS = 'is readable or writable by other users'
const NOT_REGULAR_DIRECTORY = 'is not a regular directory'
const REPLACEABLE_PARENT =
  'has a parent directory that another user can replace'
const REPARSE_PARENT = 'has a reparse-point directory in its path'
const OUTSIDE_WINDOWS_TEMP = 'is outside the Windows user temporary directory'

const SECURITY_DESCRIPTOR_PATTERN =
  /^O:(S-1-[0-9-]+|[A-Z]{2})(?:G:(?:S-1-[0-9-]+|[A-Z]{2}))?(?:D:([A-Z_]*)((?:\([^()]*\))*))?(?:S:.*)?$/
const OWNER_GROUP = 1
const ACCESS_CONTROL_FLAGS_GROUP = 2
const ACCESS_CONTROL_ENTRIES_GROUP = 3
const ACCESS_CONTROL_ENTRY_PATTERN = /\(([^()]*)\)/g
const ACCESS_CONTROL_ENTRY_GROUP = 1
const ACCESS_CONTROL_ENTRY_FIELD_COUNT = 6
const NO_ACCESS_CONTROL_FLAG = 'NO_ACCESS_CONTROL'
const ALLOW_ENTRY_TYPES: ReadonlyArray<string> = ['A', 'OA']
const DENY_ENTRY_TYPES: ReadonlyArray<string> = ['D', 'OD']
const PRIVILEGED_ACCOUNTS: ReadonlyArray<string> = [
  'SY',
  'S-1-5-18',
  'BA',
  'S-1-5-32-544',
  'LA',
]
const TRUSTED_INSTALLER_SID =
  'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464'
const CREATOR_ACCOUNTS: ReadonlyArray<string> = [
  'CO',
  'S-1-3-0',
  'OW',
  'S-1-3-4',
]
const QUOTED_CSV_FIELD_PATTERN = /"([^"]*)"/g
const QUOTED_CSV_FIELD_GROUP = 1
const SECURITY_IDENTIFIER_PATTERN = /^S-1-[0-9-]+$/

type AccessControlEntry = Readonly<{
  type: string
  flags: string
  rights: string
  account: string
}>

type SecurityDescriptor = Readonly<{
  owner: string
  flags: string
  entries: ReadonlyArray<AccessControlEntry>
}>

error WindowsProbeFailed
error DirectoryProbeFailed

export type RelayRegistryInspection = Readonly<{
  directory: string
  maybeRefusal: Option.Option<string>
}>

export type RelayRegistryTrust = Readonly<{
  inspect: (
    directory: string,
  ) => RelayRegistryInspection!never!ChildProcessSpawner.ChildProcessSpawner
}>

type DirectoryInfo = Pick<FileSystem.File.Info, 'mode' | 'uid'>

export const relayRegistryDirectoryRefusal = (
  info: DirectoryInfo,
  maybeCurrentUid: Option.Option<number>,
): Option.Option<string> =>
  Option.match(maybeCurrentUid, {
    onNone: () => Option.some(UNVERIFIED_OWNERSHIP),
    onSome: currentUid => {
      if (Option.isNone(info.uid)) {
        return Option.some(UNVERIFIED_OWNERSHIP)
      }

      if (info.uid.value !== currentUid) {
        return Option.some(OWNED_BY_ANOTHER_USER)
      }

      if ((info.mode & PERMISSIONS_BEYOND_OWNER) !== 0) {
        return Option.some(SHARED_WITH_OTHER_USERS)
      }

      return Option.none()
    },
  })

const posixDirectoryRefusal = (
  modeValue: bigint,
  uidValue: bigint,
): Option.Option<string> => {
  const mode = globalThis.Number(modeValue)
  const uid = globalThis.Number(uidValue)

  if (
    !globalThis.Number.isSafeInteger(mode)
    || !globalThis.Number.isSafeInteger(uid)
  ) {
    return Option.some(UNVERIFIED_OWNERSHIP)
  }

  return relayRegistryDirectoryRefusal(
    { mode, uid: Option.some(uid) },
    Option.fromNullishOr(currentUid()),
  )
}

const directoryChain = (
  directory: string,
  parentOf: (path: string) => string = parentDirectory,
): ReadonlyArray<string> => {
  const directories: Array<string> = []
  let current = directory

  while (true) {
    directories.push(current)
    const parent = parentOf(current)

    if (parent === current) {
      return EffectArray.reverse(directories)
    }

    current = parent
  }
}

const posixParentChainRefusal = (
  directory: string,
): Option<string>!DirectoryProbeFailed => {
  const maybeCurrentUid = sync(() => currentUid())

  if (maybeCurrentUid === undefined) {
    return Option.some(UNVERIFIED_OWNERSHIP)
  }

  for (const component of directoryChain(directory)) {
    const entry = try Effect.tryPromise({
      try: () => readDirectoryEntry(component),
      catch: () => new DirectoryProbeFailed(),
    })
    const uid = globalThis.Number(entry.uid)
    const mode = globalThis.Number(entry.mode)

    if (
      entry.isSymbolicLink
      || !entry.isDirectory
      || !globalThis.Number.isSafeInteger(uid)
      || !globalThis.Number.isSafeInteger(mode)
    ) {
      return Option.some(UNVERIFIED_OWNERSHIP)
    }

    if (uid !== maybeCurrentUid && uid !== ROOT_UID) {
      return Option.some(REPLACEABLE_PARENT)
    }

    const isParent = component !== directory
    const isWritableByOtherUsers = (mode & PARENT_WRITE_PERMISSIONS) !== 0
    const isSticky = (mode & STICKY_DIRECTORY) !== 0

    if (isParent && isWritableByOtherUsers && !isSticky) {
      return Option.some(REPLACEABLE_PARENT)
    }
  }

  return Option.none<string>()
}

const darwinAclOutputRefusal = (
  output: string,
  isLeaf: boolean,
): Option.Option<string> => {
  const outputLines = EffectString.split(output, /\r?\n/)
  const lines = output.endsWith('\n')
    ? EffectArray.dropRight(outputLines, 1)
    : outputLines
  const maybeSummary = EffectArray.head(lines)

  if (
    Option.isNone(maybeSummary)
    || !DARWIN_DIRECTORY_MODE_PATTERN.test(maybeSummary.value)
  ) {
    return Option.some(UNVERIFIED_PERMISSIONS)
  }

  for (const line of EffectArray.drop(lines, 1)) {
    const maybeAction = Option.flatMap(
      Option.fromNullishOr(DARWIN_ACL_ENTRY_PATTERN.exec(line)),
      entry => EffectArray.get(entry, 1),
    )

    if (Option.isNone(maybeAction)) {
      return Option.some(UNVERIFIED_PERMISSIONS)
    }

    if (maybeAction.value === 'allow') {
      return Option.some(isLeaf ? SHARED_WITH_OTHER_USERS : REPLACEABLE_PARENT)
    }
  }

  return Option.none()
}

const darwinAclChainProbe = (
  directory: string,
): Option<string>!DirectoryProbeFailed | PlatformError.PlatformError!ChildProcessSpawner.ChildProcessSpawner => {
  const spawner = ChildProcessSpawner.ChildProcessSpawner()

  for (const component of directoryChain(directory)) {
    using probe = spawner.spawn(
      ChildProcess.make(
        '/bin/ls',
        ['-l', '-d', '-e', '-P', '-b', '--', component],
        {
          env: { LC_ALL: 'C' },
          extendEnv: true,
          stdin: 'ignore',
          stderr: 'ignore',
        },
      ),
    )
    const [output, exitCode] = try.all [
      probe.stdout.decodeText().mkString(),
      probe.exitCode,
    ]

    if (exitCode !== 0) {
      throw new DirectoryProbeFailed()
    }

    const maybeRefusal = darwinAclOutputRefusal(output, component === directory)

    if (Option.isSome(maybeRefusal)) {
      return maybeRefusal
    }
  }

  return Option.none<string>()
}

const darwinAclChainRefusal = (
  directory: string,
): Option<string>!DirectoryProbeFailed!ChildProcessSpawner.ChildProcessSpawner => {
  try {
    return timeout(darwinAclChainProbe(directory), PROBE_TIMEOUT)
  } catch {
    throw new DirectoryProbeFailed()
  }
}

const capturedGroup = (
  match: RegExpMatchArray,
  group: number,
): Option.Option<string> =>
  Option.flatMap(EffectArray.get(match, group), Option.fromNullishOr)

const parseAccessControlEntry = (
  entry: string,
): Option.Option<AccessControlEntry> => {
  const fields = EffectString.split(entry, ';')

  if (fields.length !== ACCESS_CONTROL_ENTRY_FIELD_COUNT) {
    return Option.none()
  }

  const type = EffectArray.headNonEmpty(fields)
  const isKnownType = EffectArray.contains(ALLOW_ENTRY_TYPES, type)
    || EffectArray.contains(DENY_ENTRY_TYPES, type)
  if (!isKnownType) {
    return Option.none()
  }

  return Option.all({
    type: Option.some(type),
    flags: EffectArray.get(fields, 1),
    rights: EffectArray.get(fields, 2),
    account: Option.some(EffectArray.lastNonEmpty(fields)),
  })
}

const parseAccessControlEntries = (
  entries: string,
): Option.Option<ReadonlyArray<AccessControlEntry>> =>
  pipe(
    entries,
    EffectString.matchAll(ACCESS_CONTROL_ENTRY_PATTERN),
    EffectArray.fromIterable,
    EffectArray.map(entry =>
      Option.flatMap(
        capturedGroup(entry, ACCESS_CONTROL_ENTRY_GROUP),
        parseAccessControlEntry,
      )
    ),
    Option.all,
  )

const parseSecurityDescriptor = (
  sddl: string,
): Option.Option<SecurityDescriptor> =>
  Option.flatMap(
    Option.fromNullishOr(SECURITY_DESCRIPTOR_PATTERN.exec(sddl)),
    descriptor =>
      Option.all({
        owner: capturedGroup(descriptor, OWNER_GROUP),
        flags: capturedGroup(descriptor, ACCESS_CONTROL_FLAGS_GROUP),
        entries: Option.flatMap(
          capturedGroup(descriptor, ACCESS_CONTROL_ENTRIES_GROUP),
          parseAccessControlEntries,
        ),
      }),
  )

export const windowsDirectoryRefusal = (
  sddl: string,
  currentUserSid: string,
): Option.Option<string> => {
  const maybeRawDescriptor = Option.fromNullishOr(
    SECURITY_DESCRIPTOR_PATTERN.exec(sddl),
  )

  if (Option.isNone(maybeRawDescriptor)) {
    return Option.some(UNVERIFIED_OWNERSHIP)
  }

  const maybeDescriptor = parseSecurityDescriptor(sddl)

  if (Option.isNone(maybeDescriptor)) {
    return Option.some(UNVERIFIED_PERMISSIONS)
  }

  const { owner, flags, entries } = maybeDescriptor.value

  if (EffectString.includes(NO_ACCESS_CONTROL_FLAG)(flags)) {
    return Option.some(SHARED_WITH_OTHER_USERS)
  }

  const trustedOwners = [currentUserSid, ...PRIVILEGED_ACCOUNTS]

  if (!EffectArray.contains(trustedOwners, owner)) {
    return Option.some(OWNED_BY_ANOTHER_USER)
  }

  const trustedAccounts = [...trustedOwners, ...CREATOR_ACCOUNTS]
  const isSharedWithOtherUsers = EffectArray.some(
    entries,
    ({ type, account }) =>
      EffectArray.contains(ALLOW_ENTRY_TYPES, type)
      && !EffectArray.contains(trustedAccounts, account),
  )

  if (isSharedWithOtherUsers) {
    return Option.some(SHARED_WITH_OTHER_USERS)
  }

  return Option.none()
}

const SDDL_ACCESS_RIGHT_CODES: ReadonlyArray<string> = [
  'GA',
  'GR',
  'GW',
  'GX',
  'RC',
  'LC',
  'SD',
  'WD',
  'WO',
  'FA',
  'FR',
  'FW',
  'FX',
]
const HEX_ACCESS_RIGHTS_PATTERN = /^0x[0-9a-f]+$/i
const SYMBOLIC_ACCESS_RIGHTS_PATTERN = /[A-Z]{2}/g
const WRITE_DATA_ACCESS = 0x0000_0002
const WRITE_ATTRIBUTES_ACCESS = 0x0000_0100
const DELETE_ACCESS = 0x0001_0000
const DELETE_CHILD_ACCESS = 0x0000_0040
const CHANGE_PERMISSIONS_ACCESS = 0x0004_0000
const TAKE_OWNERSHIP_ACCESS = 0x0008_0000
const GENERIC_ALL_ACCESS = 0x1000_0000
const GENERIC_WRITE_ACCESS = 0x4000_0000
const KNOWN_FILE_ACCESS = 0xf11f_01ff
const CHILD_REPLACEMENT_ACCESS = WRITE_DATA_ACCESS
  | WRITE_ATTRIBUTES_ACCESS
  | DELETE_ACCESS
  | CHANGE_PERMISSIONS_ACCESS
  | TAKE_OWNERSHIP_ACCESS
  | GENERIC_ALL_ACCESS
  | GENERIC_WRITE_ACCESS
const PARENT_REPLACEMENT_ACCESS = DELETE_CHILD_ACCESS
  | CHANGE_PERMISSIONS_ACCESS
  | TAKE_OWNERSHIP_ACCESS
  | GENERIC_ALL_ACCESS

const symbolicAccessRights = (
  rights: string,
): Option.Option<ReadonlyArray<string>> =>
  Option.flatMap(
    pipe(
      rights,
      EffectString.matchAll(SYMBOLIC_ACCESS_RIGHTS_PATTERN),
      EffectArray.fromIterable,
      EffectArray.map(EffectArray.head),
      Option.all,
    ),
    codes => {
      const isComplete = EffectArray.length(codes) * 2 === rights.length
      const areKnown = EffectArray.every(codes, code =>
        EffectArray.contains(SDDL_ACCESS_RIGHT_CODES, code))

      return isComplete && areKnown && EffectArray.isArrayNonEmpty(codes)
        ? Option.some(codes)
        : Option.none()
    },
  )

const accessGrantsReplacement = (
  rights: string,
  mask: number,
  symbolicRights: ReadonlyArray<string>,
): Option.Option<boolean> => {
  if (HEX_ACCESS_RIGHTS_PATTERN.test(rights)) {
    const parsed = globalThis.Number.parseInt(rights.slice(2), 16)
    const isKnownMask = globalThis.Number.isSafeInteger(parsed)
      && parsed <= 0xffff_ffff
      && ((parsed >>> 0) & ~KNOWN_FILE_ACCESS) === 0

    return isKnownMask ? Option.some((parsed & mask) !== 0) : Option.none()
  }

  return Option.map(
    symbolicAccessRights(rights),
    codes =>
      EffectArray.some(
        codes,
        code => EffectArray.contains([...symbolicRights, 'GA', 'FA'], code),
      ),
  )
}

export const windowsDirectoryChainRefusal = (
  descriptors: ReadonlyArray<string>,
  currentUserSid: string,
): Option.Option<string> => {
  if (Option.isNone(EffectArray.head(descriptors))) {
    return Option.some(UNVERIFIED_OWNERSHIP)
  }

  const maybeParentDescriptors = Option.all(
    EffectArray.map(
      EffectArray.dropRight(descriptors, 1),
      parseSecurityDescriptor,
    ),
  )

  if (Option.isNone(maybeParentDescriptors)) {
    return Option.some(UNVERIFIED_PERMISSIONS)
  }

  const parentDescriptors = maybeParentDescriptors.value
  const trustedParentOwners = [
    currentUserSid,
    ...PRIVILEGED_ACCOUNTS,
    TRUSTED_INSTALLER_SID,
  ]
  const trustedAccounts = [...trustedParentOwners, ...CREATOR_ACCOUNTS]

  for (const [index, descriptor] of parentDescriptors.entries()) {
    if (!EffectArray.contains(trustedParentOwners, descriptor.owner)) {
      return Option.some(REPLACEABLE_PARENT)
    }

    if (EffectString.includes(NO_ACCESS_CONTROL_FLAG)(descriptor.flags)) {
      return Option.some(REPLACEABLE_PARENT)
    }

    const isRoot = index === 0

    for (const entry of descriptor.entries) {
      const isUntrustedAllow =
        EffectArray.contains(ALLOW_ENTRY_TYPES, entry.type)
        && !EffectArray.contains(trustedAccounts, entry.account)
        && !EffectString.includes('IO')(entry.flags)

      if (!isUntrustedAllow) {
        continue
      }

      const maybeCanReplaceSelf = isRoot
        ? Option.some(false)
        : accessGrantsReplacement(entry.rights, CHILD_REPLACEMENT_ACCESS, [
          'SD',
          'WD',
          'WO',
          'FW',
          'GW',
        ])
      const maybeCanReplaceChild = accessGrantsReplacement(
        entry.rights,
        PARENT_REPLACEMENT_ACCESS,
        ['DC', 'WD', 'WO'],
      )
      const maybeCanReplace = Option.map(
        Option.all([maybeCanReplaceSelf, maybeCanReplaceChild]),
        EffectArray.some(value => value),
      )

      if (Option.isNone(maybeCanReplace)) {
        return Option.some(UNVERIFIED_PERMISSIONS)
      }

      if (maybeCanReplace.value) {
        return Option.some(REPLACEABLE_PARENT)
      }
    }
  }

  return Option.none()
}

export const powershellPath = (systemRoot: string): string =>
  windowsJoin(
    systemRoot,
    'System32',
    'WindowsPowerShell',
    'v1.0',
    'powershell.exe',
  )

export const windowsTempRootRefusal = (
  directory: string,
  tempRoot: string,
): Option.Option<string> =>
  windowsRelative(tempRoot, windowsParentDirectory(directory)) === ''
    ? Option.none()
    : Option.some(OUTSIDE_WINDOWS_TEMP)

const currentUserSidFromCsv = (identity: string): Option.Option<string> =>
  pipe(
    identity,
    EffectString.matchAll(QUOTED_CSV_FIELD_PATTERN),
    EffectArray.fromIterable,
    EffectArray.map(field => capturedGroup(field, QUOTED_CSV_FIELD_GROUP)),
    EffectArray.getSomes,
    EffectArray.findLast(field => SECURITY_IDENTIFIER_PATTERN.test(field)),
  )

const probeOutputRefusal = (
  output: string,
  directory: string,
): Option<string>!WindowsProbeFailed => {
  const lines = pipe(
    output,
    EffectString.split(/\r?\n/),
    EffectArray.map(EffectString.trim),
    EffectArray.filter(EffectString.isNonEmpty),
  )
  const maybeCurrentUserSid = Option.flatMap(
    EffectArray.last(lines),
    currentUserSidFromCsv,
  )
  const directoryResults = EffectArray.take(
    lines,
    EffectArray.length(lines) - 1,
  )
  const expectedDirectoryCount = EffectArray.length(
    directoryChain(directory, windowsParentDirectory),
  )

  if (Option.isNone(maybeCurrentUserSid)) {
    throw new WindowsProbeFailed()
  }
  const currentUserSid = maybeCurrentUserSid.value

  if (EffectArray.length(directoryResults) !== expectedDirectoryCount * 2) {
    throw new WindowsProbeFailed()
  }

  const results = EffectArray.chunksOf(directoryResults, 2)
  const kinds = EffectArray.getSomes(EffectArray.map(results, EffectArray.head))
  const descriptors = EffectArray.getSomes(
    EffectArray.map(results, EffectArray.last),
  )

  if (
    EffectArray.length(kinds) !== expectedDirectoryCount
    || EffectArray.length(descriptors) !== expectedDirectoryCount
  ) {
    throw new WindowsProbeFailed()
  }

  if (
    EffectArray.some(
      kinds,
      kind => kind !== 'DIRECTORY' && kind !== 'REPARSE_POINT',
    )
  ) {
    throw new WindowsProbeFailed()
  }

  if (EffectArray.some(kinds, kind => kind === 'REPARSE_POINT')) {
    return Option.some(REPARSE_PARENT)
  }

  const maybeLeafDescriptor = EffectArray.last(descriptors)

  if (Option.isNone(maybeLeafDescriptor)) {
    throw new WindowsProbeFailed()
  }

  return Option.orElse(
    windowsDirectoryChainRefusal(descriptors, currentUserSid),
    () => windowsDirectoryRefusal(maybeLeafDescriptor.value, currentUserSid),
  )
}

const readWindowsDirectoryProbe = (
  directory: string,
  executable: string,
): Option<string>!WindowsProbeFailed | PlatformError.PlatformError!ChildProcessSpawner.ChildProcessSpawner => {
  const spawner = ChildProcessSpawner.ChildProcessSpawner()
  using probe = spawner.spawn(
    ChildProcess.make(
      executable,
      ['-NoProfile', '-NonInteractive', '-Command', PROBE_SCRIPT],
      {
        env: { [PROBED_DIRECTORY_VARIABLE]: directory },
        extendEnv: true,
        stdin: 'ignore',
        stderr: 'ignore',
      },
    ),
  )
  const [output, exitCode] = try.all [
    probe.stdout.decodeText().mkString(),
    probe.exitCode,
  ]

  if (exitCode === 0) {
    return probeOutputRefusal(output, directory)
  }

  throw new WindowsProbeFailed()
}

const readWindowsDirectoryRefusal = (
  directory: string,
  executable: string,
): Option<string>!WindowsProbeFailed!ChildProcessSpawner.ChildProcessSpawner => {
  try {
    return timeout(
      readWindowsDirectoryProbe(directory, executable),
      PROBE_TIMEOUT,
    )
  } catch {
    throw new WindowsProbeFailed()
  }
}

export const probeWindowsDirectory = (
  maybeExecutable: Option<string>,
  directory: string,
): Option<string>!never!ChildProcessSpawner.ChildProcessSpawner => {
  if (maybeExecutable is Option.Some(let executable)) {
    return readWindowsDirectoryRefusal(directory, executable) catch Option.some(UNVERIFIED_OWNERSHIP)
  }

  return Option.some(UNVERIFIED_OWNERSHIP)
}

type DirectoryProbe = Readonly<{
  directory: string
  entry: DirectoryEntry
  maybeRefusal: Option<string>
}>

const probeDirectoryEntry = (
  directory: string,
): DirectoryProbe!DirectoryProbeFailed => {
  const entry = try Effect.tryPromise({
    try: () => readDirectoryEntry(directory),
    catch: () => new DirectoryProbeFailed(),
  })

  if (entry.isSymbolicLink || !entry.isDirectory) {
    return {
      directory,
      entry,
      maybeRefusal: Option.some(NOT_REGULAR_DIRECTORY),
    }
  }

  const canonicalDirectory = try Effect.tryPromise({
    try: () => realPath(directory),
    catch: () => new DirectoryProbeFailed(),
  })
  const canonicalEntry = try Effect.tryPromise({
    try: () => readDirectoryEntry(canonicalDirectory),
    catch: () => new DirectoryProbeFailed(),
  })
  const isSameEntry = entry.dev === canonicalEntry.dev
    && entry.ino === canonicalEntry.ino

  return {
    directory: canonicalDirectory,
    entry: canonicalEntry,
    maybeRefusal: isSameEntry
      ? Option.none<string>()
      : Option.some(UNVERIFIED_OWNERSHIP),
  }
}

const windowsRefusal = (
  directory: string,
): Option<string>!DirectoryProbeFailed!ChildProcessSpawner.ChildProcessSpawner => {
  const tempRoot = try Effect.tryPromise({
    try: () => realTemporaryDirectory(),
    catch: () => new DirectoryProbeFailed(),
  })
  const maybeLocationRefusal = windowsTempRootRefusal(directory, tempRoot)

  if (Option.isSome(maybeLocationRefusal)) {
    return maybeLocationRefusal
  }

  const maybeSystemRoot = sync(() => systemRoot())

  return probeWindowsDirectory(
    Option.fromNullishOr(maybeSystemRoot).map(powershellPath),
    directory,
  )
}

const posixRefusal = (
  probe: DirectoryProbe,
): Option<string>!DirectoryProbeFailed!ChildProcessSpawner.ChildProcessSpawner => {
  const maybeParentRefusal = posixParentChainRefusal(probe.directory)

  if (Option.isSome(maybeParentRefusal)) {
    return maybeParentRefusal
  }

  const maybeLeafRefusal = posixDirectoryRefusal(
    probe.entry.mode,
    probe.entry.uid,
  )

  if (Option.isSome(maybeLeafRefusal)) {
    return maybeLeafRefusal
  }

  const platform = sync(() => platformName())

  return platform === 'darwin'
    ? darwinAclChainRefusal(probe.directory)
    : Option.none<string>()
}

const inspectDirectory = (
  directory: string,
): RelayRegistryInspection!DirectoryProbeFailed!ChildProcessSpawner.ChildProcessSpawner => {
  const probe = probeDirectoryEntry(directory)

  if (Option.isSome(probe.maybeRefusal)) {
    return {
      directory: probe.directory,
      maybeRefusal: probe.maybeRefusal,
    }
  }

  const platform = sync(() => platformName())
  const maybeRefusal = platform === 'win32'
    ? windowsRefusal(probe.directory)
    : posixRefusal(probe)

  if (Option.isSome(maybeRefusal)) {
    return { directory: probe.directory, maybeRefusal }
  }

  const confirmation = probeDirectoryEntry(directory)
  const isSameDirectory = Option.isNone(confirmation.maybeRefusal)
    && confirmation.directory === probe.directory
    && confirmation.entry.dev === probe.entry.dev
    && confirmation.entry.ino === probe.entry.ino

  return {
    directory: probe.directory,
    maybeRefusal: isSameDirectory
      ? Option.none<string>()
      : Option.some(UNVERIFIED_OWNERSHIP),
  }
}

export const relayRegistryTrust: RelayRegistryTrust = {
  inspect: (
    directory: string,
  ): RelayRegistryInspection!!ChildProcessSpawner.ChildProcessSpawner =>
    inspectDirectory(directory) catch {
      directory,
      maybeRefusal: Option.some(UNVERIFIED_OWNERSHIP),
    },
}
