{
  "name": "@foldkit/devtools",
  "version": "0.169.0",
  "description": "In-browser DevTools overlay for Foldkit applications",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && vibelang -b tsconfig.build.json && node scripts/brand-dist.mjs",
    "watch": "vibelang -b tsconfig.build.json --watch",
    "lint": "(pnpm --filter @foldkit/oxlint-plugin build && oxlint src) && eslint --config ../../.vibelang/eslint.config.mjs src --no-error-on-unmatched-pattern",
    "typecheck": "vibelang -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@effect/platform-browser": "4.1.0",
    "@foldkit/ui": ">=0.167.0",
    "effect": "4.1.0",
    "foldkit": ">=0.167.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-7461dd0df1ce.tgz"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.1.0",
    "@foldkit/ui": "workspace:*",
    "@foldkit/vite-plugin": "workspace:*",
    "effect": "4.1.0",
    "fast-check": "^4.10.2",
    "foldkit": "workspace:*",
    "happy-dom": "^20.14.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-43acc36bf08f.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-6f2666fdf1ab.tgz"
  },
  "keywords": [
    "foldkit",
    "devtools",
    "time-travel",
    "debugging"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
