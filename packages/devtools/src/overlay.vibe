      [
        ...OptionExt.when(
          mode === 'TimeTravel',
          h.span(
            [h.Class('pause-column')],
            isPausedHere ? [pauseIconView] : [],
          ),
        )
          .toArray(),
        h.span([h.Class('dot-column')]),
        h.span([h.Class(indexClass)]),
        h.span([h.Class('text-base text-dt-muted font-mono')], ['init']),
