import { Function, String } from 'effect'

export const fromString = Option.liftPredicate(String.isNonEmpty)

export const when: {
  <A>(value: A): (condition: boolean) => Option<A>
  <A>(condition: boolean, value: A): Option<A>
} = Function.dual(2, <A>(condition: boolean, value: A): Option<A> =>
  Option.liftPredicate(value, () => condition),
)
