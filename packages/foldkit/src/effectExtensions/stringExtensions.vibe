import { String as Str, flow } from 'effect'

import { fromString } from './optionExtensions.vibe'

export const stripPrefix = (prefix: string): infer _ =>
  flow(
    Option.liftPredicate(Str.startsWith(prefix)),
    Option.map(Str.slice(prefix.length)),
  )

export const stripPrefixNonEmpty = (prefix: string): infer _ =>
  flow(stripPrefix(prefix), Option.flatMap(fromString))
