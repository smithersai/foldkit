import { Function as EffectFunction } from 'effect'

import {
  PreserveModelMessage,
  RequestModelMessage,
  RestoreModelMessage,
} from './modelPreservation.vibe'
import { warnMissingVitePlugin } from './modelPreservationBridge.platform.ts'

const encodePreserveModelMessage = Schema.encodeUnknownSync(
  PreserveModelMessage,
)
const encodeRequestModelMessage = Schema.encodeUnknownSync(RequestModelMessage)
const decodeRestoreModelMessage = Schema.decodeUnknownExit(RestoreModelMessage)

export const preserveModel = (
  id: string,
  encodedModel: unknown,
  isReloadFlush: boolean,
): void => {
  if (import.meta.hot) {
    import.meta.hot.send(
      'foldkit:preserve-model',
      encodePreserveModelMessage(
        PreserveModelMessage.make({ id, model: encodedModel, isReloadFlush }),
      ),
    )
  }
}

const PLUGIN_RESPONSE_TIMEOUT_MS = 500

// NOTE: asks @foldkit/vite-plugin for a model preserved across the last
// reload. The plugin only serves a model whose preservation was flushed by a
// reload, so a host-driven dispose-then-embed remount initializes fresh while
// a code reload restores state.
export const resolvePreservedModel = (runtimeId: string): unknown!! => {
  const hot = import.meta.hot
  if (!hot) {
    return undefined
  }

  return timeout(
    callback<
      unknown,
      never,
      [
        string,
        NonNullable<ImportMeta['hot']>,
        typeof decodeRestoreModelMessage,
        typeof encodeRequestModelMessage,
      ]
    >(
      (runtimeId, hot, decodeRestore, encodeRequest, resume) => {
        // callback's function is plain TypeScript, not VibeLang.
        const handler = (message: unknown): void => {
          Exit.match(decodeRestore(message), {
            onFailure: EffectFunction.constVoid,
            onSuccess: ({ id, model }) => {
              if (id === runtimeId) {
                hot.off('foldkit:restore-model', handler)
                resume(model)
              }
            },
          })
        }
        hot.on('foldkit:restore-model', handler)
        hot.send(
          'foldkit:request-model',
          encodeRequest(RequestModelMessage.make({ id: runtimeId })),
        )
        return () => hot.off('foldkit:restore-model', handler)
      },
      runtimeId,
      hot,
      decodeRestoreModelMessage,
      encodeRequestModelMessage,
    ),
    PLUGIN_RESPONSE_TIMEOUT_MS,
  ) catch effect () => {
    try sync(() => warnMissingVitePlugin())
    return undefined
  }
}
