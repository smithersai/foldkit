import { String as Str } from 'effect'

import { OptionExt } from '../effectExtensions/index.ts'

/** Schema representing a parsed URL with protocol, host, port, pathname, search, and hash fields. */
export const Url = Schema.Struct({
  protocol: Schema.String,
  host: Schema.String,
  port: Schema.Option(Schema.String),
  pathname: Schema.String,
  search: Schema.Option(Schema.String),
  hash: Schema.Option(Schema.String),
})
export type Url = typeof Url.Type

schema LocationAndHref {
  href: string
  location: {
    protocol: string
    host: string
    port: string
  }
}

const LocationAndHrefFromString = Schema.String.pipe(
  Schema.decodeTo(
    LocationAndHref,
    SchemaTransformation.transformEffect({
      decode: effect urlString =>
        try Effect.try({
          try: () => {
            const url = new URL(urlString)
            return {
              href: `${url.pathname}${url.search}${url.hash}`,
              location: {
                protocol: url.protocol,
                host: url.hostname,
                port: url.port,
              },
            }
          },
          catch: () =>
            new SchemaIssue.InvalidValue({
              message: `Invalid URL: ${urlString}`,
            }),
        }),
      encode: effect ({ href, location }) => {
        const portString = location.port ? `:${location.port}` : ''
        return `${location.protocol}//${location.host}${portString}${href}`
      },
    }),
  ),
)

const UrlFromLocationAndHref = LocationAndHref.pipe(
  Schema.decodeTo(
    Url,
    SchemaTransformation.transform({
      decode: ({ href, location }) => {
        const [pathAndQuery, hashPart] = Str.split(href, '#')
        const [pathname, searchPart] = Str.split(pathAndQuery, '?')

        return {
          protocol: location.protocol,
          host: location.host,
          port: OptionExt.fromString(location.port),
          pathname: pathname || '/',
          search: OptionExt.fromString(searchPart || ''),
          hash: OptionExt.fromString(hashPart || ''),
        }
      },
      encode: url => {
        const search = match (url.search) {
          when Option.None: '';
          when Option.Some(let s): `?${s}`;
        }
        const hash = match (url.hash) {
          when Option.None: '';
          when Option.Some(let h): `#${h}`;
        }
        const href = `${url.pathname}${search}${hash}`

        return {
          href,
          location: {
            protocol: url.protocol,
            host: url.host,
            port: url.port.getOrElse(() => ''),
          },
        }
      },
    }),
  ),
)

const UrlFromString = LocationAndHrefFromString.pipe(
  Schema.decodeTo(UrlFromLocationAndHref),
)

/** Parses a URL string into a `Url`, returning `Option.None` if invalid. */
export const fromString = (str: string): infer _ =>
  Schema.decodeOption(UrlFromString)(str)
/** Serializes a `Url` back to a string. */
export const toString = (url: Url): infer _ =>
  Schema.encodeSync(UrlFromString)(url)
