import type { Root, RootContent, Yaml } from 'mdast'
import remarkDirective from 'remark-directive'
import remarkFrontmatter from 'remark-frontmatter'
import remarkGfm from 'remark-gfm'
import remarkParse from 'remark-parse'
import { unified } from 'unified'
import type { Plugin } from 'vite'

import { MarkdownDocument, encodeDocument } from '../ast/index.js'
import {
  type FrontmatterDefinition,
  type InvalidFrontmatter,
  parseFrontmatter,
  validateFrontmatter,
} from './frontmatter.vibe'
import {
  type NormalizeError,
  type NormalizeOptions,
  normalize,
} from './normalize.vibe'
import type { InvalidFields } from './validateFields.vibe'

/** Options for {@link markdown}, {@link parseMarkdown}, and {@link parseMarkdownWithFrontmatter}. */
export type MarkdownPluginOptions =
  & NormalizeOptions
  & Readonly<{
    frontmatter?: FrontmatterDefinition | undefined
  }>

/** A parsed document together with its frontmatter fields, when it has any. */
export type ParsedMarkdown = Readonly<{
  document: MarkdownDocument
  maybeFrontmatter: Option.Option<Readonly<Record<string, string>>>
}>

/** Plugin options outside the documented shape: a definition that is not a Schema struct. */
export error InvalidPluginOptions { message: string }

// NOTE: remark-frontmatter is included so that YAML frontmatter parses as one
// `yaml` node. With a `frontmatter` schema configured it becomes the document's
// typed frontmatter; without one it fails the build with guidance. Without the
// remark plugin, remark reads `---` fences as a thematic break plus a setext
// heading and renders garbage.
function remarkFrontmatterPlugin(
  this: ThisParameterType<typeof remarkFrontmatter>,
  ...args: Parameters<typeof remarkFrontmatter>
): ReturnType<typeof remarkFrontmatter> {
  return remarkFrontmatter.apply(this, args)
}

function remarkGfmPlugin(
  this: ThisParameterType<typeof remarkGfm>,
  ...args: Parameters<typeof remarkGfm>
): ReturnType<typeof remarkGfm> {
  return remarkGfm.apply(this, args)
}

function remarkDirectivePlugin(
  this: ThisParameterType<typeof remarkDirective>,
  ...args: Parameters<typeof remarkDirective>
): ReturnType<typeof remarkDirective> {
  return remarkDirective.apply(this, args)
}

const processor = unified()
  .use(remarkParse)
  .use(remarkFrontmatterPlugin)
  .use(remarkGfmPlugin)
  .use(remarkDirectivePlugin)
  .freeze()

const isSchemaStruct = (value: unknown): boolean =>
  Schema.isSchema(value) && 'fields' in value

const validateMarkdownPluginOptions = effect (
  options: MarkdownPluginOptions,
): MarkdownPluginOptions!InvalidPluginOptions => {
  const { islands, frontmatter } = options
  if (islands !== undefined) {
    for (const [islandName, attributesSchema] of Object.entries(islands)) {
      if (!isSchemaStruct(attributesSchema)) {
        throw new InvalidPluginOptions({
          message:
            `Island "${islandName}" in markdown plugin options must map to a Schema struct describing its attributes.`,
        })
      }
    }
  }
  if (frontmatter !== undefined && !isSchemaStruct(frontmatter)) {
    throw new InvalidPluginOptions({
      message:
        'The `frontmatter` markdown plugin option must be a Schema struct describing the frontmatter fields.',
    })
  }
  return options
}

const isYamlNode = (node: RootContent): node is Yaml => node.type === 'yaml'

type ExtractedFrontmatter = Readonly<{
  contentRoot: Root
  maybeFrontmatter: Option.Option<Readonly<Record<string, string>>>
}>

const extractFrontmatter = effect (
  root: Root,
  frontmatter: FrontmatterDefinition | undefined,
): ExtractedFrontmatter!(InvalidFrontmatter | InvalidFields) => {
  if (frontmatter === undefined) {
    return { contentRoot: root, maybeFrontmatter: Option.none() }
  }

  const maybeYamlNode = Option.filter(
    Effect.Array.head(root.children),
    isYamlNode,
  )
  if (Option.isNone(maybeYamlNode)) {
    return { contentRoot: root, maybeFrontmatter: Option.none() }
  }

  const yamlNode = maybeYamlNode.value
  const parsedFields = try parseFrontmatter(yamlNode.value, yamlNode.position)
  try validateFrontmatter(frontmatter, parsedFields, yamlNode.position)

  return {
    contentRoot: { ...root, children: root.children.slice(1) },
    maybeFrontmatter: Option.some(parsedFields.fields),
  }
}

const parseWithValidatedOptions = effect (
  source: string,
  options: MarkdownPluginOptions,
): ParsedMarkdown!(NormalizeError | InvalidFrontmatter) => {
  const { contentRoot, maybeFrontmatter } = try extractFrontmatter(
    try Effect.orDie(
      Effect.try({ try: () => processor.parse(source), catch: cause => cause }),
    ),
    options.frontmatter,
  )
  return {
    document: try normalize(contentRoot, options),
    maybeFrontmatter,
  }
}

const parse = effect (
  source: string,
  options: MarkdownPluginOptions,
): ParsedMarkdown!(NormalizeError | InvalidFrontmatter | InvalidPluginOptions) => {
  const validatedOptions = try validateMarkdownPluginOptions(options)
  return try parseWithValidatedOptions(source, validatedOptions)
}

/**
 * Parses markdown source into a typed {@link MarkdownDocument}. Throws on any
 * construct outside the markdown vocabulary, and on malformed options. The
 * {@link markdown} plugin runs this per `.md` module; call it directly for
 * one-off compilation in scripts. Frontmatter, when enabled via the
 * `frontmatter` option, is validated and dropped; use
 * {@link parseMarkdownWithFrontmatter} to read it.
 */
export const parseMarkdown = (
  source: string,
  options: MarkdownPluginOptions = {},
): MarkdownDocument => runSync(parse(source, options)).document

/**
 * Like {@link parseMarkdown}, but also returns the document's frontmatter
 * fields when the `frontmatter` option is set and the source carries a
 * frontmatter block. The fields arrive as the raw strings the block declares,
 * already validated against the schema, so decoding them with the same schema
 * cannot fail.
 */
export const parseMarkdownWithFrontmatter = (
  source: string,
  options: MarkdownPluginOptions = {},
): ParsedMarkdown => runSync(parse(source, options))

/**
 * Vite plugin that compiles imported `.md` files at build time into typed
 * document modules. Decode the default export with `decodeDocument` and
 * render it with `Markdown.view`. Every module also carries a `frontmatter`
 * named export: with a `frontmatter` schema configured, it holds the
 * document's validated frontmatter fields, and it is `undefined` when the
 * document has no frontmatter block.
 */
export const markdown = (options: MarkdownPluginOptions = {}): Plugin => {
  const validatedOptions = runSync(validateMarkdownPluginOptions(options))

  return {
    name: 'foldkit-markdown',
    transform(source, id) {
      if (!id.endsWith('.md')) {
        return undefined
      }
      const { document, maybeFrontmatter } = runSync(
        parseWithValidatedOptions(source, validatedOptions),
      )
      const documentExport = `export default ${
        JSON.stringify(encodeDocument(document))
      }`
      // NOTE: `frontmatter` is emitted for every module, `undefined` when the
      // document has no frontmatter block, so the export always exists and the
      // `*.md` ambient declaration cannot promise an export a module lacks.
      const frontmatterExport = match (maybeFrontmatter) {
        when Option.Some(let fields): JSON.stringify(fields);
        when Option.None: 'undefined';
      }
      return {
        code:
          `${documentExport}\nexport const frontmatter = ${frontmatterExport}`,
        map: null,
      }
    },
  }
}
