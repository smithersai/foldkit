{
  "name": "@foldkit/node",
  "version": "0.1.0",
  "description": "Node.js host adapter for Foldkit server-rendered applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && vibelang -b tsconfig.build.json",
    "watch": "vibelang -b tsconfig.build.json --watch",
    "typecheck": "vibelang -p tsconfig.json --noEmit && vibelang -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "peerDependencies": {
    "effect": "4.1.1",
    "foldkit": ">=0.165.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "effect": "4.1.1",
    "foldkit": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13"
  },
  "keywords": [
    "foldkit",
    "node",
    "server-rendering",
    "ssr"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
