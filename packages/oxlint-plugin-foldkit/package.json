{
  "name": "@foldkit/oxlint-plugin",
  "version": "0.15.3",
  "description": "Oxlint rules for Foldkit applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recommended.json": "./recommended.json",
    "./all.json": "./all.json"
  },
  "scripts": {
    "clean": "rimraf dist recommended.json all.json *.tsbuildinfo",
    "build": "pnpm run clean && vibelang -p tsconfig.build.json --emitDeclarationOnly false --declaration false --declarationMap false --composite false --incremental false --rootDir . --outDir dist/native && rolldown -c rolldown.config.ts && vibelang -b tsconfig.build.json && node scripts/generate-presets.mjs",
    "test": "pnpm run typecheck:real-oxlint-fixtures && vitest run",
    "typecheck:real-oxlint-fixtures": "node scripts/typecheck-real-oxlint-fixtures.mjs",
    "typecheck": "vibelang --noEmit"
  },
  "dependencies": {
    "effect-oxlint": "0.3.4",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-4a7e790005b5.tgz"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect": "4.1.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-6a4c55d7d3ae.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-a43d2b04075f.tgz",
    "vibelang-unplugin": "file:../../.vibelang-toolchain/vibelang-unplugin-0.0.11-45a3600458c6.tgz",
    "fast-check": "^4.10.2"
  },
  "files": [
    "dist",
    "!dist/native",
    "recommended.json",
    "all.json"
  ],
  "keywords": [
    "foldkit",
    "oxlint",
    "lint",
    "effect"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/oxlint-plugin-foldkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "imports": {
    "#native/rules/*": {
      "types": "./src/rules/*.vibe",
      "default": "./dist/native/src/rules/*.js"
    }
  }
}
