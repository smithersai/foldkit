{
  "name": "@foldkit/oxlint-plugin",
  "version": "0.15.3",
  "description": "Oxlint rules for Foldkit applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recommended.json": "./recommended.json",
    "./all.json": "./all.json"
  },
  "scripts": {
    "clean": "rimraf dist recommended.json all.json *.tsbuildinfo",
    "build": "pnpm run clean && rolldown -c rolldown.config.ts && vibelang -b tsconfig.build.json && node scripts/generate-presets.mjs",
    "test": "pnpm run typecheck:real-oxlint-fixtures && vitest run",
    "typecheck:real-oxlint-fixtures": "node scripts/typecheck-real-oxlint-fixtures.mjs",
    "typecheck": "vibelang --noEmit"
  },
  "dependencies": {
    "effect-oxlint": "0.3.4",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-52300ffd054c.tgz"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect": "4.1.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-c9437b7749c9.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-f8e51b377e05.tgz",
    "vibelang-unplugin": "file:../../.vibelang-toolchain/vibelang-unplugin-0.0.11-7e3b05c3f55f.tgz",
    "fast-check": "^4.10.2"
  },
  "files": [
    "dist",
    "recommended.json",
    "all.json"
  ],
  "keywords": [
    "foldkit",
    "oxlint",
    "lint",
    "effect"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/oxlint-plugin-foldkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
