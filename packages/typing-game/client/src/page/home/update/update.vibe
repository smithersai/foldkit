import { Array as Arr, String as Str } from 'effect'
import { type Update } from 'foldkit'
import { modifyFields } from 'foldkit/struct'

import { optionWhen } from '../../../optionWhen.vibe'
import { RoomsClient } from '../../../rpc.vibe'
import { FocusRoomIdInput, FocusUsernameInput, JoinRoom } from '../command.vibe'
import { Message, OutMessage } from '../message.vibe'
import { HomeStep, Model } from '../model.vibe'
import { handleKeyPressed } from './handleKeyPressed.vibe'

export type UpdateReturn = Update.ReturnWithOutMessage<
  Model,
  Message,
  OutMessage,
  RoomsClient
>

export const update = (model: Model, message: Message): infer _ =>
  Message.match<UpdateReturn>(message, {
    CompletedFocusUsernameInput: (): infer _ => ({ model }),

    CompletedFocusRoomIdInput: (): infer _ => ({ model }),

    SubmittedUsernameForm: (): infer _ =>
      match (model.homeStep) {
        when { _tag: 'EnterUsername', let username }: do {
          const nextModel = Str.isNonEmpty(username)
            ? modifyFields(model, {
              homeStep: (): infer _ =>
                HomeStep.SelectAction({
                  username,
                  selectedAction: 'CreateRoom',
                }),
            })
            : model
          const result = { model: nextModel }
          result
        };
        default: ({ model });
      },

    PressedKey: (message): infer _ => handleKeyPressed(model)(message),

    ChangedUsername: ({ value }): infer _ => match (model.homeStep) {
      when { _tag: 'EnterUsername' }: ({
        model: modifyFields(model, {
          homeStep: (): infer _ => HomeStep.EnterUsername({ username: value }),
          formError: (): infer _ => Option.none(),
        }),
      });
      default: ({ model });
    },

    BlurredUsernameInput: (): infer _ => ({
      model,
      commands: [FocusUsernameInput()],
    }),

    BlurredRoomIdInput: (): infer _ => ({
      model,
      commands: [FocusRoomIdInput()],
    }),

    ChangedRoomId: ({ value }): infer _ => match (model.homeStep) {
      when { _tag: 'EnterRoomId', let username }: ({
        model: modifyFields(model, {
          homeStep: (): infer _ =>
            HomeStep.EnterRoomId({
              username,
              roomId: value,
            }),
          formError: (): infer _ => Option.none(),
        }),
      });
      default: ({ model });
    },

    SubmittedJoinRoomForm: (): infer _ =>
      match (model.homeStep) {
        when { _tag: 'EnterRoomId', let username, let roomId }:
          roomId === 'exit'
            ? {
              model: modifyFields(model, {
                homeStep: (): infer _ =>
                  HomeStep.SelectAction({
                    username,
                    selectedAction: 'JoinRoom',
                  }),
              }),
            }
            : do {
              const maybeJoin = optionWhen(
                Str.isNonEmpty(roomId),
                (): infer _ => JoinRoom({ username, roomId }),
              )
              const result = { model, commands: Arr.fromOption(maybeJoin) }
              result
            };
        default: ({ model });
      },

    SucceededCreateRoom: ({ roomId, player }): infer _ => ({
      model,
      outMessage: OutMessage.CreatedRoom({ roomId, player }),
    }),

    SucceededJoinRoom: ({ roomId, player }): infer _ => ({
      model,
      outMessage: OutMessage.JoinedRoom({ roomId, player }),
    }),

    FailedCreateRoom: ({ error }): infer _ => ({
      model: modifyFields(model, {
        formError: (): infer _ => Option.some(error),
      }),
    }),

    FailedJoinRoom: ({ error }): infer _ => ({
      model: modifyFields(model, {
        formError: (): infer _ => Option.some(error),
      }),
    }),
  })
