export const UpdatePlayerProgress = Command.define('UpdatePlayerProgress', {
  args: {
    playerId: Schema.String,
    gameId: Schema.String,
    userGameText: Schema.String,
    charsTyped: Schema.Number,
  },
  messages: [Message.CompletedUpdatePlayerProgress],
  execute: effect ({ playerId, gameId, userGameText, charsTyped }) => {
    return effect {
      const client = try RoomsClient
      try client.updatePlayerProgress({
        playerId,
        gameId,
        userText: userGameText,
        charsTyped,
      })
      return (try Effect.orDie(
        Effect.try({
          try: () => Message.CompletedUpdatePlayerProgress(),
          catch: error => error,
        }),
      ))
    } catch effect () => {
      return (try Effect.orDie(
        Effect.try({
          try: () => Message.CompletedUpdatePlayerProgress(),
          catch: error => error,
        }),
      ))
    }
  },
})

export const CopyRoomId = Command.define('CopyRoomId', {
  args: { roomId: Schema.String },
  messages: [Message.SucceededCopyRoomId, Message.FailedCopyRoomId],
  execute: effect ({ roomId }) => {
    provide Clipboard.layer {
      return effect {
        const clipboard = try Clipboard.Clipboard
        try clipboard.writeString(roomId)
        return (try Effect.orDie(
          Effect.try({
            try: () => Message.SucceededCopyRoomId(),
            catch: error => error,
          }),
        ))
      } catch effect () => {
        return (try Effect.orDie(
          Effect.try({
            try: () => Message.FailedCopyRoomId(),
            catch: error => error,
          }),
        ))
      }
    }
  },
})

export const WaitForExitCountdownInterval = Command.define(
  'WaitForExitCountdownInterval',
  {
    messages: [Message.CompletedWaitForExitCountdownInterval],
    execute: effect {
      try Effect.sleep('1 second')
      return completedWaitForExitCountdownInterval
    },
  },
)

const COPY_INDICATOR_DURATION = '2 seconds'

export const WaitBeforeHidingRoomIdCopiedIndicator = Command.define(
  'WaitBeforeHidingRoomIdCopiedIndicator',
  {
    messages: [Message.CompletedWaitBeforeHidingRoomIdCopiedIndicator],
    execute: effect {
      try Effect.sleep(COPY_INDICATOR_DURATION)
      return completedWaitBeforeHidingRoomIdCopiedIndicator
    },
  },
)

// SESSION COMMANDS

export const SavePlayerSession = Command.define('SavePlayerSession', {
  args: { session: RoomPlayerSession },
  messages: [Message.CompletedSavePlayerSession],
  execute: effect ({ session }) => {
    provide BrowserKeyValueStore.layerSessionStorage {
      return effect {
        const store = try KeyValueStore.KeyValueStore
        const sessionJson = try Schema.encodeEffect(
          RoomPlayerSessionJsonString,
        )(session)
        try store.set(ROOM_PLAYER_SESSION_KEY, sessionJson)
        return (try Effect.orDie(
          Effect.try({
            try: () => Message.CompletedSavePlayerSession(),
            catch: error => error,
          }),
        ))
      } catch effect () => {
        return (try Effect.orDie(
          Effect.try({
            try: () => Message.CompletedSavePlayerSession(),
            catch: error => error,
          }),
        ))
      }
    }
  },
})

export const ClearSession = Command.define('ClearSession', {
  messages: [Message.CompletedClearSession],
  execute: effect {
    provide BrowserKeyValueStore.layerSessionStorage {
      return effect {
        const store = try KeyValueStore.KeyValueStore
        try store.remove(ROOM_PLAYER_SESSION_KEY)
        return (try Effect.orDie(
          Effect.try({
            try: () => Message.CompletedClearSession(),
            catch: error => error,
          }),
        ))
      } catch effect () => {
        return (try Effect.orDie(
          Effect.try({
            try: () => Message.CompletedClearSession(),
            catch: error => error,
          }),
        ))
      }
    }
  },
})

export const FocusRoomPageUsernameInput = Command.define(
  'FocusRoomPageUsernameInput',
  {
    messages: [Message.CompletedFocusRoomPageUsernameInput],
    execute: effect {
      Dom.focus(`#${ROOM_PAGE_USERNAME_INPUT_ID}`) catch () => undefined
      return completedFocusRoomPageUsernameInput
    },
  },
)

export const FocusUserGameTextInput = Command.define('FocusUserGameTextInput', {
  messages: [Message.CompletedFocusUserGameTextInput],
  execute: effect {
    Dom.focus(`#${USER_GAME_TEXT_INPUT_ID}`) catch () => undefined
    return completedFocusUserGameTextInput
  },
})
