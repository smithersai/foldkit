import { Command, Dom } from 'foldkit'

import { BrowserKeyValueStore, Clipboard } from '@effect/platform-browser'

import {
  ROOM_PAGE_USERNAME_INPUT_ID,
  ROOM_PLAYER_SESSION_KEY,
  USER_GAME_TEXT_INPUT_ID,
} from '../../constant.ts'
import { RoomsClient } from '../../rpc.vibe'
import { Message } from './message.vibe'
import { RoomPlayerSession, RoomPlayerSessionJsonString } from './model.vibe'

const completedWaitForExitCountdownInterval = Message
  .CompletedWaitForExitCountdownInterval()
const completedWaitBeforeHidingRoomIdCopiedIndicator = Message
  .CompletedWaitBeforeHidingRoomIdCopiedIndicator()
const completedFocusRoomPageUsernameInput = Message
  .CompletedFocusRoomPageUsernameInput()
const completedFocusUserGameTextInput = Message
  .CompletedFocusUserGameTextInput()

export const FetchRoom = Command.define('FetchRoom', {
  args: { roomId: Schema.String },
  messages: [Message.SucceededFetchRoom, Message.FailedFetchRoom],
  execute: effect ({ roomId }) => {
    return effect {
      const client = try RoomsClient
      const room = try client.getRoomById({ roomId })
      return (try Effect.orDie(
        Effect.try({
          try: () => Message.SucceededFetchRoom({ room }),
          catch: error => error,
        }),
      ))
    } catch effect () => {
      return (try Effect.orDie(
        Effect.try({
          try: () => Message.FailedFetchRoom(),
          catch: error => error,
        }),
      ))
    }
  },
})

export const LoadSession = Command.define('LoadSession', {
  args: { roomId: Schema.String },
  messages: [Message.CompletedLoadSession],
  execute: effect ({ roomId }) => {
    provide BrowserKeyValueStore.layerSessionStorage {
      return effect {
        const store = try KeyValueStore.KeyValueStore
        const maybeSessionJson = try store.get(ROOM_PLAYER_SESSION_KEY)
        const sessionJson = try Effect.fromOption(
          Option.fromNullishOr(maybeSessionJson),
        )
        const session = try Schema.decodeEffect(RoomPlayerSessionJsonString)(
          sessionJson,
        )
        return (try Effect.orDie(
          Effect.try({
            try: () =>
              Message.CompletedLoadSession({
                maybeSession: Option.liftPredicate(
                  session,
                  (session) => session.roomId === roomId,
                ),
              }),
            catch: error => error,
          }),
        ))
      } catch effect () => {
        return (try Effect.orDie(
          Effect.try({
            try: () =>
              Message.CompletedLoadSession({ maybeSession: Option.none() }),
            catch: error => error,
          }),
        ))
      }
    }
  },
})

export const JoinRoom = Command.define('JoinRoom', {
  args: { username: Schema.String, roomId: Schema.String },
  messages: [Message.SucceededJoinRoom, Message.FailedJoinRoom],
  execute: effect ({ username, roomId }) => {
    return effect {
      const client = try RoomsClient
      const { player } = try client.joinRoom({ username, roomId })
      return (try Effect.orDie(
        Effect.try({
          try: () => Message.SucceededJoinRoom({ player }),
          catch: error => error,
        }),
      ))
    } catch effect () => {
      return (try Effect.orDie(
        Effect.try({
          try: () => Message.FailedJoinRoom(),
          catch: error => error,
        }),
      ))
    }
  },
})

