import { Array as Arr, Number as Num, String as Str, pipe } from 'effect'
import { AsyncData, Command, type Update } from 'foldkit'
import { pushUrl } from 'foldkit/navigation'
import { modifyFields } from 'foldkit/struct'

import * as Shared from '@typing-game/shared'

import { optionWhen } from '../../../optionWhen.vibe'
import { homeRouter } from '../../../route.vibe'
import { RoomsClient } from '../../../rpc.vibe'
import {
  ClearSession,
  CopyRoomId,
  FocusRoomPageUsernameInput,
  JoinRoom,
  SavePlayerSession,
  StartGame,
  UpdatePlayerProgress,
  WaitBeforeHidingRoomIdCopiedIndicator,
  WaitForExitCountdownInterval,
} from '../command.vibe'
import { Message } from '../message.vibe'
import { Model, RoomAsyncData } from '../model.vibe'
import { validateUserTextInput } from '../userGameText.vibe'
import { handleRoomUpdated } from './handleRoomUpdates.vibe'

const NavigateHome = Command.define('NavigateHome', {
  messages: [Message.CompletedNavigateHome],
  execute: effect {
    try pushUrl(homeRouter())
    return completedNavigateHome
  },
})

export type UpdateReturn = Update.Return<Model, Message, RoomsClient>

/** Per-dispatch parent state the Room page needs from the root.
 *  `roomId` comes from the current Room route when the user is on the
 *  Room page, or from the just-created room when the join flow
 *  bridges from Home. */
export type Context = Readonly<{
  roomId: string
}>

const completedNavigateHome = Message.CompletedNavigateHome()

export const update = (
  model: Model,
  message: Message,
  context: Context,
): infer _ =>
  Message.match<UpdateReturn>(message, {
    PressedKey: handleKeyPressed(model),

    ChangedUserText: ({ value }): infer _ => {
      const maybeRoom = AsyncData.getData(model.roomAsyncData)

      const maybeGameText = maybeRoom
        .flatMap(({ maybeGame }): infer _ => maybeGame)
        .map(({ text }): infer _ => text)

      const userGameText = validateUserTextInput(value, maybeGameText)

      const newCharsTyped = pipe(
        Str.length(userGameText) - Str.length(model.userGameText),
        Num.max(0),
      )
      const nextCharsTyped = model.charsTyped + newCharsTyped

      const commands = Option.all([
        model.maybeSession,
        Option.flatMap(maybeRoom, ({ maybeGame }): infer _ => maybeGame),
      ])
        .map(([session, game]): infer _ =>
          UpdatePlayerProgress({
            playerId: session.player.id,
            gameId: game.id,
            userGameText,
            charsTyped: nextCharsTyped,
          })
        )

      return {
        model: modifyFields(model, {
          userGameText: (): infer _ => userGameText,
          charsTyped: (): infer _ => nextCharsTyped,
        }),
        commands: Arr.fromOption(commands),
      }
    },

    BlurredRoomPageUsernameInput: (): infer _ => ({
      model,
      commands: [FocusRoomPageUsernameInput()],
    }),

    ChangedRoomPageUsername: ({ value }): infer _ => ({
      model: modifyFields(model, {
        username: (): infer _ => value,
      }),
    }),

    SubmittedJoinRoomFromPage: (): infer _ => {
      const maybeJoinRoom = optionWhen(
        Str.isNonEmpty(model.username),
        (): infer _ =>
          JoinRoom({ username: model.username, roomId: context.roomId }),
      )

      return { model, commands: Arr.fromOption(maybeJoinRoom) }
    },

    UpdatedRoom: handleRoomUpdated(model),

    FailedStreamRoom: ({ error: _error }): infer _ => {
      return { model }
    },

    CompletedLoadSession: ({ maybeSession }): infer _ => {
      const maybeFocus = optionWhen(
        Option.isNone(maybeSession) && AsyncData.isSuccess(model.roomAsyncData),
        (): infer _ => FocusRoomPageUsernameInput(),
      )
      return {
        model: modifyFields(model, {
          maybeSession: (): infer _ => maybeSession,
        }),
        commands: Arr.fromOption(maybeFocus),
      }
    },

    SucceededFetchRoom: ({ room }): infer _ => {
      const maybeFocus = optionWhen(
        Option.isNone(model.maybeSession),
        (): infer _ => FocusRoomPageUsernameInput(),
      )
      return {
        model: modifyFields(model, {
          roomAsyncData: (): infer _ => RoomAsyncData.Success({ data: room }),
        }),
        commands: Arr.fromOption(maybeFocus),
      }
    },

    FailedFetchRoom: (): infer _ => ({
      model: modifyFields(model, {
        roomAsyncData: (): infer _ =>
          RoomAsyncData.Failure({ error: 'Room not found' }),
      }),
    }),

    ClickedCopyRoomId: (): infer _ => ({
      model,
      commands: [CopyRoomId({ roomId: context.roomId })],
    }),

    SucceededCopyRoomId: (): infer _ =>
      model.isRoomIdCopyIndicatorVisible
        ? { model }
        : {
          model: modifyFields(model, {
            isRoomIdCopyIndicatorVisible: (): infer _ => true,
          }),
          commands: [WaitBeforeHidingRoomIdCopiedIndicator()],
        },

    CompletedWaitBeforeHidingRoomIdCopiedIndicator: (): infer _ => ({
      model: modifyFields(model, {
        isRoomIdCopyIndicatorVisible: (): infer _ => false,
      }),
    }),

    CompletedWaitForExitCountdownInterval: (): infer _ => {
      const nextSecondsLeft = Num.decrement(model.exitCountdownSecondsLeft)
      const maybeTick = optionWhen(nextSecondsLeft > 0, (): infer _ =>
        WaitForExitCountdownInterval())

      return {
        model: modifyFields(model, {
          exitCountdownSecondsLeft: (): infer _ =>
            nextSecondsLeft,
        }),
        commands: Arr.fromOption(maybeTick),
      }
    },

    SucceededJoinRoom: ({ player }): infer _ => {
      const session = { roomId: context.roomId, player }
      return {
        model: modifyFields(model, {
          maybeSession: (): infer _ => Option.some(session),
        }),
        commands: [SavePlayerSession({ session })],
      }
    },
    CompletedFocusRoomPageUsernameInput: (): infer _ => ({ model }),
    CompletedFocusUserGameTextInput: (): infer _ => ({ model }),
    CompletedNavigateHome: (): infer _ => ({ model }),
    SucceededStartGame: (): infer _ => ({ model }),
    FailedStartGame: (): infer _ => ({ model }),
    CompletedUpdatePlayerProgress: (): infer _ => ({ model }),
    CompletedSavePlayerSession: (): infer _ => ({ model }),
    CompletedClearSession: (): infer _ => ({ model }),
    FailedJoinRoom: (): infer _ => ({ model }),
    FailedCopyRoomId: (): infer _ => ({ model }),
  })

const handleKeyPressed =
  (model: Model): infer _ => ({ key }: { key: string }): UpdateReturn => match (AsyncData.getData(model.roomAsyncData)) {
    when Option.None: ({ model });
    when Option.Some(let room): match (room.status) {
      when { _tag: 'Waiting' }: whenWaiting(model, key, room);
      when { _tag: 'Finished' }: whenFinished(model, key, room);
      default: ({ model });
    };
  }

const whenWaiting = (
  model: Model,
  key: string,
  room: Shared.Room,
): UpdateReturn => {
  const startGame = handleStartGame(model, room)
  return match (key) {
    when 'Backspace': leaveRoom(model);
    when 'Enter': startGame();
    default: ({ model });
  }
}

const whenFinished = (
  model: Model,
  key: string,
  room: Shared.Room,
): UpdateReturn => {
  const startGame = handleStartGame(model, room)
  return match (key) {
    when 'Backspace': model.exitCountdownSecondsLeft === 0
      ? leaveRoom(model)
      : { model };
    when 'Enter': startGame();
    default: ({ model });
  }
}

const leaveRoom = (model: Model): UpdateReturn => ({
  model: modifyFields(model, {
    maybeSession: (): infer _ => Option.none(),
    roomAsyncData: (): infer _ => RoomAsyncData.Loading(),
  }),
  commands: [ClearSession(), NavigateHome()],
})

const handleStartGame =
  (model: Model, room: Shared.Room): infer _ => (): UpdateReturn =>
    match (model.maybeSession) {
      when Option.None: ({ model });
      when Option.Some(let session): do {
        const isHost = session.player.id === room.hostId
        const maybeStartGame = optionWhen(
          isHost,
          (): infer _ =>
            StartGame({ roomId: room.id, playerId: session.player.id }),
        )
        const optionResult11 = {
          model,
          commands: Arr.fromOption(maybeStartGame),
        }
        optionResult11
      };
    }

export const informJoined = (
  model: Model,
  player: Shared.Player,
  context: Context,
): UpdateReturn => update(model, Message.SucceededJoinRoom({ player }), context)
