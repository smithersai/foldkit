import { Subscription } from 'foldkit'

import { Message } from './message.ts'
import { Model } from './model.vibe'
import { Home, Room } from './page/index.ts'

const homeSubscriptions = Subscription.lift(Home.subscriptions)<Model, Message>(
  {
    read: (model): infer _ => Option.some(model.home),
    toParentMessage: (message): infer _ => Message.GotHomeMessage({ message }),
    when: ({ route }): infer _ => route._tag === 'Home',
  },
)

const roomSubscriptions = Subscription.lift(Room.subscriptions)({
  read: (model: Model): infer _ => Option.some(model.room),
  toParentMessage: (message: Room.Message): Message =>
    Message.GotRoomMessage({ message }),
  when: { roomKeyboard: ({ route }): infer _ => route._tag === 'Room' },
})

export const subscriptions = Subscription.aggregate(
  homeSubscriptions,
  roomSubscriptions,
)
