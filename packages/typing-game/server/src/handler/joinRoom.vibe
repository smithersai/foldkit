import { Array, HashMap, Number, Struct, SubscriptionRef } from 'effect'
import { Rpc } from 'effect/rpc'
import { SecureRandom } from 'effect/crypto/SecureRandom'

import * as Shared from '@typing-game/shared'

import * as Rooms from '../roomById.vibe'

const makeUniqueUsername = (
  desiredUsername: string,
  existingPlayers: ReadonlyArray<Shared.Player>,
): string => {
  const existingUsernames = Array.map(
    existingPlayers,
    (player): infer _ => player.username,
  )

  const usernameExists = (username: string): infer _ =>
    Array.contains(existingUsernames, username)

  if (!usernameExists(desiredUsername)) {
    return desiredUsername
  }

  const findAvailableUsername = (counter: number): string => {
    const candidateUsername = `${desiredUsername} (${counter})`
    return usernameExists(candidateUsername)
      ? findAvailableUsername(Number.increment(counter))
      : candidateUsername
  }

  return findAvailableUsername(2)
}

export const joinRoom =
  (roomByIdRef: SubscriptionRef.SubscriptionRef<Shared.RoomById>): infer _ =>
  effect (payload: Rpc.Payload<typeof Shared.joinRoomRpc>) => {
    const playerId = try (try SecureRandom).uuidV4()

    const [room, player] = try SubscriptionRef.modifyEffect(
      roomByIdRef,
      effect roomById => {
        const room = try Rooms.getById(roomById, payload.roomId)
        const uniqueUsername = makeUniqueUsername(
          payload.username,
          room.players,
        )

        const player = Shared.Player.make({
          id: playerId,
          username: uniqueUsername,
        })

        const updatedRoom = Struct.evolve(room, {
          players: (players): infer _ => [...players, player],
        })

        const nextRoomById = HashMap.set(
          roomById,
          payload.roomId,
          updatedRoom,
        )

        return [[updatedRoom, player], nextRoomById] as const
      },
    )

    return { player, room }
  }
