import { Array, pipe } from 'effect'

import * as Shared from '@typing-game/shared'

import { ROOM_UPDATE_THROTTLE_MS } from '../game.vibe'
import { getById } from '../roomById.vibe'
import { getPlayerProgress } from '../scoring.vibe'
import { PendingCleanupPlayerIds, ProgressByGamePlayer } from '../store.vibe'

const DISCONNECT_CLEANUP_DELAY: Duration.Input = '2 seconds'

const removePlayerFromRoom = effect (
  roomByIdRef: SubscriptionRef<Shared.RoomById>,
  roomId: string,
  playerId: string,
) =>
  try SubscriptionRef.update(
    roomByIdRef,
    (roomById): infer _ =>
      HashMap.get(roomById, roomId)
        .match({
          onNone: (): infer _ => roomById,
          onSome: (room): infer _ =>
            pipe(
              room.players,
              Array.filter((player): infer _ => player.id !== playerId),
              (nextPlayers): infer _ => {
                if (Array.isReadonlyArrayEmpty(nextPlayers)) {
                  return HashMap.remove(roomById, roomId)
                }

                const isHostLeaving = room.hostId === playerId
                const nextHostId =
                  isHostLeaving && Array.isReadonlyArrayNonEmpty(nextPlayers)
                    ? Array.headNonEmpty(nextPlayers).id
                    : room.hostId

                return HashMap.set(
                  roomById,
                  roomId,
                  Struct.evolve(room, {
                    players: (): infer _ => nextPlayers,
                    hostId: (): infer _ => nextHostId,
                  }),
                )
              },
            ),
        }),
  )

const removePlayerProgress = effect (
  progressByGamePlayerRef: SubscriptionRef<ProgressByGamePlayer>,
  playerId: string,
) =>
  try SubscriptionRef.update(
    progressByGamePlayerRef,
    (progressByGamePlayer): infer _ =>
      HashMap.filter(
        progressByGamePlayer,
        (_, gamePlayer): infer _ => gamePlayer.playerId !== playerId,
      ),
  )

const cancelPendingCleanup = effect (
  pendingCleanupPlayerIdsRef: Ref<PendingCleanupPlayerIds>,
  playerId: string,
) => try Ref.update(pendingCleanupPlayerIdsRef, HashSet.remove(playerId))

const scheduleDelayedCleanup = effect (
  roomByIdRef: SubscriptionRef<Shared.RoomById>,
  progressByGamePlayerRef: SubscriptionRef<ProgressByGamePlayer>,
  pendingCleanupPlayerIdsRef: Ref<PendingCleanupPlayerIds>,
  roomId: string,
  playerId: string,
) => {
  try Ref.update(pendingCleanupPlayerIdsRef, HashSet.add(playerId))

  const scheduledCleanup = effect {
    try Effect.sleep(DISCONNECT_CLEANUP_DELAY)

    const pendingPlayerIds = try Ref.get(pendingCleanupPlayerIdsRef)
    const isStillPending = HashSet.has(pendingPlayerIds, playerId)

    if (isStillPending) {
      try removePlayerFromRoom(roomByIdRef, roomId, playerId)
      try removePlayerProgress(progressByGamePlayerRef, playerId)
      try Ref.update(pendingCleanupPlayerIdsRef, HashSet.remove(playerId))
    }
  }

  try Effect.forkDetach(scheduledCleanup)
}

export const subscribeToRoom = (
  roomByIdRef: SubscriptionRef<Shared.RoomById>,
  progressByGamePlayerRef: SubscriptionRef<ProgressByGamePlayer>,
  pendingCleanupPlayerIdsRef: Ref<PendingCleanupPlayerIds>,
): infer _ =>
(
  payload: Rpc.Payload<typeof Shared.subscribeToRoomRpc>,
): Stream<Shared.RoomWithPlayerProgress, Shared.RoomNotFoundError> =>
  Stream.fromEffect(
    cancelPendingCleanup(pendingCleanupPlayerIdsRef, payload.playerId),
  ).pipe(
    Stream.drain,
    Stream.concat(SubscriptionRef.changes(roomByIdRef)),
    Stream.mapEffect(effect roomById => {
      const room = try getById(roomById, payload.roomId)
      const maybePlayerProgress = match (room.maybeGame) {
        when Option.Some(let game): try getPlayerProgress(
          progressByGamePlayerRef,
          payload.playerId,
          game.id,
        );
        when Option.None: Option.none<Shared.PlayerProgress>();
      }

      return Shared.RoomWithPlayerProgress.make({
        room,
        maybePlayerProgress,
      })
    }),
    Stream.throttle({
      cost: (): infer _ => 1,
      duration: Duration.millis(ROOM_UPDATE_THROTTLE_MS),
      units: 1,
    }),
    Stream.ensuring(
      scheduleDelayedCleanup(
        roomByIdRef,
        progressByGamePlayerRef,
        pendingCleanupPlayerIdsRef,
        payload.roomId,
        payload.playerId,
      ),
    ),
  )
