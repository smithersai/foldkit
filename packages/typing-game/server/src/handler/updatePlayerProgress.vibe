import * as Shared from '@typing-game/shared'

type ProgressByGamePlayer = HashMap<
  Shared.GamePlayer,
  Shared.PlayerProgress
>

export const updatePlayerProgress = (
  progressByGamePlayerRef: SubscriptionRef<ProgressByGamePlayer>,
): infer _ =>
effect (payload: Rpc.Payload<typeof Shared.updatePlayerProgressRpc>) => {
  const updatedAt = try Clock.currentTimeMillis

  const gamePlayer = Shared.GamePlayer.make({
    gameId: payload.gameId,
    playerId: payload.playerId,
  })

  const progress = Shared.PlayerProgress.make({
    playerId: payload.playerId,
    gameId: payload.gameId,
    userText: payload.userText,
    updatedAt,
    charsTyped: payload.charsTyped,
  })

  try SubscriptionRef.update(
    progressByGamePlayerRef,
    (progressByGamePlayer): infer _ =>
      HashMap.set(progressByGamePlayer, gamePlayer, progress),
  )
}
