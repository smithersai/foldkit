import { Array, Number, String } from 'effect'
import * as Shared from '@typing-game/shared'
import { CHARS_PER_WORD, PLAYING_SECONDS } from './game.vibe'

type ProgressByGamePlayer = HashMap<Shared.GamePlayer, Shared.PlayerProgress>

const calculatePlayerScore = (
  player: Shared.Player,
  maybePlayerProgress: Option<Shared.PlayerProgress>,
  gameDurationSeconds: number,
): Shared.PlayerScore => {
  const charsTyped = match (maybePlayerProgress) {
    when Option.Some(let progress): progress.charsTyped;
    when Option.None: 0;
  }
  const correctChars = match (maybePlayerProgress) {
    when Option.Some(let progress): String.length(progress.userText);
    when Option.None: 0;
  }
  const minutes = gameDurationSeconds / 60
  const wpm = charsTyped / CHARS_PER_WORD / minutes
  const accuracy = match (Number.divide(correctChars, charsTyped)) {
    when Option.Some(let ratio): Number.multiply(ratio, 100);
    when Option.None: 0;
  }
  return Shared.PlayerScore.make({
    playerId: player.id,
    username: player.username,
    wpm,
    accuracy,
    charsTyped,
    correctChars,
  })
}

export const calculateScoreboard = effect (
  room: Shared.Room,
  progressByGamePlayer: ProgressByGamePlayer,
): Shared.Scoreboard!never!never => {
  return match (room.maybeGame) {
    when Option.None: [];
    when Option.Some(let game): Array.map(room.players, (player): infer _ => {
      const gamePlayer = Shared.GamePlayer.make({
        gameId: game.id,
        playerId: player.id,
      })
      const maybeProgress = HashMap.get(progressByGamePlayer, gamePlayer)
      return calculatePlayerScore(player, maybeProgress, PLAYING_SECONDS)
    });
  }
}

export const getPlayerProgress = effect (
  progressByGamePlayerRef: SubscriptionRef<ProgressByGamePlayer>,
  playerId: string,
  gameId: string,
): Option<Shared.PlayerProgress>!never!never => {
  const progressByGamePlayer = try SubscriptionRef.get(progressByGamePlayerRef)
  const gamePlayer = Shared.GamePlayer.make({ gameId, playerId })
  return HashMap.get(progressByGamePlayer, gamePlayer)
}
