  model: Model,
): Option<Record<string, string>> =>
  do {
    const nativeMatchInput23 = model.dragState
    const nativeMatchResult23 = match (nativeMatchInput23) {
      when ({ _tag: 'Dragging' }) and let nativeMatched23_0: Option.some(
        ((dragging: typeof nativeMatched23_0): infer _ => ({
          position: 'fixed',
          top: '0',
          left: '0',
          transform: ghostTransform(
            dragging.current.clientX,
            dragging.current.clientY,
          ),
          'pointer-events': 'none',
          'z-index': '9999',
        }))(nativeMatched23_0),
      );
      default: Option.none();
    }
    nativeMatchResult23
  }

/** Returns true when the component is actively dragging (pointer or keyboard). */
export const isDragging = ({ dragState: { _tag } }: Model): boolean =>
  _tag === 'Dragging' || _tag === 'KeyboardDragging'

/** Returns the ID of the item currently being dragged or pending, if any. */
