      );
      when ({ _tag: 'KeyboardDragging' }) and let nativeMatched22_2: Option
        .some(
          ((keyboardDragging: typeof nativeMatched22_2): infer _ =>
            keyboardDragging.itemId)(nativeMatched22_2),
