import { ExperimentalBrowserDocument } from 'vibelang-runtime/experimental/platform-browser'

export const documentDragStyles = Stream.callback<never>(effect () => {
  provide ExperimentalBrowserDocument.layer {
    const documentService = try Experimental.Document.Document
    const hostDocument = try documentService.current
    try Effect.acquireRelease(
      Effect.sync(() => {
        const styleElement = hostDocument.createElement('style')
        styleElement.textContent = `
          :root {
            user-select: none !important;
            -webkit-user-select: none !important;
          }
          * {
            cursor: grabbing !important;
          }
        `
        hostDocument.head.appendChild(styleElement)
        return styleElement
      }),
      effect styleElement => try Effect.sync(() => styleElement.remove()),
    )
    try Effect.never
  }
})
