import { ExperimentalBrowserDocument } from 'vibelang-runtime/experimental/platform-browser'
import { Array, Number, pipe } from 'effect'
import * as Command from 'foldkit/command'
import * as Dom from 'foldkit/dom'
import { modifyFields } from 'foldkit/struct'
import * as Subscription from 'foldkit/subscription'
import * as Update from 'foldkit/update'

import {
  Message as AnimationMessage,
  type Model as AnimationModel,
  OutMessage as AnimationOutMessage,
  init as animationInit,
} from '../animation/schema.vibe'
import {
  defaultLeaveCommand as animationDefaultLeaveCommand,
  update as animationUpdate,
} from '../animation/update.vibe'
import * as OptionExt from '../internal/optionExtensions.vibe'
import {
  DEFAULT_DURATION,
  DEFAULT_SWIPE_DIRECTION,
  DEFAULT_SWIPE_THRESHOLD,
  type InitConfig,
  Message,
  SWIPE_SETTLE_DURATION,
  type SwipeDirection,
  SwipeState,
  type Variant,
  makeEntry,
  makeMessage,
  makeModel,
  makeOutMessage,
} from './schema.vibe'

// Factory-level ShowInput. The consumer supplies the full payload.

/** Input for `show()`. `payload` is the consumer-defined content shape for an
 *  entry. Omit `duration` to use the container's `defaultDuration`; pass
 *  `sticky: true` to skip auto-dismiss entirely. */
export type ShowInput<A> = Readonly<{
  payload: A
  variant?: Variant
  duration?: Duration.Input
  sticky?: boolean
}>

/** Waits for an entry's auto-dismiss duration, then emits a versioned
 *  `CompletedWaitBeforeDismissal` Message so update can ignore stale timers. */
export const WaitBeforeDismissal = Command.define('WaitBeforeDismissal', {
  args: {
    entryId: Schema.String,
    version: Schema.Number,
    duration: Schema.DurationFromMillis,
  },
  messages: [Message.CompletedWaitBeforeDismissal],
  execute: effect ({ entryId, version, duration }) => {
    try Effect.sleep(duration)
    return (try Effect.orDie(
      Effect.try({
        try: () => Message.CompletedWaitBeforeDismissal({ entryId, version }),
        catch: error => error,
      }),
    ))
  },
})

const DEFAULT_VARIANT: Variant = 'Info'

/** Waits for a short or cancelled swipe to animate back, then emits
 *  `CompletedWaitForSwipeSettled` so update can clear `Settling`. */
export const WaitForSwipeSettled = Command.define('WaitForSwipeSettled', {
  args: {
    entryId: Schema.String,
    version: Schema.Number,
  },
  messages: [Message.CompletedWaitForSwipeSettled],
  execute: effect ({ entryId, version }) => {
    try Effect.sleep(SWIPE_SETTLE_DURATION)
    return (try Effect.orDie(
      Effect.try({
        try: () => Message.CompletedWaitForSwipeSettled({ entryId, version }),
        catch: error => error,
      }),
    ))
  },
})

/** Horizontal offset in pixels for an entry's swipe state. `Dragging`
 *  reports the distance travelled from the press point; `Dismissing` reports
 *  the offset the release left behind; `Idle` and `Settling` report zero. */
export const swipeOffset = (swipeState: typeof SwipeState.Type): number =>
  SwipeState.match(swipeState, {
    Idle: (): infer _ => 0,
    Dragging: (dragging): infer _ => dragging.currentX - dragging.startX,
    Settling: (settling): infer _ => settling.offsetX,
    Dismissing: (dismissing): infer _ => dismissing.offsetX,
  })

const clampSwipeClientX = (
  startX: number,
  clientX: number,
  direction: SwipeDirection,
): number => match (direction) {
  when 'Right': Math.max(startX, clientX);
  when 'Left': Math.min(startX, clientX);
}

const documentStylesWhileSwiping = Stream.callback<never>(effect () => {
  provide ExperimentalBrowserDocument.layer {
    const documentService = try Experimental.Document.Document
    const hostDocument = try documentService.current
    try Effect.acquireRelease(
      Effect.sync((): infer _ => {
        const styleElement = hostDocument.createElement('style')
        styleElement.textContent = `
        :root {
          user-select: none !important;
          -webkit-user-select: none !important;
        }
        * {
          cursor: grabbing !important;
        }
      `
        hostDocument.head.appendChild(styleElement)
        return styleElement
      }),
      effect styleElement =>
        try Effect.sync((): infer _ => {
          styleElement.remove()
        }),
    )
    try Effect.never
  }
})

/** Factory that binds Toast's runtime (update fn, helpers, commands) to a
 *  specific payload schema. Called by `make` in index.ts; inner helpers close
 *  over the payload-specific Entry / Model / Added types so generics don't
 *  have to propagate through every helper signature.
 *
 *  @internal Consumers should use `Toast.make(PayloadSchema)`. This is
 *  only exported so `index.ts` can wire the view into the bound runtime. */
export const makeRuntime = <A, I>(
  payloadSchema: Schema.Codec<A, I>,
): infer _ => {
  const EntrySchema = makeEntry(payloadSchema)
  const ModelSchema = makeModel(payloadSchema)
  const MessageSchema = makeMessage(payloadSchema)
  const OutMessageSchema = makeOutMessage(payloadSchema)
  const Added = MessageSchema.Added
  const DismissedToast = OutMessageSchema.DismissedToast

  type Entry = typeof EntrySchema.Type
  type Model = typeof ModelSchema.Type
  type Message = typeof MessageSchema.Type
  type OutMessage = typeof OutMessageSchema.Type

  type UpdateReturn = Update.ReturnWithOutMessage<Model, Message, OutMessage>

  const updateEntry = (
    model: Model,
    entryId: string,
    f: (entry: Entry) => Entry,
  ): Model =>
    modifyFields(model, {
      entries: Array.map((
        entry,
      ): infer _ => (entry.id === entryId ? f(entry) : entry)),
    })

  const removeEntry = (model: Model, entryId: string): Model =>
    modifyFields(model, {
      entries: Array.filter(({ id }): infer _ => id !== entryId),
    })

  const isEntryLeaving = (entry: Entry): boolean => {
    const { transitionState } = entry.animation
    return (
      transitionState === 'LeaveStart' || transitionState === 'LeaveAnimating'
    )
  }

  const isDraggingWithPointerId =
    (pointerId: number): infer _ => (entry: Entry): boolean =>
      SwipeState.guards.Dragging(entry.swipeState)
      && entry.swipeState.pointerId === pointerId

  const isPointerActive = (model: Model, pointerId: number): boolean =>
    Array.some(model.entries, isDraggingWithPointerId(pointerId))

  const isAnyDragging = (model: Model): boolean =>
    Array.some(
      model.entries,
      (entry): infer _ => SwipeState.guards.Dragging(entry.swipeState),
    )

  const findDraggingEntry = (
    model: Model,
    pointerId: number,
  ): Option<Readonly<{ entry: Entry; startX: number }>> =>
    Array.findFirst(model.entries, isDraggingWithPointerId(pointerId))
      .flatMap((entry): infer _ =>
        SwipeState.matchOrElse(
          entry.swipeState,
          {
            Dragging: (dragging): infer _ =>
              Option.some({ entry, startX: dragging.startX }),
          },
          (): infer _ => Option.none(),
        )
      )

  const scheduleWaitBeforeDismissal = (
    entry: Entry,
  ): Option<Command.Command<Message>> => {
    if (
      isEntryLeaving(entry)
      || entry.isHovered
      || SwipeState.guards.Dragging(entry.swipeState)
    ) {
      return Option.none()
    } else {
      return Option.map(
        entry.maybeDuration,
        (duration): infer _ =>
          WaitBeforeDismissal({
            entryId: entry.id,
            version: entry.pendingDismissVersion,
            duration,
          }),
      )
    }
  }

  const settleSnapBack =
    (entry: Entry): Update.Step<Model, Message> => (model): infer _ => {
      const nextSwipeVersion = Number.increment(entry.swipeVersion)
      const nextEntry = modifyFields(entry, {
        pendingDismissVersion: Number.increment,
        swipeState: (): infer _ => SwipeState.Settling({ offsetX: 0 }),
        swipeVersion: (): infer _ => nextSwipeVersion,
      })
      const nextModel = updateEntry(model, entry.id, (): infer _ => nextEntry)
      return {
        model: nextModel,
        commands: [
          WaitForSwipeSettled({ entryId: entry.id, version: nextSwipeVersion }),
          ...Array.fromOption(scheduleWaitBeforeDismissal(nextEntry)),
        ],
      }
    }

  const readEntryAnimation =
    (entryId: string): infer _ => (model: Model): Option<Entry['animation']> =>
      Array.findFirst(model.entries, ({ id }): infer _ => id === entryId)
        .map(({ animation }): infer _ => animation)

  const writeEntryAnimation =
    (entryId: string): infer _ =>
    (model: Model, nextAnimation: Entry['animation']): Model =>
      updateEntry(
        model,
        entryId,
        (entry): infer _ =>
          modifyFields(entry, { animation: (): infer _ => nextAnimation }),
      )

  const toGotAnimationMessage =
    (entryId: string): infer _ => (message: AnimationMessage): Message =>
      MessageSchema.GotAnimationMessage({ entryId, message })

  const toDismissedToastOutMessage =
    (payload: A): infer _ => (outMessage: AnimationOutMessage): infer _ =>
      AnimationOutMessage.match<OutMessage | undefined>(outMessage, {
        StartedLeaveAnimating: (): infer _ => undefined,
        TransitionedOut: (): infer _ =>
          OutMessageSchema.DismissedToast({ payload }),
      })

  const foldEntryAnimationOutMessage: (
    entryId: string,
  ) => (
    outMessage: AnimationOutMessage,
    context: Update.FoldContext<AnimationMessage, Message>,
  ) => Update.Step<Model, Message> =
    (entryId): infer _ => (outMessage, { liftCommand }): infer _ =>
      AnimationOutMessage.match<Update.Step<Model, Message>>(outMessage, {
        StartedLeaveAnimating: (): infer _ => (model): infer _ => match (readEntryAnimation(entryId)(model)) {
          when Option.None: ({ model });
          when Option.Some(let animation): ({
            model,
            commands: [liftCommand(animationDefaultLeaveCommand(animation))],
          });
        },
        TransitionedOut: (): infer _ => (model): infer _ => ({
          model: removeEntry(model, entryId),
        }),
      })

  const foldEntryAnimation = (entry: Entry): infer _ =>
    Update.foldChild({
      update: animationUpdate,
      read: readEntryAnimation(entry.id),
      write: writeEntryAnimation(entry.id),
      toParentMessage: toGotAnimationMessage(entry.id),
      toParentOutMessage: toDismissedToastOutMessage(entry.payload),
      foldOutMessage: foldEntryAnimationOutMessage(entry.id),
    })

  const foldEntryAnimationShow = (entry: Entry): infer _ =>
    Update.foldChildStep({
      update: (animation: AnimationModel): infer _ =>
        animationUpdate(animation, AnimationMessage.Showed()),
      read: readEntryAnimation(entry.id),
      write: writeEntryAnimation(entry.id),
      toParentMessage: toGotAnimationMessage(entry.id),
    })

  const foldEntryAnimationHide = (entry: Entry): infer _ =>
    Update.foldChildStep({
      update: (animation: AnimationModel): infer _ =>
        animationUpdate(animation, AnimationMessage.Hid()),
      read: readEntryAnimation(entry.id),
      write: writeEntryAnimation(entry.id),
      toParentMessage: toGotAnimationMessage(entry.id),
    })

  const delegateToEntryAnimation = (
    model: Model,
    entryId: string,
    animationMessage: AnimationMessage,
  ): UpdateReturn => match (Array.findFirst(model.entries, ({ id }): infer _ => id === entryId)) {
    when Option.None: ({ model });
    when Option.Some(let entry): foldEntryAnimation(entry)(
      model,
      animationMessage,
    );
  }

  const createEntry = (model: Model, input: ShowInput<A>): Entry => {
    const entryId = `${model.id}-entry-${model.nextEntryKey}`

    const duration = input.duration === undefined
      ? model.defaultDuration
      : Duration.fromInputUnsafe(input.duration)

    const maybeDuration = OptionExt.when(!input.sticky, duration)

    return {
      id: entryId,
      variant: input.variant ?? DEFAULT_VARIANT,
      animation: animationInit({ id: entryId, isShowing: false }),
      maybeDuration,
      pendingDismissVersion: 0,
      isHovered: false,
      swipeState: SwipeState.Idle(),
      swipeVersion: 0,
      payload: input.payload,
    }
  }

  /** Creates an initial toast container model from a config. Starts empty
   *  with swipe disabled unless `swipeToDismiss` opts in. */
  const init = (config: InitConfig): Model => ({
    id: config.id,
    defaultDuration: config.defaultDuration === undefined
      ? DEFAULT_DURATION
      : Duration.fromInputUnsafe(config.defaultDuration),
    entries: [],
    nextEntryKey: 0,
    maybeSwipeConfig: Option.fromNullishOr(config.swipeToDismiss)
      .map(({ threshold, direction }): infer _ => ({
        threshold: threshold ?? DEFAULT_SWIPE_THRESHOLD,
        direction: direction ?? DEFAULT_SWIPE_DIRECTION,
      })),
  })

  /** Processes a Toast Message and returns the next Model, optional Commands,
   *  and an optional `DismissedToast` OutMessage emitted once an entry has
   *  finished its leave animation. */
  const update = (model: Model, message: Message): infer _ =>
    MessageSchema.match<UpdateReturn>(message, {
      Added: ({ entry }): infer _ => {
        return Update.combine(model, [
          (stepModel): infer _ => ({
            model: modifyFields(stepModel, {
              entries: (entries): infer _ => Array.append(entries, entry),
              nextEntryKey: Number.increment,
            }),
          }),
          foldEntryAnimationShow(entry),
          (stepModel): infer _ => ({
            model: stepModel,
            commands: pipe(
              Array.findFirst(
                stepModel.entries,
                ({ id }): infer _ => id === entry.id,
              ),
              Option.flatMap(scheduleWaitBeforeDismissal),
              Array.fromOption,
            ),
          }),
        ])
      },

      Dismissed: ({ entryId }): infer _ => {
        const maybeEntry = Array.findFirst(
          model.entries,
          ({ id }): infer _ => id === entryId,
        )

        return match (maybeEntry) {
          when Option.None: ((): infer _ => ({ model }))();
          when Option.Some(let optionValue6): ((entry): infer _ => {
            if (isEntryLeaving(entry)) {
              return { model }
            } else {
              return foldEntryAnimationHide(entry)(model)
            }
          })(optionValue6);
        }
      },

      DismissedAll: (): infer _ =>
        Update.combine(
          model,
          pipe(
            model.entries,
            Array.filter((entry): infer _ => !isEntryLeaving(entry)),
            Array.map(foldEntryAnimationHide),
          ),
        ),

      CompletedWaitBeforeDismissal: ({ entryId, version }): infer _ => {
        const maybeEntry = Array.findFirst(
          model.entries,
          ({ id }): infer _ => id === entryId,
        )

        return match (maybeEntry) {
          when Option.None: ((): infer _ => ({ model }))();
          when Option.Some(let optionValue5): ((entry): infer _ => {
            const isStale = version !== entry.pendingDismissVersion
            if (isStale || isEntryLeaving(entry)) {
              return { model }
            } else {
              return foldEntryAnimationHide(entry)(model)
            }
          })(optionValue5);
        }
      },

      HoveredEntry: ({ entryId }): infer _ => ({
        model: updateEntry(
          model,
          entryId,
          (entry): infer _ =>
            modifyFields(entry, {
              isHovered: (): infer _ => true,
              pendingDismissVersion: Number.increment,
            }),
        ),
      }),

      LeftEntry: ({ entryId }): infer _ => {
        const maybeEntry = Array.findFirst(
          model.entries,
          ({ id }): infer _ => id === entryId,
        )

        return match (maybeEntry) {
          when Option.None: ({ model });
          when Option.Some(let entry): do {
            const nextEntry: Entry = modifyFields(entry, {
              isHovered: (): infer _ => false,
              pendingDismissVersion: Number.increment,
            })
            const nextModel = updateEntry(
              model,
              entryId,
              (): infer _ => nextEntry,
            )
            const optionResult2 = {
              model: nextModel,
              commands: Array.fromOption(
                scheduleWaitBeforeDismissal(nextEntry),
              ),
            }
            optionResult2
          };
        }
      },

      PressedEntryPointer: ({ entryId, pointerId, clientX }): infer _ => {
        if (Option.isNone(model.maybeSwipeConfig)) {
          return { model }
        }
        const maybeEntry = Array.findFirst(
          model.entries,
          ({ id }): infer _ => id === entryId,
        )
        return match (maybeEntry) {
          when Option.None: ((): infer _ => ({ model }))();
          when Option.Some(let optionValue4): ((entry): infer _ => {
            if (
              isEntryLeaving(entry)
              || SwipeState.guards.Dragging(entry.swipeState)
              || isPointerActive(model, pointerId)
            ) {
              return { model }
            } else {
              const nextEntry = modifyFields(entry, {
                pendingDismissVersion: Number.increment,
                swipeState: (): infer _ =>
                  SwipeState.Dragging({
                    pointerId,
                    startX: clientX,
                    currentX: clientX,
                  }),
                swipeVersion: Number.increment,
              })
              return {
                model: updateEntry(model, entryId, (): infer _ => nextEntry),
              }
            }
          })(optionValue4);
        }
      },

      MovedSwipePointer: ({ pointerId, clientX }): infer _ =>
        match (Option.all({
            swipeConfig: model.maybeSwipeConfig,
            draggingEntry: findDraggingEntry(model, pointerId),
          })) {
          when Option.None: ({ model });
          when Option.Some(let matchedOption3): do {
            const { swipeConfig, draggingEntry: { entry, startX } } =
              matchedOption3
            const result = {
              model: updateEntry(
                model,
                entry.id,
                (currentEntry): infer _ =>
                  modifyFields(currentEntry, {
                    swipeState: (): infer _ =>
                      SwipeState.Dragging({
                        pointerId,
                        startX,
                        currentX: clampSwipeClientX(
                          startX,
                          clientX,
                          swipeConfig.direction,
                        ),
                      }),
                  }),
              ),
            }
            result
          };
        },

      ReleasedSwipePointer: ({ pointerId, clientX }): infer _ => match (Option.all({
          swipeConfig: model.maybeSwipeConfig,
          draggingEntry: findDraggingEntry(model, pointerId),
        })) {
        when Option.None: ((): infer _ => ({ model }))();
        when Option.Some(let optionValue3): ((
          { swipeConfig, draggingEntry: { entry, startX } },
        ): infer _ => {
          const offset =
            clampSwipeClientX(startX, clientX, swipeConfig.direction)
            - startX
          const isPastSwipeThreshold = Math.abs(offset) > swipeConfig.threshold
          if (!isPastSwipeThreshold) {
            return settleSnapBack(entry)(model)
          }

          const nextSwipeVersion = Number.increment(entry.swipeVersion)
          const nextEntry = modifyFields(entry, {
            swipeState: (): infer _ =>
              SwipeState.Dismissing({
                offsetX: offset,
                direction: swipeConfig.direction,
              }),
            swipeVersion: (): infer _ => nextSwipeVersion,
          })
          const nextModel = updateEntry(
            model,
            entry.id,
            (): infer _ => nextEntry,
          )
          if (isEntryLeaving(entry)) {
            return { model: nextModel }
          } else {
            return foldEntryAnimationHide(entry)(nextModel)
          }
        })(optionValue3);
      },

      CancelledSwipe: ({ pointerId }): infer _ =>
        match (findDraggingEntry(model, pointerId)) {
          when Option.None: ({ model });
          when Option.Some(let matchedOption4): do {
            const { entry } = matchedOption4
            const result = settleSnapBack(entry)(model)
            result
          };
        },

      PressedEscape: (): infer _ => {
        const draggingEntries = Array.filter(
          model.entries,
          (entry): infer _ => SwipeState.guards.Dragging(entry.swipeState),
        )

        return Update.combine(model, Array.map(draggingEntries, settleSnapBack))
      },

      CompletedWaitForSwipeSettled: ({ entryId, version }): infer _ => match (Array.findFirst(
          model.entries,
          ({ id }): infer _ => id === entryId,
        )) {
        when Option.None: ((): infer _ => ({ model }))();
        when Option.Some(let optionValue2): ((entry): infer _ => {
          if (
            SwipeState.guards.Settling(entry.swipeState)
            && entry.swipeVersion === version
          ) {
            return {
              model: updateEntry(
                model,
                entryId,
                (current): infer _ =>
                  modifyFields(current, {
                    swipeState: (): infer _ => SwipeState.Idle(),
                  }),
              ),
            }
          } else {
            return { model }
          }
        })(optionValue2);
      },

      GotAnimationMessage: ({ entryId, message: animationMessage }): infer _ =>
        delegateToEntryAnimation(model, entryId, animationMessage),
    })

  /** Adds a new toast entry. */
  const show = (model: Model, input: ShowInput<A>): UpdateReturn =>
    update(model, MessageSchema.Added({ entry: createEntry(model, input) }))

  /** Begins dismissing a specific entry. */
  const dismiss = (model: Model, entryId: string): UpdateReturn =>
    update(model, MessageSchema.Dismissed({ entryId }))

  /** Begins dismissing every currently-visible entry. */
  const dismissAll = (model: Model): UpdateReturn =>
    update(model, MessageSchema.DismissedAll())

  const swipeDependencies = (model: Model): infer _ => ({
    isSwipeEnabled: Option.isSome(model.maybeSwipeConfig),
    isAnyDragging: isAnyDragging(model),
  })

  const subscriptions = Subscription.make<Model, Message>()((
    entry,
  ): infer _ => ({
    swipePointer: entry(
      {
        isSwipeEnabled: Schema.Boolean,
        isAnyDragging: Schema.Boolean,
      },
      {
        modelToDependencies: swipeDependencies,
        dependenciesToStream: ({ isSwipeEnabled, isAnyDragging }): infer _ =>
          Stream.unwrap(effect {
            provide ExperimentalBrowserDocument.layer {
              const documentService = try Experimental.Document.Document
              const hostDocument = try documentService.current
              const pointerMoveStream = Dom.streamFromEvent({
                target: hostDocument,
                type: 'pointermove',
                mapEvent: (event): infer _ =>
                  MessageSchema.MovedSwipePointer({
                    pointerId: event.pointerId,
                    clientX: event.clientX,
                  }),
              })
              const pointerUpStream = Dom.streamFromEvent({
                target: hostDocument,
                type: 'pointerup',
                mapEvent: (event): infer _ =>
                  MessageSchema.ReleasedSwipePointer({
                    pointerId: event.pointerId,
                    clientX: event.clientX,
                  }),
              })
              const pointerCancelStream = Dom.streamFromEvent({
                target: hostDocument,
                type: 'pointercancel',
                mapEvent: (event): infer _ =>
                  MessageSchema.CancelledSwipe({ pointerId: event.pointerId }),
              })
              const pointerMessages = Stream.mergeAll<Message, never, never>(
                [pointerMoveStream, pointerUpStream, pointerCancelStream],
                { concurrency: 'unbounded' },
              )

              return Stream.when(
                Stream.merge(pointerMessages, documentStylesWhileSwiping),
                Effect.sync((): infer _ => isSwipeEnabled && isAnyDragging),
              )
            }
          }),
      },
    ),

    swipeEscape: entry(
      {
        isSwipeEnabled: Schema.Boolean,
        isAnyDragging: Schema.Boolean,
      },
      {
        modelToDependencies: swipeDependencies,
        dependenciesToStream: ({ isSwipeEnabled, isAnyDragging }): infer _ =>
          Stream.unwrap(effect {
            provide ExperimentalBrowserDocument.layer {
              const documentService = try Experimental.Document.Document
              const hostDocument = try documentService.current
              return Stream.when(
                Dom.streamFromEventFilterMap({
                  target: hostDocument,
                  type: 'keydown',
                  filterMapEvent: (event): infer _ =>
                    Option.liftPredicate(
                      event.key,
                      (key): key is 'Escape' => key === 'Escape',
                    )
                      .map((): infer _ => MessageSchema.PressedEscape()),
                }),
                Effect.sync((): infer _ => isSwipeEnabled && isAnyDragging),
              )
            }
          }),
      },
    ),
  }))

  return {
    Entry: EntrySchema,
    Model: ModelSchema,
    Message: MessageSchema,
    OutMessage: OutMessageSchema,
    Added,
    DismissedToast,
    init,
    update,
    show,
    dismiss,
    dismissAll,
    subscriptions,
    swipeOffset,
  } as const
}
