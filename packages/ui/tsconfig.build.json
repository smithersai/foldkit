{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "sourceMap": true,
    "inlineSources": true
  },
  "exclude": ["src/**/*.test.ts"],
  "vibe": {
    "severities": {
      "EK4842": "off"
    }
  }
}
