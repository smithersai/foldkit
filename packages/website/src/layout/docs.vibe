// PAGE NAVIGATION

type NavPage = Readonly<{ href: string; label: string }>

const neighborLink = (
  config: Readonly<{
    page: NavPage
    direction: 'Previous' | 'Next'
  }>,
  h: HtmlBuilder<Message>,
): infer _ =>
  h.a(
    [
      h.Href(config.page.href),
      h.Class(
        clsx('group flex flex-col gap-1', {
          'items-start text-left': config.direction === 'Previous',
          'items-end text-right ml-auto': config.direction === 'Next',
        }),
      ),
    ],
    [
      h.span(
        [
          h.Class(
            'text-xs font-medium text-gray-600 dark:text-gray-400 uppercase tracking-wider',
          ),
        ],
        [config.direction],
      ),
      h.span(
        [
          h.Class(
            'text-sm font-medium text-accent-700 dark:text-accent-400 group-hover:underline',
          ),
        ],
        config.direction === 'Previous'
          ? [
            h.span([h.Class('mr-1'), h.AriaHidden(true)], ['←']),
            config.page.label,
          ]
          : [
            config.page.label,
            h.span([h.Class('ml-1'), h.AriaHidden(true)], ['→']),
          ],
      ),
    ],
  )

const pageNavigationView = (tag: string, h: HtmlBuilder<Message>): infer _ => {
  const { maybePrevious, maybeNext } = pageNeighbors(tag)

  if (Option.isNone(maybePrevious) && Option.isNone(maybeNext)) {
    return h.empty
  }

  return h.nav(
    [
      h.AriaLabel('Page navigation'),
      h.Class(
        'flex items-stretch justify-between gap-4 mt-12 pt-6 border-t border-gray-200 dark:border-gray-800',
      ),
    ],
    [
      match (maybePrevious) {
        when { _tag: "None" }: h.empty;
        when { _tag: "Some", value: let page }: neighborLink({
          page,
          direction: 'Previous',
        }, h);
      },
      match (maybeNext) {
        when { _tag: "None" }: h.empty;
        when { _tag: "Some", value: let page }: neighborLink({
          page,
          direction: 'Next',
        }, h);
      },
    ],
  )
}

// SEARCH WEIGHT

export const searchWeight = (tag: string): string => match (tag) {
  when let value and if (value.startsWith('Core')): '10';
  when 'GetStarted' or 'WhyFoldkit': '8';
  when let value and if (value.startsWith('Patterns') || value.startsWith('BestPractices') || value.startsWith('Tooling')):
    '7';
  when 'RoutingAndNavigation' or 'FieldValidation' or 'ProjectOrganization' or 'ComingFromReact' or 'ComingFromTanStackQuery' or 'ReactComparison' or 'EffectAtomComparison' or 'ElmComparison' or 'Performance' or 'Roadmap':
    '6';
  when let value and if (value.startsWith('Testing')): '6';
  when let value and if (value.startsWith('Ui') || value.startsWith('Ai')): '5';
  when 'ApiModule': '3';
  when 'Examples' or 'ExampleDetail' or 'TypingTerminal': '2';
  default: '4';
}

// CONTENT WIDTH

const isWideContentRoute = AppRoute.isAnyOf(['Examples', 'ExampleDetail'])

// CONTENT ROUTING

type DocsPageView = Readonly<{
  content: Html
  tableOfContents: Option<ReadonlyArray<TableOfContentsEntry>>
}>

const withTableOfContents = (
  content: Html,
  tableOfContents: ReadonlyArray<TableOfContentsEntry>,
): DocsPageView => ({
  content,
  tableOfContents: Option.some(tableOfContents),
})

const withoutTableOfContents = (content: Html): DocsPageView => ({
  content,
  tableOfContents: Option.none(),
})

const toApiReferenceMessage = (message: ApiReference.Message): Message =>
  Message.GotApiReferenceMessage({ message })

const toUiPageMessage = (message: Ui.Message): Message =>
  Message.GotUiPageMessage({ message })

const renderApiReference = (
  apiReference: ApiReference.Model,
  module: ApiReference.ApiModule,
  highlights: ApiReference.ApiData['highlights'],
  h: HtmlBuilder<Message>,
): Html =>
  h.submodel({
    slotId: `api-reference-${module.name}`,
    model: apiReference,
    view: ApiReference.view,
    viewInputs: {
      module,
      highlights,
      renderHeadingLink: Prose.renderHeadingLink(
        (hash): infer _ => Message.ClickedCopyLink({ hash }),
        h,
      ),
    },
    toParentMessage: toApiReferenceMessage,
  })

type DocPageView = (
  renderCopyButton: CodeBlock.RenderCopyButton,
  renderSnippet: CodeBlock.RenderSnippet,
  renderHeadingLink: Prose.RenderHeadingLink,
) => Html

type ProseDocPageView = (renderHeadingLink: Prose.RenderHeadingLink) => Html

const renderDocContent = (
  pageView: DocPageView,
  snippetCopy: SnippetCopy.Model,
  snippetDisclosure: SnippetDisclosure.Model,
  h: HtmlBuilder<Message>,
): Html => {
  const renderCopyButton = SnippetCopy.renderer(
    snippetCopy,
    (message): infer _ => Message.GotSnippetCopyMessage({ message }),
    h,
  )

  return pageView(
    renderCopyButton,
    SnippetDisclosure.renderer(
      snippetDisclosure,
      (message): infer _ => Message.GotSnippetDisclosureMessage({ message }),
      renderCopyButton,
      h,
    ),
    Prose.renderHeadingLink(
      (hash): infer _ => Message.ClickedCopyLink({ hash }),
      h,
    ),
  )
}

const renderProseContent = (
  pageView: ProseDocPageView,
  h: HtmlBuilder<Message>,
): Html =>
  pageView(
    Prose.renderHeadingLink(
      (hash): infer _ => Message.ClickedCopyLink({ hash }),
      h,
    ),
  )

const memoizedDocContent = createLazy()
const memoizedProseContent = createLazy()

type DocContentArgs = readonly [
  SnippetCopy.Model,
  SnippetDisclosure.Model,
  HtmlBuilder<Message>,
]

const lazyDocsContent = (view: DocPageView, args: DocContentArgs): Html =>
  memoizedDocContent(renderDocContent, [view, ...args])

const lazyProseContent = (
  view: ProseDocPageView,
  args: readonly [HtmlBuilder<Message>],
): Html => memoizedProseContent(renderProseContent, [view, ...args])

const lazyApiReference = createLazy()
const lazyApiReferenceSkeleton = createLazy()

// VIEW

export const view = (
  model: Model,
  docsRoute: DocsRoute,
  h: HtmlBuilder<Message>,
): infer _ => {
  const renderCopyButton = SnippetCopy.renderer(
    model.snippetCopy,
    (message): infer _ => Message.GotSnippetCopyMessage({ message }),
    h,
  )
  const renderSnippet = SnippetDisclosure.renderer(
    model.snippetDisclosure,
    (message): infer _ => Message.GotSnippetDisclosureMessage({ message }),
    renderCopyButton,
    h,
  )
  const renderHeadingLink = Prose.renderHeadingLink(
    (hash): infer _ => Message.ClickedCopyLink({ hash }),
    h,
  )
  const docContentArgs: DocContentArgs = [
    model.snippetCopy,
    model.snippetDisclosure,
    h,
  ]

  const {
    content,
    tableOfContents: currentPageTableOfContents,
  }: DocsPageView = match (docsRoute) {
    when { _tag: "WhyFoldkit" }: withTableOfContents(
      WhyFoldkit.view(renderHeadingLink),
      WhyFoldkit.tableOfContents,
    );
    when { _tag: "Roadmap" }: withTableOfContents(
      Roadmap.view(renderHeadingLink),
      Roadmap.tableOfContents,
    );
    when { _tag: "Performance" }: withTableOfContents(
      Performance.view(renderHeadingLink),
      Performance.tableOfContents,
    );
    when { _tag: "ComingFromReact" }: withTableOfContents(
      h.submodel({
        slotId: 'coming-from-react',
        model: model.comingFromReact,
        view: ComingFromReact.view,
        viewInputs: { renderCopyButton, renderSnippet, renderHeadingLink },
        toParentMessage: (message): infer _ =>
          Message.GotComingFromReactMessage({ message }),
      }),
      ComingFromReact.tableOfContents,
    );
    when { _tag: "ComingFromTanStackQuery" }: withTableOfContents(
      lazyDocsContent(ComingFromTanStackQuery.view, docContentArgs),
      ComingFromTanStackQuery.tableOfContents,
    );
    when { _tag: "ReactComparison" }: withTableOfContents(
      lazyDocsContent(ReactComparison.view, docContentArgs),
      ReactComparison.tableOfContents,
    );
    when { _tag: "EffectAtomComparison" }: withTableOfContents(
      lazyDocsContent(EffectAtomComparison.view, docContentArgs),
      EffectAtomComparison.tableOfContents,
    );
    when { _tag: "ElmComparison" }: withTableOfContents(
      lazyDocsContent(ElmComparison.view, docContentArgs),
      ElmComparison.tableOfContents,
    );
    when { _tag: "GetStarted" }: withTableOfContents(
      lazyDocsContent(GetStarted.view, docContentArgs),
      GetStarted.tableOfContents,
    );
    when { _tag: "RoutingAndNavigation" }: withTableOfContents(
      lazyDocsContent(Routing.view, docContentArgs),
      Routing.tableOfContents,
    );
    when { _tag: "FieldValidation" }: withTableOfContents(
      lazyDocsContent(FieldValidation.view, docContentArgs),
      FieldValidation.tableOfContents,
    );
    when { _tag: "Testing" }: withTableOfContents(
      lazyDocsContent(Testing.view, docContentArgs),
      Testing.tableOfContents,
    );
    when { _tag: "TestingStory" }: withTableOfContents(
      lazyDocsContent(TestingStory.view, docContentArgs),
      TestingStory.tableOfContents,
    );
    when { _tag: "TestingScene" }: withTableOfContents(
      lazyDocsContent(TestingScene.view, docContentArgs),
      TestingScene.tableOfContents,
    );
    when { _tag: "Examples" }: withoutTableOfContents(Examples.view());
    when { _tag: "TypingTerminal" }: withTableOfContents(
      TypingTerminal.view(renderHeadingLink),
      TypingTerminal.tableOfContents,
    );
    when { _tag: "ExampleDetail", let exampleSlug }: withoutTableOfContents(
      h.submodel({
        slotId: `example-detail-${exampleSlug}`,
        model: model.exampleDetail,
        view: Example.ExampleDetail.view,
        viewInputs: {
          slug: exampleSlug,
          isNarrowViewport: model.isNarrowViewport,
          renderSnippet,
        },
        toParentMessage: (message): infer _ =>
          Message.GotExampleDetailMessage({ message }),
      }),
    );
    when { _tag: "BestPracticesSideEffects" }: withTableOfContents(
      lazyDocsContent(
        BestPractices.SideEffectsAndPurity.view,
        docContentArgs,
      ),
      BestPractices.SideEffectsAndPurity.tableOfContents,
    );
    when { _tag: "BestPracticesMessages" }: withTableOfContents(
      BestPractices.Messages.view(renderHeadingLink),
      BestPractices.Messages.tableOfContents,
    );
    when { _tag: "BestPracticesKeying" }: withTableOfContents(
      lazyDocsContent(BestPractices.Keying.view, docContentArgs),
      BestPractices.Keying.tableOfContents,
    );
    when { _tag: "BestPracticesImmutability" }: withTableOfContents(
      lazyDocsContent(BestPractices.Immutability.view, docContentArgs),
      BestPractices.Immutability.tableOfContents,
    );
    when { _tag: "ProjectOrganization" }: withTableOfContents(
      lazyDocsContent(ProjectOrganization.view, docContentArgs),
      ProjectOrganization.tableOfContents,
    );
    when { _tag: "ToolingLinting" }: withTableOfContents(
      lazyDocsContent(ToolingLinting.view, docContentArgs),
      ToolingLinting.tableOfContents,
    );
    when { _tag: "ApiModule", let moduleSlug }: AsyncData.matchData(
      model.apiReference.apiData,
      {
        onData: (data): infer _ => match (ApiReference.resolveModule(data.parsedApi, moduleSlug)) {
          when { _tag: "None" }: withoutTableOfContents(
            NotFound.view(moduleSlug, homeRouter()),
          );
          when { _tag: "Some", value: let module }: ({
            content: lazyApiReference(renderApiReference, [
              model.apiReference,
              module,
              data.highlights,
              h,
            ]),
            tableOfContents: Option.some(
              ApiReference.toModuleTableOfContents(module),
            ),
          });
        },
        onFailure: (error): infer _ =>
          withoutTableOfContents(ApiReference.failureView(error)),
        onEmpty: (): infer _ =>
          withoutTableOfContents(
            lazyApiReferenceSkeleton(ApiReference.skeletonView, []),
          ),
      },
    );
    when { _tag: "CoreArchitecture" }: withTableOfContents(
      Core.Architecture.view(renderHeadingLink),
      Core.Architecture.tableOfContents,
    );
    when { _tag: "CoreCounterExample" }: withTableOfContents(
      lazyDocsContent(Core.CounterExample.view, docContentArgs),
      Core.CounterExample.tableOfContents,
    );
    when { _tag: "CoreModel" }: withTableOfContents(
      lazyDocsContent(Core.CoreModel.view, docContentArgs),
      Core.CoreModel.tableOfContents,
    );
    when { _tag: "CoreMessages" }: withTableOfContents(
      lazyDocsContent(Core.Messages.view, docContentArgs),
      Core.Messages.tableOfContents,
    );
    when { _tag: "CoreUpdate" }: withTableOfContents(
      lazyDocsContent(Core.CoreUpdate.view, docContentArgs),
      Core.CoreUpdate.tableOfContents,
    );
    when { _tag: "CoreView" }: withTableOfContents(
      lazyDocsContent(Core.CoreView.view, docContentArgs),
      Core.CoreView.tableOfContents,
    );
    when { _tag: "CoreCommands" }: withTableOfContents(
      lazyDocsContent(Core.Commands.view, docContentArgs),
      Core.Commands.tableOfContents,
    );
    when { _tag: "CoreMount" }: withTableOfContents(
      lazyDocsContent(Core.Mount.view, docContentArgs),
      Core.Mount.tableOfContents,
    );
    when { _tag: "CoreCustomElement" }: withTableOfContents(
      lazyDocsContent(Core.CustomElement.view, docContentArgs),
      Core.CustomElement.tableOfContents,
    );
    when { _tag: "CoreSubscriptions" }: withTableOfContents(
      lazyDocsContent(Core.Subscriptions.view, docContentArgs),
      Core.Subscriptions.tableOfContents,
    );
    when { _tag: "CoreInitAndFlags" }: withTableOfContents(
      lazyDocsContent(Core.InitAndFlags.view, docContentArgs),
      Core.InitAndFlags.tableOfContents,
    );
    when { _tag: "CoreDom" }: withTableOfContents(
      lazyDocsContent(Core.CoreDom.view, docContentArgs),
      Core.CoreDom.tableOfContents,
    );
    when { _tag: "CoreRender" }: withTableOfContents(
      lazyDocsContent(Core.CoreRender.view, docContentArgs),
      Core.CoreRender.tableOfContents,
    );
    when { _tag: "CoreFile" }: withTableOfContents(
      lazyDocsContent(Core.CoreFile.view, docContentArgs),
      Core.CoreFile.tableOfContents,
    );
    when { _tag: "CoreHttp" }: withTableOfContents(
      lazyDocsContent(Core.CoreHttp.view, docContentArgs),
      Core.CoreHttp.tableOfContents,
    );
    when { _tag: "CoreQuery" }: withTableOfContents(
      lazyDocsContent(Core.CoreQuery.view, docContentArgs),
      Core.CoreQuery.tableOfContents,
    );
    when { _tag: "CoreCanvas" }: withTableOfContents(
      lazyDocsContent(Core.CoreCanvas.view, docContentArgs),
      Core.CoreCanvas.tableOfContents,
    );
    when { _tag: "CoreRuntime" }: withTableOfContents(
      lazyDocsContent(Core.Runtime.view, docContentArgs),
      Core.Runtime.tableOfContents,
    );
    when { _tag: "CoreServerRendering" }: withTableOfContents(
      lazyDocsContent(Core.CoreServerRendering.view, docContentArgs),
      Core.CoreServerRendering.tableOfContents,
    );
    when { _tag: "CoreResources" }: withTableOfContents(
      lazyDocsContent(Core.Resources.view, docContentArgs),
      Core.Resources.tableOfContents,
    );
    when { _tag: "CoreManagedResources" }: withTableOfContents(
      lazyDocsContent(Core.ManagedResources.view, docContentArgs),
      Core.ManagedResources.tableOfContents,
    );
    when { _tag: "CoreDevTools" }: withTableOfContents(
      lazyDocsContent(Core.DevTools.view, docContentArgs),
      Core.DevTools.tableOfContents,
    );
    when { _tag: "CoreCrashView" }: withTableOfContents(
      lazyDocsContent(Core.CrashView.view, docContentArgs),
      Core.CrashView.tableOfContents,
    );
    when { _tag: "CoreViewTransitions" }: withTableOfContents(
      lazyDocsContent(Core.ViewTransitions.view, docContentArgs),
      Core.ViewTransitions.tableOfContents,
    );
    when { _tag: "CoreSlowWarnings" }: withTableOfContents(
      lazyDocsContent(Core.Slow.view, docContentArgs),
      Core.Slow.tableOfContents,
    );
    when { _tag: "CoreFreezeModel" }: withTableOfContents(
      lazyProseContent(Core.FreezeModel.view, [h]),
      Core.FreezeModel.tableOfContents,
    );
    when { _tag: "CorePreserveScroll" }: withTableOfContents(
      lazyProseContent(Core.PreserveScroll.view, [h]),
      Core.PreserveScroll.tableOfContents,
    );
    when { _tag: "CoreSubmodel" }: withTableOfContents(
      h.submodel({
        slotId: 'core-submodel-page',
        model: model.coreSubmodelPage,
        view: Core.SubmodelPage.view,
        viewInputs: { renderCopyButton, renderSnippet, renderHeadingLink },
        toParentMessage: (message): infer _ =>
          Message.GotCoreSubmodelPageMessage({ message }),
      }),
      Core.SubmodelPage.tableOfContents,
    );
    when { _tag: "CoreMachine" }: withTableOfContents(
      lazyDocsContent(Core.Machine.view, docContentArgs),
      Core.Machine.tableOfContents,
    );
    when { _tag: "AsyncData" }: withTableOfContents(
      lazyDocsContent(AsyncDataPage.view, docContentArgs),
      AsyncDataPage.tableOfContents,
    );
    when { _tag: "PatternsAntiPatterns" }: withTableOfContents(
      lazyDocsContent(Patterns.AntiPatterns.view, docContentArgs),
      Patterns.AntiPatterns.tableOfContents,
    );
    when { _tag: "PatternsInformingSubmodels" }: withTableOfContents(
      lazyDocsContent(Patterns.InformingSubmodels.view, docContentArgs),
      Patterns.InformingSubmodels.tableOfContents,
    );
    when { _tag: "PatternsSubscriptionOrganization" }: withTableOfContents(
      lazyDocsContent(
        Patterns.SubscriptionOrganization.view,
        docContentArgs,
      ),
      Patterns.SubscriptionOrganization.tableOfContents,
    );
    when { _tag: "CoreViewMemoization" }: withTableOfContents(
      lazyDocsContent(Core.ViewMemoization.view, docContentArgs),
      Core.ViewMemoization.tableOfContents,
    );
    when { _tag: "CoreEmbedding" }: withTableOfContents(
      lazyDocsContent(Core.Embedding.view, docContentArgs),
      Core.Embedding.tableOfContents,
    );
    when { _tag: "UiOverview" }: withTableOfContents(
      lazyDocsContent(Ui.OverviewPage.view, docContentArgs),
