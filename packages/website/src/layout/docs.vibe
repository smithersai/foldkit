              h.div(
                [h.Class('hidden md:flex items-center gap-3')],
                [
                  Shared.iconLink(
                    Link.github,
                    'GitHub',
                    Icon.github('w-5 h-5'),
                  ),
                  Shared.iconLink(
                    Link.discord,
                    'Discord',
                    Icon.discord('w-5 h-5'),
                  ),
                  Shared.iconLink(Link.xSocial, 'X', Icon.xSocial('w-5 h-5')),
                  Shared.iconLink(Link.npm, 'npm', Icon.npm('w-6 h-6')),
