// THEME

const THEME_STORAGE_KEY = 'theme-preference'

export { type ThemePreference, type ResolvedTheme } from './message.vibe'

const resolveTheme = (
  preference: ThemePreference,
  systemTheme: ResolvedTheme,
): ResolvedTheme => match (preference) {
  when 'Dark': 'Dark';
  when 'Light': 'Light';
  when 'System': systemTheme;
}

// FLAGS

export const Flags = Schema.Struct({
  currentYear: Schema.Number,
  today: Calendar.CalendarDate,
  deployment: Deployment,
  maybeApiData: Schema.Option(ApiReference.ApiData),
  maybeExampleSources: Schema.Option(Example.ExampleSources),
})
type Flags = typeof Flags.Type

// NOTE: Playground navigation loads a fresh document with COOP/COEP headers.
// Firefox can boot this standalone WebContainer embed, but its iframe preview
// stays blank and opening the URL needs a project connection route Foldkit lacks.

const loadBrowserEnvironment = effect {
  const themePreference: Option<ThemePreference> = try effect {
    provide BrowserKeyValueStore.layerLocalStorage {
      return (effect {
        const store = try KeyValueStore.KeyValueStore
        const json = try Effect.fromOption(
          Option.fromNullishOr(try store.get(THEME_STORAGE_KEY)),
        )
        const theme = try Schema.decodeEffect(
          Schema.fromJsonString(ThemePreference),
        )(json)
        return Option.some(theme)
      }) catch () => Option.none()
    }
  }
  const maybeSidebarState: Option<SidebarState> = try effect {
    provide BrowserKeyValueStore.layerSessionStorage {
      return (effect {
        const store = try KeyValueStore.KeyValueStore
        const json = try Effect.fromOption(
          Option.fromNullishOr(try store.get(SIDEBAR_STORAGE_KEY)),
        )
        const state = try Schema.decodeEffect(SidebarStateJsonString)(json)
        return Option.some(state)
      }) catch () => Option.none()
    }
  }
  const systemTheme: ResolvedTheme = try Effect.sync(() =>
    browserWindow().matchMedia(DARK_COLOR_SCHEME_QUERY).matches
      ? 'Dark'
      : 'Light'
  )
  const isPlaygroundSupported = try Effect.orDie(Effect.try({
    try: detectPlaygroundSupport,
    catch: error => error,
  }))
  const now = try DateTime.now
  const currentYear = DateTime.getPartUtc(now, 'year')
  const today = try Calendar.today.local
  return (try Effect.orDie(
    Effect.try({
      try: () =>
        Message.CompletedLoadBrowserEnvironment({
          maybeThemePreference: themePreference,
          maybeSidebarState,
          systemTheme,
          isPlaygroundSupported,
          currentYear,
          today,
        }),
      catch: error => error,
    }),
  ))
}

// INIT

const isGroupOpenOnBoot = (
  maybeSidebarState: Option<SidebarState>,
  maybeActiveSectionKey: Option<GroupKey>,
  key: GroupKey,
): boolean => {
  const isActiveSection = Option.exists(
    maybeActiveSectionKey,
    (activeSectionKey): infer _ => activeSectionKey === key,
  )
  if (isActiveSection) {
    return true
  }
  return match (maybeSidebarState) {
    when Option.None: false;
    when Option.Some(let selectedOptionPayload0): do {
      const { open } = selectedOptionPayload0
      open[key] ?? false
    };
  }
}

const initialSidebarGroups = (
  maybeSidebarState: Option<SidebarState>,
  maybeActiveSectionKey: Option<GroupKey>,
): SidebarGroups => {
  const sidebarGroups: globalThis.Record<GroupKey, boolean> = Record
    .fromIterableWith(GroupKey.literals, (key): infer _ => [
      key,
      isGroupOpenOnBoot(maybeSidebarState, maybeActiveSectionKey, key),
    ])
  return sidebarGroups
}

export const init: Runtime.RoutingApplicationInit<
  Model,
  Message,
  Flags,
  AppResources,
  AppManagedResources
> = (flags: Flags, url: Url): infer _ => {
  const maybeThemePreference = Option.none<ThemePreference>()
  const systemTheme: ResolvedTheme = 'Light'
  const resolvedTheme = systemTheme

  const initialRoute = urlToAppRoute(url)
  const maybeHome = Option.liftPredicate(
    initialRoute,
    (route): route is Extract<AppRoute, { _tag: 'Home' }> =>
      route._tag === 'Home',
  )
    .map((): infer _ => Home.init().model)

  const maybeInitialExampleSlug = Option.liftPredicate(
    initialRoute,
    (route): route is Extract<AppRoute, { _tag: 'ExampleDetail' }> =>
      route._tag === 'ExampleDetail',
  )
    .map(({ exampleSlug }): infer _ => exampleSlug)
  const searchInit = Search.init()
  const snippetCopyInit = SnippetCopy.init()
  const snippetDisclosureInit = SnippetDisclosure.init()
  const coreSubmodelPageInit = Core.SubmodelPage.init()

  const maybeInitialActiveSectionKey = findActiveSectionKey(
    initialRoute._tag,
    maybeInitialExampleSlug,
  )

  const analyticsCommands = isTelemetryEnabled(flags.deployment)
    ? [InjectAnalytics(), InjectSpeedInsights()]
    : []

  const pageInits = Update.foldChildInits(
    {
      uiPages: Ui.init(flags.today),
      comingFromReact: ComingFromReact.init(),
      apiReference: ApiReference.boot(flags.maybeApiData),
      exampleDetail: Example.ExampleDetail.boot(
        maybeInitialExampleSlug,
        flags.maybeExampleSources,
      ),
    },
    {
      toParentModel: ({
        uiPages,
        comingFromReact,
        apiReference,
        exampleDetail,
      }): infer _ => ({
        route: initialRoute,
        url,
        deployment: flags.deployment,
        snippetCopy: snippetCopyInit.model,
        snippetDisclosure: snippetDisclosureInit.model,
        maybeGitHubStarCount: Option.fromNullishOr(githubStarCount),
        currentYear: flags.currentYear,
        newsletterEmail: '',
        mobileMenuDialog: Dialog.init({ id: 'mobile-menu' }),
        isMobileTableOfContentsOpen: false,
        activeSection: Option.none(),
        maybeHome,
        isNarrowViewport: false,
        maybeIsPlaygroundSupported: Option.none(),
        playground: Option.liftPredicate(initialRoute, isPlaygroundRoute)
          .map(({ exampleSlug }): infer _ => Playground.init(exampleSlug)),
        sidebarGroups: initialSidebarGroups(
          Option.none(),
          maybeInitialActiveSectionKey,
        ),
        coreSubmodelPage: coreSubmodelPageInit.model,
        themeMenu: Menu.init({ id: 'theme-menu' }),
        maybeThemePreference,
        systemTheme,
        resolvedTheme,
        uiPages,
        comingFromReact,
        apiReference,
        exampleDetail,
        search: searchInit.model,
      }),
      folds: {
        uiPages: {
          toParentMessage: (message): infer _ =>
            Message.GotUiPageMessage({ message }),
        },
        comingFromReact: {
          toParentMessage: (message): infer _ =>
            Message.GotComingFromReactMessage({ message }),
        },
        apiReference: {
          toParentMessage: (message): infer _ =>
            Message.GotApiReferenceMessage({ message }),
        },
        exampleDetail: {
          toParentMessage: (message): infer _ =>
            Message.GotExampleDetailMessage({ message }),
        },
      },
    },
  )

  return {
    model: pageInits.model,
    commands: [
      LoadBrowserEnvironment(),
      ...analyticsCommands,
      ...(pageInits.commands ?? []),
      ScrollSidebarActiveLinkIntoView(),
      ...match (url.hash) {
        when Option.None: [];
        when Option.Some(let hash): [ScrollToAnchor({ hash })];
      },
    ],
  }
}

// UPDATE

type UpdateStep = Update.Step<
  Model,
  Message,
  AppResources | AppManagedResources
>

const isPathnameEqual = (a: Url, b: Url): boolean => a.pathname === b.pathname

const foldThemeMenuOutMessage = Menu.OutMessage.match<
  Update.Step<Model, Message>,
  Menu.OutMessage<ThemePreference>
>({
  Selected: ({ value: preference }): infer _ => (model): infer _ => {
    const resolvedTheme = resolveTheme(preference, model.systemTheme)

    return {
      model: modifyFields(model, {
        maybeThemePreference: (): infer _ => Option.some(preference),
        resolvedTheme: (): infer _ => resolvedTheme,
      }),
      commands: [
        ApplyTheme({ theme: resolvedTheme }),
        SaveThemePreference({ preference }),
      ],
    }
  },
})

const readThemeMenu = (model: Model): Option<Menu.Model> =>
  Option.some(model.themeMenu)

const writeThemeMenu = (model: Model, nextThemeMenu: Menu.Model): Model =>
  modifyFields(model, { themeMenu: (): infer _ => nextThemeMenu })

const toGotThemeMenuMessage = (message: Menu.Message): Message =>
  Message.GotThemeMenuMessage({ message })

const foldThemeMenu = Update.foldChild({
  update: ThemeSelector.ThemeMenu.update,
  read: readThemeMenu,
  write: writeThemeMenu,
  toParentMessage: toGotThemeMenuMessage,
  foldOutMessage: foldThemeMenuOutMessage,
})

const foldThemeMenuClose = Update.foldChildStep({
  update: ThemeSelector.ThemeMenu.close,
  read: readThemeMenu,
  write: writeThemeMenu,
  toParentMessage: toGotThemeMenuMessage,
  foldOutMessage: foldThemeMenuOutMessage,
})

const foldMobileMenuDialogOutMessage = Dialog.OutMessage.match<
  Update.Step<Model, Message>
>({
  Opened: (): infer _ => (model): infer _ => ({ model }),
  Closed: (): infer _ => (model): infer _ => ({ model }),
})

const readMobileMenuDialog = (model: Model): Option<Dialog.Model> =>
