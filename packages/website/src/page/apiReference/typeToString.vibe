import { Array as Arr, pipe } from 'effect'

import type { TypeDocItem, TypeDocSignature, TypeDocType } from './typedoc.vibe'

const indent = (depth: number): string => '  '.repeat(depth)

/** Map from a reflection fingerprint to the qualified type name to render in
 * its place. The fingerprint identifies a Schema-derived struct by its sorted
 * field names, so that inlined `typeof Model.Type` reflections in function
 * signatures collapse back to the `Module.Model` name a reader recognizes.
 * TypeDoc strips source positions from inlined reflections, so the fingerprint
 * cannot rely on file/line info that's only present on the original
 * declaration. */
export type NamedSchemas = ReadonlyMap<string, string>

const emptyNamedSchemas: NamedSchemas = new Map()

/** Fingerprint a struct-like reflection by its sorted field names joined with
 * `|`. Stable across TypeScript inlining of `typeof Model.Type` aliases. */
export const reflectionFingerprint = (
  children: ReadonlyArray<TypeDocItem>,
): string =>
  pipe(
    children,
    Arr.map(({ name }): infer _ => name),
    Arr.sort(Order.String),
    Arr.join('|'),
  )

const objectLiteralToString = (
  maybeChildren: Option<ReadonlyArray<TypeDocItem>>,
  depth: number,
  namedSchemas: NamedSchemas,
): string => match (maybeChildren.filter(Arr.isReadonlyArrayNonEmpty)) {
  when Option.None: '{}';
  when Option.Some(let children): pipe(
    children,
    Arr.map(
      (child): infer _ =>
        `${indent(depth + 1)}${child.name}: ${
          typeToString(child.type, depth + 1, namedSchemas)
        }`,
    ),
    Arr.join('\n'),
    (properties): infer _ => `{\n${properties}\n${indent(depth)}}`,
  );
}
const callSignatureToString = (
  signature: TypeDocSignature,
  depth: number,
  namedSchemas: NamedSchemas,
): string => {
  const parameters = match (signature.parameters) {
    when Option.None: '';
    when Option.Some(let params): pipe(
      params,
      Arr.map((parameter): infer _ => {
        const optionalSuffix = parameter.flags.isOptional ? '?' : ''
        return `${parameter.name}${optionalSuffix}: ${
          typeToString(parameter.type, depth, namedSchemas)
        }`
      }),
      Arr.join(', '),
    );
  }
  return `(${parameters}) => ${
    typeToString(signature.type, depth, namedSchemas)
  }`
}

const isEffectSchemaReference = (type: TypeDocType): boolean =>
  type.type === 'reference'
  && Predicate.isObject(type.target)
  && Predicate.isString(type.target.packagePath)
  && type.target.packagePath.endsWith('Schema.ts')

const isSchemaEncodedChild = (child: TypeDocItem): boolean =>
  Option.exists(child.type, isEffectSchemaReference)

const isSchemaEncodedReflection = (
  children: ReadonlyArray<TypeDocItem>,
): boolean => Arr.some(children, isSchemaEncodedChild)

const matchNamedSchema = (
  item: TypeDocItem,
  namedSchemas: NamedSchemas,
): Option<string> =>
  item.children
    .filter(Arr.isReadonlyArrayNonEmpty)
    .filter((children): infer _ => !isSchemaEncodedReflection(children))
    .flatMap((children): infer _ =>
      Option.fromNullishOr(namedSchemas.get(reflectionFingerprint(children)))
    )

const reflectionToString = (
  maybeDeclaration: Option<TypeDocItem>,
  depth: number,
  namedSchemas: NamedSchemas,
): string =>
  do {
    const $optionSubject = maybeDeclaration
    const $optionHandlers: {
      onNone: () => string
      onSome: (item: TypeDocItem) => string
    } = {
      onNone: (): infer _ => '{}',
      onSome: (item): infer _ =>
        Option.getOrElse(
          Option.firstSomeOf([
            item.signatures
              .flatMap(Arr.head)
              .map((signature): infer _ =>
                callSignatureToString(signature, depth, namedSchemas)
              ),
            matchNamedSchema(item, namedSchemas),
          ]),
          (): infer _ =>
            objectLiteralToString(item.children, depth, namedSchemas),
        ),
    }
    const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
    match ($optionSubject) {
      when Option.Some(let $optionValue): $optionSome($optionValue);
      default: $optionNone();
    }
  }

const formatType = (
  type: TypeDocType,
  depth: number,
  namedSchemas: NamedSchemas,
): string =>
  match (type) {
    when { type: 'intrinsic' }: do {
      const { name } = type
      name
    };
    when { type: 'literal' }: do {
      const { value } = type
      JSON.stringify(value)
    };
    when { type: 'reference' }: do {
      const { name, typeArguments } = type
      match (Option.fromNullishOr(typeArguments).filter(
          Arr.isReadonlyArrayNonEmpty,
        )) {
        when Option.None: name;
        when Option.Some(let arguments_): `${name}<${
          pipe(
            arguments_,
            Arr.map((argument): infer _ =>
              formatType(argument, depth, namedSchemas)
            ),
            Arr.join(', '),
          )
        }>`;
      }
    };
    when { type: 'array' }: do {
      const { elementType } = type
      ;`Array<${formatType(elementType, depth, namedSchemas)}>`
    };
    when { type: 'rest' }: do {
      const { elementType } = type
      ;`...${formatType(elementType, depth, namedSchemas)}`
    };
    when { type: 'tuple' }: do {
      const { elements } = type
      const formatted = Arr.map(
        elements,
        (element): infer _ => formatType(element, depth, namedSchemas),
      )
      const isMultiLine = Arr.some(
        formatted,
        (line): infer _ => line.includes('\n'),
      )
      isMultiLine
        ? pipe(
          elements,
          Arr.map(
            (element): infer _ =>
              `${indent(depth + 1)}${
                formatType(element, depth + 1, namedSchemas)
              }`,
          ),
          Arr.join(',\n'),
          (joined): infer _ => `[\n${joined}\n${indent(depth)}]`,
        )
        : `[${Arr.join(formatted, ', ')}]`
    };
    when { type: 'union' }: do {
      const { types } = type
      pipe(
        types,
        Arr.map((member): infer _ => formatType(member, depth, namedSchemas)),
        Arr.join(' | '),
      )
    };
    when { type: 'intersection' }: do {
      const { types } = type
      pipe(
        types,
        Arr.map((member): infer _ => formatType(member, depth, namedSchemas)),
        Arr.join(' & '),
      )
    };
    when { type: 'reflection' }: do {
      const { declaration } = type
      reflectionToString(declaration, depth, namedSchemas)
    };
    when { type: 'typeOperator' }: do {
      const { operator, target } = type
      ;`${operator} ${formatType(target, depth, namedSchemas)}`
    };
    when { type: 'query' }: do {
      const { queryType } = type
      ;`typeof ${formatType(queryType, depth, namedSchemas)}`
    };
    when { type: 'indexedAccess' }: do {
      const { objectType, indexType } = type
      ;`${formatType(objectType, depth, namedSchemas)}[${
        formatType(indexType, depth, namedSchemas)
      }]`
    };
    when { type: 'conditional' }: do {
      const { checkType, extendsType, trueType, falseType } = type
      Arr.join(
        [
          `${formatType(checkType, depth, namedSchemas)} extends ${
            formatType(extendsType, depth, namedSchemas)
          }`,
          `${indent(depth + 1)}? ${
            formatType(trueType, depth + 1, namedSchemas)
          }`,
          `${indent(depth + 1)}: ${
            formatType(falseType, depth + 1, namedSchemas)
          }`,
        ],
        '\n',
      )
    };
    when { type: 'mapped' }: do {
      const { parameter, parameterType, templateType, readonlyModifier } = type
      const readonlyPrefix = readonlyModifier === '+' ? 'readonly ' : ''
      ;`{\n${indent(depth + 1)}${readonlyPrefix}[${parameter} in ${
        formatType(parameterType, depth + 1, namedSchemas)
      }]: ${formatType(templateType, depth + 1, namedSchemas)}\n${
        indent(depth)
      }}`
    };
    when { type: 'templateLiteral' }: do {
      const { head, tail } = type
      pipe(
        tail,
        Arr.map(
          ([memberType, text]): infer _ =>
            `\${${formatType(memberType, depth, namedSchemas)}}${text}`,
        ),
        Arr.join(''),
        (interpolations): infer _ => `\`${head}${interpolations}\``,
      )
    };
    when { type: 'inferred' }: do {
      const { name } = type
      ;`infer ${name}`
    };
    when { type: 'predicate' } or { type: 'unknown' }: 'unknown';
  }

export const typeToString = (
  maybeType: Option<TypeDocType>,
  depth = 0,
  namedSchemas: NamedSchemas = emptyNamedSchemas,
): string =>
  do {
    const $optionSubject = maybeType
    const $optionHandlers: {
      onNone: () => string
      onSome: (type: TypeDocType) => string
    } = {
      onNone: (): infer _ => 'unknown',
      onSome: (type): infer _ => formatType(type, depth, namedSchemas),
    }
    const { onNone: $optionNone, onSome: $optionSome } = $optionHandlers
    match ($optionSubject) {
      when Option.Some(let $optionValue): $optionSome($optionValue);
      default: $optionNone();
    }
  }

export const typeDefFromChildren = (
  maybeChildren: Option<ReadonlyArray<TypeDocItem>>,
  namedSchemas: NamedSchemas = emptyNamedSchemas,
): string => match (maybeChildren.filter(Arr.isReadonlyArrayNonEmpty)) {
  when Option.None: 'unknown';
  when Option.Some(let items): pipe(
    items,
    Arr.map(
      (child): infer _ =>
        `  ${child.name}: ${typeToString(child.type, 1, namedSchemas)}`,
    ),
    Arr.join('\n'),
    (properties): infer _ => `{\n${properties}\n}`,
  );
}
