import { type Html, inertHtml as ih } from 'foldkit/html'

import * as Prose from '../../prose.vibe'
import { blogRouter } from '../../route.vibe'
import { type PostCover, maybePostCover } from './frontmatter.vibe'
import { BLOG_AUTHOR } from './meta.vibe'
import { type BlogPost, formatPostDate } from './posts.vibe'

// VIEW

const backToBlogLink: Html = ih.a(
  [
    ih.Href(blogRouter()),
    ih.Class(
      'inline-block mb-6 text-sm font-medium text-accent-700 dark:text-accent-400 hover:underline',
    ),
  ],
  ['← Blog'],
)

const coverImageView = (cover: PostCover): Html =>
  ih.div(
    [ih.Class('relative overflow-hidden rounded-lg mb-8')],
    [
      ih.div([
        ih.Class('absolute inset-0 bg-gray-200 dark:bg-gray-800 animate-pulse'),
      ]),
      ih.img([
        ih.Src(cover.src),
        ih.Alt(cover.alt),
        ih.Width(String(cover.width)),
        ih.Height(String(cover.height)),
        ih.Class('relative w-full h-auto'),
      ]),
    ],
  )

export const view = (post: BlogPost, content: Html): Html =>
  ih.article(
    [],
    [
      backToBlogLink,
      ...match (maybePostCover(post.frontmatter)) {
        when { _tag: "None" }: [];
        when { _tag: "Some", value: let cover }: [coverImageView(cover)];
      },
      ih.header(
        [ih.Class('mb-8')],
        [
          Prose.pageTitle(post.slug, post.frontmatter.title, 'mb-3'),
          ih.p(
            [ih.Class('text-gray-600 dark:text-gray-400')],
            [`${formatPostDate(post.frontmatter.date)} · ${BLOG_AUTHOR}`],
          ),
        ],
      ),
      content,
    ],
  )
