export const update = (model: Model, message: Message): infer _ =>
  Message.match<UpdateReturn>(message, {
    UpdatedInputDemoValue: ({ value }): infer _ => ({
      model: modifyFields(model, { inputDemoValue: (): infer _ => value }),
    }),

    UpdatedTextareaDemoValue: ({ value }): infer _ => ({
      model: modifyFields(model, { textareaDemoValue: (): infer _ => value }),
    }),

    UpdatedFieldsetInputValue: ({ value }): infer _ => ({
      model: modifyFields(model, { fieldsetInputValue: (): infer _ => value }),
    }),

    UpdatedFieldsetTextareaValue: ({ value }): infer _ => ({
      model: modifyFields(model, {
        fieldsetTextareaValue: (): infer _ => value,
      }),
    }),

    UpdatedSelectDemoValue: ({ value }): infer _ => ({
      model: modifyFields(model, { selectDemoValue: (): infer _ => value }),
    }),

    ToggledFieldsetCheckboxDemo: ({ isChecked }): infer _ => ({
      model: modifyFields(model, {
        isFieldsetCheckboxDemoChecked: (): infer _ => isChecked,
      }),
    }),

    ClickedButtonDemo: (): infer _ => ({
      model: modifyFields(model, {
        buttonClickCount: Num.increment,
      }),
    }),

    GotCalendarBasicDemoMessage: ({ message }): infer _ =>
      foldCalendarBasicDemo(model, message),

    GotDatePickerBasicDemoMessage: ({ message }): infer _ =>
      foldDatePickerBasicDemo(model, message),

    ToggledCheckboxBasicDemo: ({ isChecked }): infer _ => ({
      model: modifyFields(model, {
        isCheckboxBasicDemoChecked: (): infer _ => isChecked,
      }),
    }),

    ToggledCheckboxAllDemo: ({ isChecked }): infer _ => ({
      model: modifyFields(model, {
        isCheckboxOptionADemoChecked: (): infer _ => isChecked,
        isCheckboxOptionBDemoChecked: (): infer _ => isChecked,
      }),
    }),

    ToggledCheckboxOptionADemo: ({ isChecked }): infer _ => ({
      model: modifyFields(model, {
        isCheckboxOptionADemoChecked: (): infer _ => isChecked,
      }),
    }),

    ToggledCheckboxOptionBDemo: ({ isChecked }): infer _ => ({
      model: modifyFields(model, {
        isCheckboxOptionBDemoChecked: (): infer _ => isChecked,
      }),
    }),

    GotComboboxDemoMessage: ({ message }): infer _ =>
      foldComboboxDemo(model, message),

    GotComboboxPlacementLockDemoMessage: ({ message }): infer _ =>
      foldComboboxPlacementLockDemo(model, message),

    GotComboboxNullableDemoMessage: ({ message }): infer _ =>
      foldComboboxNullableDemo(model, message),

    GotComboboxMultiDemoMessage: ({ message }): infer _ =>
      foldComboboxMultiDemo(model, message),

    GotComboboxSelectOnFocusDemoMessage: ({ message }): infer _ =>
      foldComboboxSelectOnFocusDemo(model, message),

    GotDialogDemoMessage: ({ message }): infer _ =>
      foldDialogDemo(model, message),

    GotDialogAnimatedDemoMessage: ({ message }): infer _ =>
      foldDialogAnimatedDemo(model, message),

    GotOverlayDialogDemoMessage: ({ message }): infer _ =>
      foldOverlayDialogDemo(model, message),

    GotOverlayComboboxDemoMessage: ({ message }): infer _ =>
      foldOverlayComboboxDemo(model, message),

    GotNestedDialogParentDemoMessage: ({ message }): infer _ =>
      foldNestedDialogParentDemo(model, message),

    GotNestedDialogChildDemoMessage: ({ message }): infer _ =>
      foldNestedDialogChildDemo(model, message),

    ClickedDeleteProject: (): infer _ => foldNestedDialogChildDemoOpen(model),

    ClickedOpenDialog: (): infer _ => foldDialogDemoOpen(model),

    ClickedOpenAnimatedDialog: (): infer _ => foldDialogAnimatedDemoOpen(model),

    ClickedEditFilters: (): infer _ => foldOverlayDialogDemoOpen(model),

    ClickedOpenProjectSettings: (): infer _ =>
      foldNestedDialogParentDemoOpen(model),

    ToggledDisclosureDemo: ({ isOpen }): infer _ => ({
