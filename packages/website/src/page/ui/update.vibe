      foldSliderVolumeDemo(model, message),

    ToggledSwitchDemo: ({ isChecked }): infer _ => ({
      model: modifyFields(model, {
        isSwitchDemoChecked: (): infer _ => isChecked,
      }),
    }),

    GotHorizontalTabsDemoMessage: ({ message }): infer _ =>
      foldHorizontalTabsDemo(model, message),

    GotVerticalTabsDemoMessage: ({ message }): infer _ =>
      foldVerticalTabsDemo(model, message),

    GotTooltipDemoMessage: ({ message }): infer _ =>
      foldTooltipDemo(model, message),

    GotHoverIntentCardDemoMessage: ({ message }): infer _ =>
      foldHoverIntentCardDemo(model, message),

    GotHoverIntentMenuDemoMessage: ({ message }): infer _ =>
      foldHoverIntentMenuDemo(model, message),

    ClickedHoverIntentMenuItem: (): infer _ =>
      foldHoverIntentMenuDemoClose(model),

    GotToastDemoMessage: ({ message }): infer _ =>
      foldToastDemo(model, message),

    ClickedShowInfoToast: (): infer _ =>
      foldToastDemoShow(model, {
        variant: 'Info',
        payload: {
          title: 'Preferences updated',
          maybeDescription: Option.some('Your changes are saved.'),
        },
      }),

    ClickedShowSuccessToast: (): infer _ =>
      foldToastDemoShow(model, {
        variant: 'Success',
        payload: {
          title: 'Uploaded',
          maybeDescription: Option.some('kit-manual.pdf is now available.'),
        },
      }),

    ClickedShowErrorToast: (): infer _ =>
      foldToastDemoShow(model, {
        variant: 'Error',
        payload: {
          title: 'Save failed',
          maybeDescription: Option.some('Check your connection and try again.'),
        },
      }),

    ClickedShowStickyToast: (): infer _ =>
      foldToastDemoShow(model, {
        variant: 'Info',
        payload: {
          title: 'Action required',
          maybeDescription: Option.some('Stays visible until dismissed.'),
        },
        sticky: true,
      }),

    ClickedDismissAllToasts: (): infer _ => foldToastDemoDismissAll(model),

    GotAnimationDemoMessage: ({ message }): infer _ =>
      foldAnimationDemo(model, message),

    ClickedToggleAnimationDemo: (): infer _ =>
      model.animationDemo.isShowing
        ? foldAnimationDemoHide(model)
        : foldAnimationDemoShow(model),

    GotFileDropBasicDemoMessage: ({ message }): infer _ =>
      foldFileDropBasicDemo(model, message),

    ClickedRemoveFileDropDemoFile: ({ fileIndex }): infer _ => ({
      model: modifyFields(model, {
        fileDropBasicDemoFiles: (): infer _ =>
          Arr.remove(model.fileDropBasicDemoFiles, fileIndex),
      }),
    }),

    GotDragAndDropDemoMessage: ({ message }): infer _ =>
      foldDragAndDropDemo(model, message),

    GotVirtualListDemoMessage: ({ message }): infer _ =>
      foldVirtualListDemo(model, message),

    ClickedVirtualListScrollToMiddle: (): infer _ =>
      foldVirtualListDemoScrollToIndex(
        model,
        Math.floor(VIRTUAL_LIST_ROW_COUNT / 2),
      ),

    GotVirtualListVariableDemoMessage: ({ message }): infer _ =>
      foldVirtualListVariableDemo(model, message),

    ClickedVirtualListVariableScrollToMiddle: (): infer _ =>
      foldVirtualListVariableDemoScrollToIndex(
        model,
        Math.floor(VIRTUAL_LIST_ROW_COUNT / 2),
      ),

    GotVirtualListChatDemoMessage: ({ message }): infer _ => match (message) {
      when { _tag: 'ObservedContainerScroll', let scrollTop }: Update.combine(
        model,
        [
          foldVirtualListChatDemo(message),
          prependVirtualListChatMessagesOnStartThresholdEntry(scrollTop),
        ],
      );
      default: foldVirtualListChatDemo(model, message);
    },

    ClickedVirtualListChatPrepend: (): infer _ =>
      prependVirtualListChatMessages(model),

    ClickedVirtualListChatScrollToMessage: (): infer _ =>
      foldVirtualListChatScrollToKey(model, '7'),

    ClickedVirtualListChatAppend: (): infer _ => {
      const nextId = model.virtualListChatNextId
      const nextMessages = Arr.append(model.virtualListChatMessages, {
        id: nextId,
        body: `New message ${nextId} arrived at the end.`,
        isExpanded: nextId % 3 === 0,
      })
      return updateVirtualListChatMessages(model, nextMessages, nextId + 1)
    },

    ClickedVirtualListChatToggleMessage: ({ messageId }): infer _ => {
      const nextMessages = Arr.map(
        model.virtualListChatMessages,
        (message): infer _ =>
          message.id === messageId
            ? modifyFields(message, {
              isExpanded: (isExpanded): infer _ => !isExpanded,
            })
            : message,
      )
      return updateVirtualListChatMessages(model, nextMessages)
    },
  })
