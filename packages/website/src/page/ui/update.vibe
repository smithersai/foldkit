      dragAndDropDemo: (): infer _ => nextDragAndDropDemo,
      dragAndDropDemoAnnouncement: (dragAndDropDemoAnnouncement): infer _ =>
        Option.match(
          maybeDragAndDropDemoKeyboardAnnouncement(model, nextDragAndDropDemo),
          {
            onNone: (): infer _ => dragAndDropDemoAnnouncement,
            onSome: dragAndDropDemoAnnouncementToText,
          },
