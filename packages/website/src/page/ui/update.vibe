// REORDER

const reorderColumns = (
  columns: ReadonlyArray<typeof DemoColumn.Type>,
  itemId: string,
  fromContainerId: string,
  toContainerId: string,
  toIndex: number,
): ReadonlyArray<typeof DemoColumn.Type> => {
  const maybeCard: Option<typeof DemoCard.Type> = pipe(
    columns,
    Arr.findFirst(({ id }): infer _ => id === fromContainerId),
    Option.flatMap((column): infer _ =>
      Arr.findFirst(column.cards, ({ id }): infer _ => id === itemId)
    ),
  )

  return Option.match(maybeCard, {
    onNone: (): infer _ => columns,
    onSome: (card): infer _ =>
      Arr.map(columns, (column): infer _ => {
        const withRemoved = column.id === fromContainerId
          ? Arr.filter(column.cards, ({ id }): infer _ => id !== itemId)
          : column.cards

        if (column.id !== toContainerId) {
          return modifyFields(column, { cards: (): infer _ => withRemoved })
        }

        const inserted = pipe(withRemoved, (cards): infer _ => [
          ...Arr.take(cards, toIndex),
          card,
          ...Arr.drop(cards, toIndex),
        ])

        return modifyFields(column, { cards: (): infer _ => inserted })
      }),
  })
}

const findDragAndDropDemoCardLabel = (
  columns: ReadonlyArray<typeof DemoColumn.Type>,
  itemId: string,
): string =>
  pipe(
    columns,
    Arr.flatMap((column): infer _ => column.cards),
    Arr.findFirst((card): infer _ => card.id === itemId),
    Option.match({
      onNone: (): infer _ => itemId,
      onSome: (card): infer _ => card.label,
    }),
  )

const findDragAndDropDemoColumnLabel = (
  columns: ReadonlyArray<typeof DemoColumn.Type>,
  containerId: string,
): string =>
  pipe(
    columns,
    Arr.findFirst((column): infer _ => column.id === containerId),
    Option.match({
      onNone: (): infer _ => containerId,
      onSome: (column): infer _ => column.label,
    }),
  )

const DragAndDropDemoAnnouncement = defineTaggedUnion({
  PickedUp: { label: Schema.String },
  MovedToColumn: { columnLabel: Schema.String, position: Schema.Number },
  MovedWithinColumn: { columnLabel: Schema.String, position: Schema.Number },
  Dropped: {
    label: Schema.String,
    columnLabel: Schema.String,
    position: Schema.Number,
  },
  Cancelled: {},
})
type DragAndDropDemoAnnouncement = typeof DragAndDropDemoAnnouncement.Type

const dragAndDropDemoAnnouncementToText = DragAndDropDemoAnnouncement.match({
  PickedUp: ({ label }): infer _ =>
    `Picked up ${label}. Use arrow keys to move within a column, Tab to move between columns, Space to drop, Escape to cancel.`,
  MovedToColumn: ({ columnLabel, position }): infer _ =>
    `Moved to ${columnLabel}, position ${position}.`,
  MovedWithinColumn: ({ columnLabel, position }): infer _ =>
    `Position ${position} in ${columnLabel}.`,
  Dropped: ({ label, columnLabel, position }): infer _ =>
    `Dropped ${label} in position ${position} of ${columnLabel}.`,
  Cancelled: (): infer _ => 'Drag cancelled.',
})

const maybeDragAndDropDemoKeyboardAnnouncement = (
  model: Model,
  nextDragAndDrop: DragAndDrop.Model,
): Option<DragAndDropDemoAnnouncement> =>
  DragAndDrop.DragState.matchOrElse<Option<DragAndDropDemoAnnouncement>>(
    nextDragAndDrop.dragState,
    {
      KeyboardDragging: (nextState): infer _ =>
        DragAndDrop.DragState.matchOrElse<
          Option<DragAndDropDemoAnnouncement>
        >(
          model.dragAndDropDemo.dragState,
          {
            Idle: (): infer _ =>
              Option.some(
                DragAndDropDemoAnnouncement.PickedUp({
                  label: findDragAndDropDemoCardLabel(
                    model.dragAndDropDemoColumns,
                    nextState.itemId,
                  ),
                }),
              ),
            KeyboardDragging: (previousState): infer _ => {
              const columnLabel = findDragAndDropDemoColumnLabel(
                model.dragAndDropDemoColumns,
                nextState.targetContainerId,
              )
              const position = nextState.targetIndex + 1

              if (
                previousState.targetContainerId !== nextState.targetContainerId
              ) {
                return Option.some(
                  DragAndDropDemoAnnouncement.MovedToColumn({
                    columnLabel,
                    position,
                  }),
                )
              }

              if (previousState.targetIndex !== nextState.targetIndex) {
                return Option.some(
                  DragAndDropDemoAnnouncement.MovedWithinColumn({
                    columnLabel,
                    position,
                  }),
                )
              }

              return Option.none()
            },
          },
          (): infer _ => Option.none(),
        ),
    },
    (): infer _ => Option.none(),
  )

export type UpdateReturn = Update.Return<Model, Message>

