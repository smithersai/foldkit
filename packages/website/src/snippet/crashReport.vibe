import { ExperimentalBrowserDocument } from 'vibelang-runtime/experimental/platform-browser'
import { Runtime } from 'foldkit'

import * as Sentry from '@sentry/browser'
import { Model } from './model'

const application = Runtime.makeApplication({
  Model,
  init,
  update,
  view,
  crash: {
    report: ({ error, model, message }) => {
      Sentry.captureException(error, {
        extra: { model, message: Option.getOrUndefined(message) },
      })
    },
  },
  container: Effect.runSync(effect {
    provide ExperimentalBrowserDocument.layer {
      const page = try (try Experimental.Document.Document).current
      return try Effect.orDie(Effect.try({
        try: () => page.getElementById('root'),
        catch: error => error,
      }))
    }
  }),
})

Runtime.run(application)
