import { ExperimentalBrowserDocument } from 'vibelang-runtime/experimental/platform-browser'
import { Dom } from 'foldkit'
import { defineMessageUnion } from 'foldkit/message'

const Message = defineMessageUnion({
  PressedSearchShortcut: {},
})

const searchShortcuts = Dom.streamFromEventFilterMapPreventDefault({
  target: Effect.runSync(effect {
    provide ExperimentalBrowserDocument.layer {
      return try (try Experimental.Document.Document).current
    }
  }),
  type: 'keydown',
  filterMapEvent: event =>
    (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k'
      ? Option.some(Message.PressedSearchShortcut())
      : Option.none(),
})
