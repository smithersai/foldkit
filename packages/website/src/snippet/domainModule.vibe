// domain/cart.ts
import { Array as EffectArray } from 'effect'
import { modifyFields } from 'foldkit/struct'

import { CartItem, Item } from './item'

export const Cart = Schema.Array(CartItem)
export type Cart = typeof Cart.Type

export const addItem = (item: Item) => (cart: Cart): Cart => {
  const existing = EffectArray.findFirst(
    cart,
    cartItem => cartItem.item.id === item.id,
  )

  return match (existing) {
    when { _tag: "None" }: [...cart, { item, quantity: 1 }];
    when { _tag: "Some", value: let optionValue1 }: do {
      void optionValue1
      EffectArray.map(cart, cartItem =>
        cartItem.item.id === item.id
          ? modifyFields(cartItem, { quantity: quantity => quantity + 1 })
          : cartItem)
    };
  }
}

export const removeItem = (itemId: string) => (cart: Cart): Cart =>
  EffectArray.filter(cart, cartItem => cartItem.item.id !== itemId)

export const totalItems = (cart: Cart): number =>
  EffectArray.reduce(cart, 0, (total, { quantity }) => total + quantity)
