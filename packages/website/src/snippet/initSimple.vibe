import type { Runtime } from 'foldkit'
import { defineMessageUnion } from 'foldkit/message'

schema Model {
  count: number
}

const Message = defineMessageUnion({
  ClickedIncrement: {},
  ClickedDecrement: {},
})
type Message = typeof Message.Type

const init: Runtime.ApplicationInit<Model, Message> = () => ({
  model: { count: 0 },
})
