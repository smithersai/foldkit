import { HttpClient } from 'effect/http'
import { Command, Http } from 'foldkit'

const FetchWeather = Command.define('FetchWeather', {
  args: { city: Schema.String },
  messages: [SucceededFetchWeather, FailedFetchWeather],
  execute: effect ({ city }) => {
    return (effect {
      provide Http.layer {
        const response = try HttpClient.get(`https://api.weather.com/${city}`)
        const json = try response.json
        const data = try Schema.decodeUnknownEffect(WeatherResponse)(json)
        return SucceededFetchWeather({ weather: data })
      }
    }) catch () => FailedFetchWeather({ error: 'Request failed' })
  },
})
