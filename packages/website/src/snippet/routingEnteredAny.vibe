import { Command } from 'foldkit'
import { Transition } from 'foldkit/route'
import { Message } from './message'

type Commands = ReadonlyArray<Command.Command<Message>>

const commandsForTransition = (
  transition: Transition.Transition<AppRoute>,
): Commands => match (Transition.enteredAny(transition)) {
  when { _tag: 'None' }: [];
  when { _tag: 'Some', value: let route }: match (route) {
    when { _tag: 'People' }: [FetchPeopleFilters()];
    when { _tag: 'Person', let personId }: [FetchPerson({ personId })];
    default: [];
  };
}
