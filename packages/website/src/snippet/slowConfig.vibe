import { ExperimentalBrowserDocument } from 'vibelang-runtime/experimental/platform-browser'
import { Runtime } from 'foldkit'

import * as Sentry from '@sentry/browser'
import { Message } from './message'
import { Model } from './model'

const handleSlow = (context: Runtime.SlowContext<Model, Message>): void => {
  const summary = match (context) {
    when { _tag: 'View', let durationMs, let thresholdMs }: `view ${
      durationMs.toFixed(1)
    }ms (budget ${thresholdMs}ms)`;
    when { _tag: 'Update', let durationMs, let thresholdMs, let message }:
      `update ${
        durationMs.toFixed(1)
      }ms (budget ${thresholdMs}ms) [${message._tag}]`;
    when { _tag: 'Patch', let durationMs, let thresholdMs }: `patch ${
      durationMs.toFixed(1)
    }ms (budget ${thresholdMs}ms)`;
    when {
      _tag: 'SubscriptionDependencies',
      let durationMs,
      let thresholdMs,
      let subscriptionKey,
    }: `subscription dependencies "${subscriptionKey}" ${
      durationMs.toFixed(1)
    }ms (budget ${thresholdMs}ms)`;
  }

  Sentry.captureMessage(`[foldkit slow] ${summary}`)
}

const application = Runtime.makeApplication({
  Model,
  init,
  update,
  view,
  container: Effect.runSync(effect {
    provide ExperimentalBrowserDocument.layer {
      const page = try (try Experimental.Document.Document).current
      return try Effect.orDie(Effect.try({
        try: () => page.getElementById('root'),
        catch: error => error,
      }))
    }
  }),
  slow: {
    show: 'Always',
    onSlow: handleSlow,
    thresholdOverrides: {
      Update: 4,
      View: 12,
      Patch: 8,
      SubscriptionDependencies: 1,
    },
  },
})

Runtime.run(application)
