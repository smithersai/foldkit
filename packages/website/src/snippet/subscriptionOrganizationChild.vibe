import { ExperimentalBrowserDocument } from 'vibelang-runtime/experimental/platform-browser'
// page/settings/themeMenu/subscription.ts
import { Subscription } from 'foldkit'

import { type Message, PressedEscape } from './message'
import type { Model } from './model'

export const subscriptions = Subscription.make<Model, Message>()(entry => ({
  escapeKey: entry(
    { isOpen: Schema.Boolean },
    {
      modelToDependencies: model => ({ isOpen: model.isOpen }),
      dependenciesToStream: ({ isOpen }) =>
        Stream.when(
          Stream.fromEventListener<KeyboardEvent>(
            Effect.runSync(effect {
              provide ExperimentalBrowserDocument.layer {
                return try (try Experimental.Document.Document).current
              }
            }),
            'keydown',
          ).pipe(
            Stream.filter(event => event.key === 'Escape'),
            Stream.map(PressedEscape),
          ),
          Effect.sync(() => isOpen),
        ),
    },
  ),
}))
