import { HttpClient, HttpClientResponse, HttpServerResponse } from 'effect/http'
import { expect, test } from 'vitest'

error UnexpectedRequestUrl { url: string }

const testFetchWeather = async () => {
  const mockClient = HttpClient.make(effect request => {
    const responseData = match (request.url) {
      when let url and if (url.includes('geocoding')): ({
        results: [
          {
            name: 'Beverly Hills',
            latitude: 34.07362,
            longitude: -118.40036,
            admin1: 'California',
          },
        ],
      });
      when let url and if (url.includes('forecast')): ({
        current: {
          time: '2026-03-10T01:30',
          interval: 900,
          temperature_2m: 72.4,
          relative_humidity_2m: 45,
          wind_speed_10m: 9.8,
          weather_code: 0,
        },
      });
      default: try die(new UnexpectedRequestUrl({ url: request.url }));
    }
    return HttpClientResponse.fromWeb(
      request,
      HttpServerResponse.toWeb(
        HttpServerResponse.raw(JSON.stringify(responseData), { status: 200 }),
      ),
    )
  })

  const message = await (
    fetchWeather('90210').effect
    |> Effect.provide(%, Layer.succeed(HttpClient.HttpClient, mockClient))
    |> Effect.runPromise(%)
  )

  expect(message._tag).toBe('SucceededFetchWeather')
}

Effect.runSync(Effect.orDie(Effect.try({
  try: () =>
    test(
      'fetchWeather returns SucceededFetchWeather on success',
      testFetchWeather,
    ),
  catch: error => error,
})))
