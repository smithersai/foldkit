import {
  Html,
  type HtmlBuilder,
  createKeyedLazy,
  inertHtml as ih,
} from 'foldkit/html'

import { Shared } from '../component/index.ts'
import { Docs } from '../layout/index.ts'
import { docPage } from '../markdown/index.ts'
import { Message } from '../message.vibe'
import { type Model } from '../model.vibe'
import { Blog, NotFound, Ui } from '../page/index.ts'
import * as Release0167 from '../page/blog/post/foldkit-0-167-0.ts'
import * as Prose from '../prose.vibe'
import { type BlogPostRoute, type BlogRoute, homeRouter } from '../route.vibe'
import * as SnippetCopy from '../snippetCopy/index.ts'
import * as SnippetDisclosure from '../snippetDisclosure/index.ts'
import * as Search from './search.ts'
import * as Sidebar from './sidebar.vibe'

const PagefindBody = ih.DataAttribute('pagefind-body', '')
const PagefindIgnore = ih.DataAttribute('pagefind-ignore', '')

const postView = (
  post: Blog.BlogPost,
  snippetCopy: SnippetCopy.Model,
  snippetDisclosure: SnippetDisclosure.Model,
  uiPages: Ui.Model,
  h: HtmlBuilder<Message>,
): Html => {
  const renderCopyButton = SnippetCopy.renderer(
    snippetCopy,
    (message): infer _ => Message.GotSnippetCopyMessage({ message }),
    h,
  )

  const renderSnippet = SnippetDisclosure.renderer(
    snippetDisclosure,
    (message): infer _ => Message.GotSnippetDisclosureMessage({ message }),
    renderCopyButton,
    h,
  )
  const renderHeadingLink = Prose.renderHeadingLink(
    (hash): infer _ => Message.ClickedCopyLink({ hash }),
    h,
  )

  const content = post.slug === 'foldkit-0-167-0'
    ? h.submodel({
      slotId: 'blog-release-0167',
      model: uiPages,
      view: Release0167.view,
      viewInputs: { renderCopyButton, renderSnippet, renderHeadingLink },
      toParentMessage: (message): infer _ =>
        Message.GotUiPageMessage({ message }),
    })
    : docPage(post.document, post.slug).view(
      renderCopyButton,
      renderSnippet,
      renderHeadingLink,
    )

  return Blog.BlogPostPage.view(post, content)
}

const lazyPostView = createKeyedLazy()

// VIEW

export const view = (
  model: Model,
  blogRoute: BlogRoute | BlogPostRoute,
  h: HtmlBuilder<Message>,
): Html => {
  const content = match (blogRoute) {
    when { _tag: "Blog" }: Blog.BlogIndex.view();
    when { _tag: "BlogPost", let postSlug }: Option.match(
      Blog.findPostBySlug(postSlug),
      {
        onNone: (): infer _ => NotFound.view(postSlug, homeRouter()),
        onSome: (post): infer _ =>
          lazyPostView(post.slug, postView, [
            post,
            model.snippetCopy,
            model.snippetDisclosure,
            model.uiPages,
            h,
          ]),
      },
    );
  }

  const contentKey = match (blogRoute) {
    when { _tag: 'BlogPost', postSlug: let postSlug }: `BlogPost-${postSlug}`;
    when let other: other._tag;
  }

  return h.div(
    [h.Class('flex flex-col min-h-screen')],
    [
      Shared.skipNavLink,
      Docs.headerView(model, h),
      Search.dialogView(model, h),
      Sidebar.mobileView(model, h),
      h.main(
        [
          h.Id('main-content'),
          h.Class(
            'flex-1 flex flex-col pt-[var(--header-height)] bg-cream dark:bg-gray-900',
          ),
        ],
        [
          h.keyed('div')(
            contentKey,
            [
              PagefindBody,
              h.DataAttribute(
                'pagefind-weight',
                Docs.searchWeight(blogRoute._tag),
              ),
              h.Class('docs-content flex-1'),
            ],
            [content],
          ),
          h.div([PagefindIgnore], [Docs.footerView(model, h)]),
        ],
      ),
    ],
  )
}
