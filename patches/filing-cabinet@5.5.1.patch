+// VibeLang modules: a dependency written as ./module.vibe (or without an
+// extension) resolves to the .vibe/.vibex source, and a declaration sidecar
+// (module.d.vibe.ts) resolves back to the source beside it, so the graph
+// follows the implementation rather than its emitted types.
+const VIBE_EXTENSIONS = ['.vibe', '.vibex'];
+
+function vibeSource(result) {
+  const match = /^(.*)\.d\.(vibe|vibex)\.ts$/.exec(result);
+  if (!match) return result;
+  const source = `${match[1]}.${match[2]}`;
+  return fs.existsSync(source) ? source : result;
+}
+
+function vibeLookup(dependency, filename) {
+  if (!dependency || !isRelativePath(dependency)) return '';
+  resolve ||= require('resolve');
+  try {
+    return resolve.sync(dependency, {
+      basedir: path.dirname(filename),
+      extensions: [...VIBE_EXTENSIONS, '.ts', '.tsx', '.d.ts', '.js', '.jsx', '.mjs', '.cjs', '.json']
+    });
+  } catch {
+    return '';
+  }
+}
